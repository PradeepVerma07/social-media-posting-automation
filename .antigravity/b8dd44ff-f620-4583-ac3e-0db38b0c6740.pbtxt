  view_file {
    absolute_path_uri: "file:///server/src/app.ts"
    start_line: 379
    end_line: 449
    content: "    commentText: `Post published across all platforms via n8n (Execution: ${result.executionId}).`,\n    isSystemMessage: true,\n  });\n\n  res.json({ message: \'Publishing triggered successfully\', post: updated, executionId: result.executionId });\n});\n\n// Post Comments\napp.get(\'/api/v1/posts/:id/comments\', (req: Request, res: Response) => {\n  const comments = db.getCommentsByPostId(parseInt(req.params.id, 10));\n  res.json({ data: comments });\n});\n\napp.post(\'/api/v1/posts/:id/comments\', (req: Request, res: Response) => {\n  const postId = parseInt(req.params.id, 10);\n  const { userId, commentText } = req.body;\n\n  if (!commentText || !commentText.trim()) {\n    return res.status(400).json({ error: \'Comment text cannot be empty\' });\n  }\n\n  const comment = db.addComment({\n    postId,\n    userId: userId || 1,\n    commentText,\n  });\n\n  res.status(201).json(comment);\n});\n\n// --- BRANDS ROUTES ---\napp.get(\'/api/v1/brands\', (req: Request, res: Response) => {\n  res.json({ data: db.getBrands() });\n});\n\napp.post(\'/api/v1/brands\', (req: Request, res: Response) => {\n  const { name, slug, primaryColor, secondaryColor, timezone, country } = req.body;\n  if (!name || !slug) return res.status(400).json({ error: \'Name and slug are required\' });\n\n  const brand = db.createBrand({\n    name,\n    slug,\n    primaryColor: primaryColor || \'#1336E8\',\n    secondaryColor: secondaryColor || \'#08C5E1\',\n    timezone: timezone || \'UTC\',\n    country: country || \'US\',\n    isActive: true,\n  });\n\n  res.status(201).json(brand);\n});\n\n// --- SOCIAL ACCOUNTS ---\napp.get(\'/api/v1/social-accounts\', (req: Request, res: Response) => {\n  const brandId = req.query.brandId ? parseInt(req.query.brandId as string, 10) : undefined;\n  res.json({ data: db.getSocialAccounts(brandId) });\n});\n\n// --- WORKFLOWS & EXECUTIONS ---\napp.get(\'/api/v1/workflows\', (req: Request, res: Response) => {\n  res.json({ data: db.getWorkflows() });\n});\n\napp.post(\'/api/v1/workflows/:id/execute\', async (req: Request, res: Response) => {\n  const wf = db.getWorkflowById(parseInt(req.params.id, 10));\n  if (!wf) return res.status(404).json({ error: \'Workflow mapping not found\' });\n\n  const result = await n8nService.dispatchWebhook(wf.webhookPath, {\n    requestedBy: 1,\n    data: { manualTrigger: true, workflowId: wf.n8nWorkflowId },\n  });"
    num_lines: 536
    num_bytes: 15335
    line_range_bytes: 2290
  }
}
