  code_action {
    action_spec {
      create_file {
        instruction: "export type RoleName =\n  | \'Super Admin\'\n  | \'Admin\'\n  | \'Content Manager\'\n  | \'Approver\'\n  | \'Analyst\'\n  | \'Client\';\n\nexport interface User {\n  id: number;\n  email: string;\n  fullName: string;\n  avatarUrl?: string;\n  phone?: string;\n  role: RoleName;\n  isActive: boolean;\n  twoFactorEnabled?: boolean;\n  createdAt: string;\n}\n\nexport interface Brand {\n  id: number;\n  name: string;\n  slug: string;\n  logoUrl?: string;\n  primaryColor: string;\n  secondaryColor: string;\n  timezone: string;\n  country: string;\n  defaultApproverId?: number;\n  defaultHashtags?: string;\n  defaultKeywords?: string;\n  isActive: boolean;\n  connectedAccountsCount?: number;\n}\n\nexport type SocialPlatform = \'linkedin\' | \'facebook\' | \'instagram\' | \'x\' | \'youtube\';\n\nexport interface SocialAccount {\n  id: number;\n  brandId: number;\n  platform: SocialPlatform;\n  accountName: string;\n  accountHandle?: string;\n  profileImageUrl?: string;\n  connectionStatus: \'connected\' | \'expired\' | \'disconnected\' | \'error\';\n  tokenExpiresAt?: string;\n  lastSuccessfulPublishAt?: string;\n  lastErrorMessage?: string;\n}\n\nexport type ApprovalStatus =\n  | \'draft\'\n  | \'in_review\'\n  | \'revision_requested\'\n  | \'approved\'\n  | \'rejected\'\n  | \'overdue\';\n\nexport type PublishingStatus =\n  | \'idle\'\n  | \'scheduled\'\n  | \'processing\'\n  | \'published\'\n  | \'partially_published\'\n  | \'failed\'\n  | \'cancelled\';\n\nexport interface PostPlatformConfig {\n  platform: SocialPlatform;\n  captionOverride?: string;\n  publishingStatus: \'pending\' | \'publishing\' | \'success\' | \'failed\';\n  platformPostId?: string;\n  platformPostUrl?: string;\n  errorMessage?: string;\n  publishedAt?: string;\n}\n\nexport interface PostMediaItem {\n  id: number;\n  postId: number;\n  mediaType: \'image\' | \'video\' | \'document\';\n  fileUrl: string;\n  originalFileName: string;\n  mimeType: string;\n  fileSizeBytes: number;\n  width?: number;\n  height?: number;\n  durationSeconds?: number;\n  altText?: string;\n}\n\nexport interface PostComment {\n  id: number;\n  postId: number;\n  userId: number;\n  userFullName: string;\n  userAvatarUrl?: string;\n  userRole: RoleName;\n  commentText: string;\n  isSystemMessage: boolean;\n  attachmentUrl?: string;\n  replyToCommentId?: number;\n  isEdited: boolean;\n  createdAt: string;\n}\n\nexport interface PostVersion {\n  id: number;\n  postId: number;\n  versionNumber: number;\n  changedByUserId: number;\n  changedByName: string;\n  masterCaption: string;\n  scheduledAt?: string;\n  changeSummary?: string;\n  createdAt: string;\n}\n\nexport interface Post {\n  id: number;\n  brandId: number;\n  brandName: string;\n  campaignId?: number;\n  campaignName?: string;\n  createdByUserId: number;\n  createdByName: string;\n  assignedApproverId?: number;\n  assignedApproverName?: string;\n  title: string;\n  masterCaption: string;\n  firstComment?: string;\n  hashtags?: string;\n  keywords?: string;\n  targetUrl?: string;\n  internalTags?: string;\n  country: string;\n  timezone: string;\n  scheduledAt?: string;\n  publishedAt?: string;\n  approvalStatus: ApprovalStatus;\n  publishingStatus: PublishingStatus;\n  rejectionReason?: string;\n  versionNumber: number;\n  isLocked: boolean;\n  externalSheetId?: string;\n  platforms: PostPlatformConfig[];\n  media: PostMediaItem[];\n  commentsCount: number;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface WorkflowMapping {\n  id: number;\n  workflowName: string;\n  n8nWorkflowId: string;\n  webhookPath: string;\n  description?: string;\n  isActive: boolean;\n  averageDurationMs: number;\n  successCount: number;\n  failureCount: number;\n  lastExecutedAt?: string;\n  lastResultStatus?: string;\n}\n\nexport interface WorkflowExecution {\n  id: number;\n  executionId: string;\n  n8nWorkflowId: string;\n  workflowName: string;\n  postId?: number;\n  postTitle?: string;\n  brandId?: number;\n  brandName?: string;\n  initiatedByUserId: number;\n  initiatedByName: string;\n  triggerType: \'manual\' | \'schedule\' | \'webhook_callback\' | \'retry\';\n  status: \'queued\' | \'running\' | \'success\' | \'partial_success\' | \'failed\' | \'cancelled\';\n  durationMs?: number;\n  startedAt: string;\n  finishedAt?: string;\n  sanitizedInput?: Record<string, any>;\n  perPlatformResults?: Record<string, { status: string; url?: string; error?: string }>;\n  errorSummary?: string;\n}\n\nexport interface AnalyticsOverview {\n  totalScheduledPosts: number;\n  totalPublishedPosts: number;\n  pendingApprovals: number;\n  rejectedPosts: number;\n  failedAutomations: number;\n  activeWorkflows: number;\n  connectedPlatforms: number;\n  totalEngagement: number;\n  totalImpressions: number;\n  totalReach: number;\n  engagementRate: number;\n  publishedByPlatform: Record<SocialPlatform, number>;\n  approvalBreakdown: Record<ApprovalStatus, number>;\n}\n\nexport interface InAppNotification {\n  id: number;\n  userId: number;\n  eventType: string;\n  title: string;\n  message: string;\n  linkUrl?: string;\n  isRead: boolean;\n  createdAt: string;\n}\n\nexport interface AuditLogEntry {\n  id: number;\n  userId?: number;\n  userEmail?: string;\n  action: string;\n  entityType: string;\n  entityId?: number;\n  details?: Record<string, any>;\n  ipAddress?: string;\n  createdAt: string;\n}\n"
