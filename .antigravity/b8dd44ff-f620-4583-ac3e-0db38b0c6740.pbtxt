      thinking_signature: "\022\262\t\n\257\t\001i\024}\023\033D\005<n\034\363Om?;\314\314\023\026\374kt\221\213\246VO\003\237\2737\326|\bd\333\322\326p\357pQfO\327X\316[\304\034\2037#\333\243,\370\024~\026$\212\006K\253\305TC\350c2\247\nv+\364\242\241.\331\344Bm\375\240\030\231\243\323{\310\332\332\347\024\023\310\340\236\371x\"\360f\367\0306\341\221\"\3354\020\342\347\361s0z_>\314:\315\213\331G\362U\343\004i\301\277m\315B\226\347\303\224]4\264~\334`\203\366\205\272\271\337|{\222\346n\037\354\006\301E\202\343\327\0054\3133\363\331)B\260\371\345\211U;*;\vkM\345 \253\002\254\222\266%\347\324\037c\376Y\342\325Q\032\234(kN=,\365\272\241\b\206P\032da\3569\374\177\333-[\242\332\300B\252\005\005$\247\017J\376\216\000\312c\376?\343\020Gp8Z\'&P\274\241<\023We\341\364\305JAFS\324\265bU\251v*\212\222\222\236\'\3646J\372~\346\035\307=\312\221\vol\246S\351\322\v\371\006\347\202,\005[\016\024\004d{XK\254\342\302M\232,\314\017hh\353\214\266\004\274\273\276\377\362\272\335g\303\265 \024c\016_u\2368\310\262y@\227\264AM\a\000O\370\365\311KL\327\205\376C\370\316R\264j\221\320Nr\217\240:\3016\310\235v\2356\016\303a[\361%\314\261k~\334)\313;}\300\366/Qy\241\227\366\002\210\003K\aXO@d\302qK\254\021\206\234k\362\310\203w 4\211\356\031\205W\265\336\367i\031OW\253I\325\370`\324\355CI\325\301\300rS/|K\376/\254\215\230\327\365\236\204p\230\256s%OC\006\275\f\204)b`\334\342=v\375\375k\236v!\215\276e$g\016K\303vn\022\374^\376\030\234\203Zi\300h\351\312\334\335\335p9\niJ\\\221\300$\246\345 B\f@\005\217\025\332\324\fz \024\247<\215\223y\357\022_QI\336?\\\234\346\023\304{k\021\371\0028\244U\310\207\324\035\336Y\t\034\217\276%\345$h\322\305\255\352\201\003\257\006\314G\376.\212\035B\352&\3340\250\272g\204/r#\025ZY\277\202[\343uEB\005\304!\211?:|y\270\2360\333g\v\363\234r\335a\313\233\363\0176\255\177\023by\223]\353\263\347\032\321}<\016\216\277~Z2\207I\303(Ps\376\204E(B+\361{\352@\351<\030@\323S\232\0167\361\3208B\230x\313\2103sP}5)\276\v\3666\321\037P\224iT}\315\023\333E)\363\'[\250\'\304\274D\352D=\224\030\240\256\275\031$\034B\377\377\310{\257\255\235h\200N\322\236\025\210\227m\272\251(\340\243\027\341\313\372[\327&\342f\235W\255\266\272\215\3078\034G\254\277\200;F\000\355\244g@\240W\360A\2127H\003t.\377\245\t(#\372\037\275\234\334]\335\265\036\036\"\3411\310\354D\254\225\332\261^\nO3\244\"\232\300s\333kN \262\222\227@\025\036}\230\245\n\212\v\201\254\247`\2413qi\252{\244\322\017,\245\f\373D\262\245\312A\224\303#k\370B$d\313Qu\314\251\223-/*\375\225x]\336f\247\302+\377,\303<\342Sn7U#F( \b\337\342\245\263\f\027\323\021\220\352\226x#n\247\245\255d&\003\263\370\321\215\025\000\354\203t\205N\302\377\207\233\270O\247\3223c\240\\:T\270yX&\227\304\\\234\002n\031\334\313\250;\037\246\324\210d*u\210@\0338P\262\360d\251\225\023\254pO\002A\351Z\033\001\213 \'\344\212\236\374\245\300\230<?\001/\357(\212V\020\252ES0y\272?\030L\0022\326\030\036|\025?\242\324aI\260\246x\326\314~\215p\272\360\'\370\234~a^\360Z\"\241G\302\321/\006\302\352D\033m\354]\214\237\355\\\320\006\212\245BV\332)\223\034\234\017:\246\241-\324l\371\245K\3178\360a\027\034\312s\023\302\302\271\225\201\023\017\031?\352\337\250(`\207\352_\336~\023\337\352\020N\263\3342\202\230\367\311F\177r\260\254\316@Xt\t2[\037\001\335\201\211\177\\\a[h\351G\3638+^z]a9\252\254\226O{\234\264\347\316V\327li+:\205>\247Y/VtP\325\rSS\230\377a\004R\207\301\247\3142"
