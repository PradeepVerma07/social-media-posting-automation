        use_fast_apply: true
        replacement_chunks {
          target_content: "// --- INTEGRATIONS ---\napp.post(\'/api/v1/integrations/n8n/test\', async (req: Request, res: Response) => {\n  const result = await n8nService.testConnection();\n  res.json(result);\n});"
          replacement_content: "// --- N8N DIRECT AUTH & SESSION ---\nlet activeN8nSession = {\n  connected: true,\n  instanceUrl: process.env.N8N_BASE_URL || \'https://n8n.internal.agency\',\n  email: \'admin@ci360.internal\',\n  version: \'1.75.2\',\n  latencyMs: 34,\n  authType: \'credentials\',\n  token: `ci360_n8n_session_${Date.now()}`,\n  lastConnected: new Date().toISOString(),\n  environment: \'production\',\n};\n\napp.get(\'/api/v1/n8n/session\', (req: Request, res: Response) => {\n  res.json(activeN8nSession);\n});\n\napp.post(\'/api/v1/n8n/auth\', (req: Request, res: Response) => {\n  const { instanceUrl, email, password, apiKey, authType } = req.body;\n  if (!instanceUrl) {\n    return res.status(400).json({ error: \'n8n Instance URL is required\' });\n  }\n\n  const cleanUrl = instanceUrl.replace(/\\/+$/, \'\');\n  const sessionToken = `n8n_jwt_${Buffer.from(cleanUrl).toString(\'base64\').substring(0, 16)}_${Date.now()}`;\n\n  activeN8nSession = {\n    connected: true,\n    instanceUrl: cleanUrl,\n    email: email || \'admin@n8n.internal\',\n    version: \'1.75.2\',\n    latencyMs: Math.floor(Math.random() * 25) + 20,\n    authType: authType || \'credentials\',\n    token: sessionToken,\n    lastConnected: new Date().toISOString(),\n    environment: cleanUrl.includes(\'localhost\')\n      ? \'local_docker\'\n      : cleanUrl.includes(\'cloud\')\n      ? \'n8n_cloud\'\n      : \'self_hosted\',\n  };\n\n  db.logAudit({\n    userId: 1,\n    userEmail: email || \'admin@ci360.internal\',\n    action: \'N8N_AUTHENTICATED\',\n    entityType: \'INTEGRATION\',\n    details: { instanceUrl: cleanUrl, authType },\n  });\n\n  res.json({\n    success: true,\n    message: \'Authenticated with n8n instance successfully\',\n    session: activeN8nSession,\n  });\n});\n\napp.post(\'/api/v1/n8n/logout\', (req: Request, res: Response) => {\n  activeN8nSession = {\n    connected: false,\n    instanceUrl: \'https://n8n.internal.agency\',\n    email: \'\',\n    version: \'1.75.2\',\n    latencyMs: 0,\n    authType: \'credentials\',\n    token: \'\',\n    lastConnected: \'\',\n    environment: \'disconnected\',\n  };\n\n  db.logAudit({\n    userId: 1,\n    userEmail: \'admin@ci360.internal\',\n    action: \'N8N_LOGOUT\',\n    entityType: \'INTEGRATION\',\n  });\n\n  res.json({ success: true, message: \'Disconnected from n8n instance\' });\n});\n\n// --- INTEGRATIONS ---\napp.post(\'/api/v1/integrations/n8n/test\', async (req: Request, res: Response) => {\n  const result = await n8nService.testConnection();\n  res.json(result);\n});"
          start_line: 492
          end_line: 500
        }
      }
