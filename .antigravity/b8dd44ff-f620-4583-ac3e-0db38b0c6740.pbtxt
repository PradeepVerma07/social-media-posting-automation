            }
            lines {
              text: "                  e.stopPropagation();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  onDeleteConnection(conn.id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                }}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
