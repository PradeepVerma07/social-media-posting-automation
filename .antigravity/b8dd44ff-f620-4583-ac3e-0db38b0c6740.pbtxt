    content: "            <span>\302\267</span>\n            <span>n8n ORCHESTRATION BRIDGE</span>\n          </div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-[#101828]\">\n            Social Media Operations Dashboard\n          </h1>\n          <p className=\"text-xs text-[#667085] max-w-2xl\">\n            Orchestrate multi-brand social distribution, review incoming approval requests, monitor n8n background executions, and inspect platform analytics in real time.\n          </p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => onNavigateToTab(\'create\')}\n            className=\"px-4 py-2.5 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-md shadow-[#1336E8]/20 transition-all flex items-center gap-1.5\"\n          >\n            <span>+ Create New Post</span>\n          </button>\n        </div>\n      </div>\n\n      {/* 8 KPI Cards Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n        {KPI_CARDS.map((kpi, i) => {\n          const Icon = kpi.icon;\n          return (\n            <div\n              key={i}\n              className=\"bg-white p-4 sm:p-5 rounded-2xl border border-[#EAECF0] shadow-sm hover:shadow-md transition-shadow space-y-3\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-medium text-[#667085] line-clamp-1\">{kpi.label}</span>\n                <div className={`w-8 h-8 rounded-xl ${kpi.bg} ${kpi.color} flex items-center justify-center shrink-0`}>\n                  <Icon className=\"w-4 h-4\" />\n                </div>\n              </div>\n              <div>\n                <div className=\"text-2xl font-bold text-[#101828] font-mono tracking-tight\">\n                  {kpi.value}\n                </div>\n                <div className=\"text-[11px] text-[#667085] mt-0.5\">{kpi.sub}</div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* 2-Column Section: Publishing Activity & Platform Health */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: Scheduled Posts & Pending Approvals */}\n        <div className=\"lg:col-span-8 space-y-6\">"
    num_lines: 351
