    content: "        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'pipelines\')}\n          className={`px-4 py-2 rounded-xl flex items-center gap-2 transition-all cursor-pointer ${\n            activeSubTab === \'pipelines\'\n              ? \'bg-[#1336E8] text-white shadow-sm font-semibold\'\n              : \'text-[#667085] hover:text-[#101828] hover:bg-white\'\n          }`}\n        >\n          <LayoutGrid className=\"w-3.5 h-3.5\" />\n          <span>Active Pipelines ({workflows.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'integrations\')}\n          className={`px-4 py-2 rounded-xl flex items-center gap-2 transition-all cursor-pointer ${\n            activeSubTab === \'integrations\'\n              ? \'bg-[#1336E8] text-white shadow-sm font-semibold\'\n              : \'text-[#667085] hover:text-[#101828] hover:bg-white\'\n          }`}\n        >\n          <Code2 className=\"w-3.5 h-3.5\" />\n          <span>Developer Guides</span>\n        </button>\n\n        <button\n          onClick={() => setIsWebhookSandboxOpen(true)}\n          className=\"px-4 py-2 rounded-xl flex items-center gap-2 text-[#667085] hover:text-[#101828] hover:bg-white transition-all cursor-pointer ml-auto shrink-0\"\n        >\n          <WebhookIcon className=\"w-3.5 h-3.5 text-[#FF6D5A]\" />\n          <span>Webhook Sandbox</span>\n        </button>\n      </div>\n\n      {/* VIEW: VISUAL WORKFLOW CANVAS (WITH NODE X) */}\n      {activeSubTab === \'canvas\' && (\n        <div className=\"space-y-4 animate-in fade-in duration-200\">\n          {/* Canvas Toolbar */}\n          <div className=\"bg-slate-900 text-white p-4 rounded-2xl border border-slate-800 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n            <div className=\"flex flex-wrap items-center gap-3\">\n              {/* Template Picker */}\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-[11px] font-mono text-slate-400\">Workflow:</span>\n                <select\n                  value={currentWorkflow.id}\n                  onChange={e => handleSelectTemplate(e.target.value)}\n                  className=\"px-3 py-1.5 bg-slate-950 border border-slate-700 rounded-lg text-xs font-semibold text-white focus:outline-none focus:border-[#ff6d5a] cursor-pointer\"\n                >\n                  {WORKFLOW_TEMPLATES.map(t => (\n                    <option key={t.id} value={t.id}>\n                      {t.name}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Status Badge */}\n              <div className=\"hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-slate-800/80 rounded-lg border border-slate-700/80 text-[11px] font-mono text-slate-300\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n                <span>{currentWorkflow.nodes.length} Nodes</span>\n                <span>\302\267</span>\n                <span>{currentWorkflow.connections.length} Wires</span>\n              </div>\n            </div>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-wrap items-center gap-2 w-full md:w-auto\">\n              <button\n                onClick={handleQuickAddXNode}\n                className=\"px-3 py-1.5 bg-black hover:bg-zinc-800 border border-zinc-700 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm cursor-pointer\""
