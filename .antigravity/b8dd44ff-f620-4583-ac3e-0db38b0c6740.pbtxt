    content: "import React, { useState } from \'react\';\nimport {\n  Users,\n  UserPlus,\n  Edit2,\n  Trash2,\n  Search,\n  Filter,\n  Shield,\n  CheckCircle2,\n  XCircle,\n  X,\n  Mail,\n  UserCheck,\n  Building2,\n  KeyRound,\n  MoreVertical,\n  Check\n} from \'lucide-react\';\nimport { User, RoleName } from \'../../../server/src/types\';\n\ninterface TeamPageProps {\n  users: User[];\n  currentRole: RoleName;\n  onAddUser: (userData: {\n    fullName: string;\n    email: string;\n    role: RoleName;\n    tenantScope: string;\n    isActive: boolean;\n  }) => Promise<void>;\n  onUpdateUser: (id: number, updates: Partial<User>) => Promise<void>;\n  onDeleteUser: (id: number) => Promise<void>;\n}\n\nconst ROLE_OPTIONS: { role: RoleName; label: string; desc: string; badgeClass: string }[] = [\n  {\n    role: \'Super Admin\',\n    label: \'Super Admin\',\n    desc: \'Unrestricted full access across all brands, integrations, and RBAC policies.\',"
