  view_file {
    absolute_path_uri: "file:///src/types/workflow.ts"
    end_line: 72
    content: "export type NodeType =\n  | \'webhook\'\n  | \'schedule\'\n  | \'manual\'\n  | \'httpRequest\'\n  | \'code\'\n  | \'editFields\'\n  | \'if\'\n  | \'filter\'\n  | \'slackWebhook\'\n  | \'email\';\n\nexport interface NodeCategory {\n  id: \'trigger\' | \'action\' | \'transform\' | \'flow\';\n  label: string;\n}\n\nexport interface NodeDefinition {\n  type: NodeType;\n  name: string;\n  category: \'trigger\' | \'action\' | \'transform\' | \'flow\';\n  icon: string;\n  description: string;\n  defaultParameters: Record<string, any>;\n  inputs: number;\n  outputs: number;\n}\n\nexport interface WorkflowNode {\n  id: string;\n  name: string;\n  type: NodeType;\n  position: [number, number];\n  parameters: Record<string, any>;\n  status?: \'idle\' | \'running\' | \'success\' | \'error\';\n  executionResult?: {\n    input?: any;\n    output?: any;\n    durationMs?: number;\n    error?: string;\n    timestamp?: string;\n  };\n}\n\nexport interface WorkflowConnection {\n  id: string;\n  fromNodeId: string;\n  fromOutputIndex: number;\n  toNodeId: string;\n  toInputIndex: number;\n}\n\nexport interface Workflow {\n  id: string;\n  name: string;\n  active: boolean;\n  nodes: WorkflowNode[];\n  connections: WorkflowConnection[];\n  updatedAt: string;\n}\n\nexport interface ExecutionLogEntry {\n  id: string;\n  workflowId: string;\n  workflowName: string;\n  status: \'success\' | \'error\' | \'running\';\n  startedAt: string;\n  durationMs: number;\n  triggeredBy: string;\n  nodeCount: number;\n  itemCount: number;\n}\n"
    num_lines: 73
    num_bytes: 1408
    line_range_bytes: 1408
  }
}
