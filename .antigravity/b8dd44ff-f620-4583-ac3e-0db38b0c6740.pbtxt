              text: "                        <th className=\"py-2 px-3\">Item #</th>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        <th className=\"py-2 px-3\">Key Fields</th>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
