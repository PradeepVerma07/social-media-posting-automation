    content: "import { NodeDefinition } from \'../types/workflow\';\n\nexport const NODE_DEFINITIONS: Record<string, NodeDefinition> = {\n  webhook: {\n    type: \'webhook\',\n    name: \'Webhook\',\n    category: \'trigger\',\n    icon: \'Webhook\',\n    description: \'Starts the workflow when an HTTP request is received\',\n    inputs: 0,\n    outputs: 1,\n    defaultParameters: {\n      path: \'/webhook/test-event\',\n      httpMethod: \'POST\',\n      responseMode: \'onReceived\',\n      responseData: \'allEntries\',\n      testPayload: JSON.stringify(\n        {\n          event: \'order.created\',\n          orderId: \'ORD-98231\',\n          customer: {\n            name: \'Sarah Connor\',\n            email: \'sarah@example.com\',\n          },\n          total: 149.5,\n          items: [\n            { id: \'sku-1\', name: \'Standard Subscription\', price: 99.5 },\n            { id: \'sku-2\', name: \'Priority Support Add-on\', price: 50.0 },\n          ],\n        },\n        null,\n        2\n      ),\n    },\n  },\n  schedule: {\n    type: \'schedule\',\n    name: \'Schedule Trigger\',\n    category: \'trigger\',\n    icon: \'Clock\',\n    description: \'Triggers the workflow at set recurring intervals or cron times\',\n    inputs: 0,\n    outputs: 1,\n    defaultParameters: {\n      rule: \'interval\',\n      intervalHours: 1,\n      cronExpression: \'0 * * * *\',\n      timezone: \'UTC\',\n    },\n  },\n  manual: {\n    type: \'manual\',\n    name: \'When clicking Test workflow\',\n    category: \'trigger\',\n    icon: \'PlayCircle\',\n    description: \'Triggers the workflow immediately on manual execution\',\n    inputs: 0,\n    outputs: 1,\n    defaultParameters: {\n      sampleData: JSON.stringify(\n        {\n          timestamp: new Date().toISOString(),\n          userId: \'usr_7721\',\n          action: \'manual_verification\',\n          status: \'initiated\',\n        },\n        null,\n        2\n      ),\n    },\n  },\n  httpRequest: {\n    type: \'httpRequest\',\n    name: \'HTTP Request\',\n    category: \'action\',\n    icon: \'Globe\',\n    description: \'Sends an HTTP/REST request to any API endpoint\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      method: \'GET\',\n      url: \'https://jsonplaceholder.typicode.com/posts/1\',\n      sendHeaders: true,\n      headers: JSON.stringify({ \'Content-Type\': \'application/json\' }, null, 2),\n      sendBody: false,\n      body: \'{}\',\n    },\n  },\n  code: {\n    type: \'code\',\n    name: \'Code (JavaScript)\',\n    category: \'transform\',\n    icon: \'Code2\',\n    description: \'Run custom JavaScript to transform and process data\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      code: `// Loop over input items and transform\nconst items = $input.all();\nreturn items.map((item, index) => {\n  const data = item.json || item;\n  return {\n    json: {\n      ...data,\n      processedAt: new Date().toISOString(),\n      itemIndex: index + 1,\n      isProcessed: true,\n      normalizedScore: Math.round(((data.total || data.id || 100) * 1.15) * 100) / 100,\n    }\n  };\n});`,\n    },\n  },\n  editFields: {\n    type: \'editFields\',\n    name: \'Edit Fields (Set)\',\n    category: \'transform\',\n    icon: \'Sliders\',\n    description: \'Set, update, or remove key-value fields on incoming items\',\n    inputs: 1,"
