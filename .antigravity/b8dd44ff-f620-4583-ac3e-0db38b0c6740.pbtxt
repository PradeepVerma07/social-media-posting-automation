  view_file {
    absolute_path_uri: "file:///src/features/workflows/AutomationsPage.tsx"
    start_line: 69
    end_line: 109
    content: "  // Visual Workflow Canvas state (Default loaded to X (Twitter) template)\n  const [currentWorkflow, setCurrentWorkflow] = useState<Workflow>(() => {\n    const xTemplate = WORKFLOW_TEMPLATES.find(t => t.id === \'tpl-x-social-orchestrator\') || WORKFLOW_TEMPLATES[0];\n    return JSON.parse(JSON.stringify(xTemplate));\n  });\n  const [selectedNodeId, setSelectedNodeId] = useState<string | null>(\'node-x-3\'); // Select Node X by default\n  const [isLibraryOpen, setIsLibraryOpen] = useState(false);\n  const [isJsonModalOpen, setIsJsonModalOpen] = useState(false);\n  const [jsonModalMode, setJsonModalMode] = useState<\'export\' | \'import\'>(\'export\');\n  const [isWebhookSandboxOpen, setIsWebhookSandboxOpen] = useState(false);\n  const [isRunningCanvasWorkflow, setIsRunningCanvasWorkflow] = useState(false);\n  const [workflowSuccessBanner, setWorkflowSuccessBanner] = useState<string | null>(null);\n\n  const selectedNode = currentWorkflow.nodes.find(n => n.id === selectedNodeId) || null;\n\n  const handleTest = async () => {\n    setTestingConnection(true);\n    try {\n      const res = await onTestConnection();\n      setConnectionResult(res);\n    } finally {\n      setTestingConnection(false);\n    }\n  };\n\n  const handleExecute = async (id: number) => {\n    setExecutingId(id);\n    try {\n      await onExecuteWorkflow(id);\n    } finally {\n      setTimeout(() => setExecutingId(null), 1000);\n    }\n  };\n\n  // Switch templates in canvas\n  const handleSelectTemplate = (templateId: string) => {\n    const found = WORKFLOW_TEMPLATES.find(t => t.id === templateId);\n    if (found) {\n      setCurrentWorkflow(JSON.parse(JSON.stringify(found)));\n      const firstX = found.nodes.find(n => n.type === \'xNode\');\n      setSelectedNodeId(firstX ? firstX.id : (found.nodes[0]?.id || null));"
    num_lines: 775
    num_bytes: 32189
    line_range_bytes: 1769
  }
}
