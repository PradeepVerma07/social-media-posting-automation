  planner_response {
    thinking: "**Refining Post Card Header**\n\nI\'m currently updating `ApprovalQueue.tsx` by focusing on the post card header\'s layout in the detail panel. I\'m implementing a `flex` container with `flex-col` for smaller screens, transitioning to `flex-row` on larger screens. The goal is to ensure items align properly and the brand badge has the required styles. I\'m tweaking whitespace and padding, adding a rounded look.\n\n\n"
    tool_calls {
      id: "call_304926"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Make ApprovalQueue header, tabs, and action buttons completely responsive across all viewports\", \"EndLine\":238, \"Instruction\":\"Update ApprovalQueue header and post detail action header to avoid awkward wrapping\", \"ReplacementContent\":\"      {/* Tabs */}\\n      <div className=\\\"flex items-center gap-2 border-b border-[#EAECF0] pb-2.5 overflow-x-auto no-scrollbar\\\">\\n        {(\\n          [\\n            { id: \'pending\', label: \'Pending Review\', count: posts.filter(p => p.approvalStatus === \'in_review\').length },\\n            { id: \'revision\', label: \'Revision Requested\', count: posts.filter(p => p.approvalStatus === \'revision_requested\').length },\\n            { id: \'approved\', label: \'Approved & Scheduled\', count: posts.filter(p => p.approvalStatus === \'approved\').length },\\n            { id: \'rejected\', label: \'Rejected\', count: posts.filter(p => p.approvalStatus === \'rejected\').length },\\n          ] as const\\n        ).map(tab => (\\n          <button\\n            key={tab.id}\\n            onClick={() => setActiveTab(tab.id)}\\n            className={`flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors shrink-0 ${\\n              activeTab === tab.id\\n                ? \'bg-[#1336E8] text-white shadow-sm\'\\n                : \'text-[#344054] hover:bg-[#F2F4F7]\'\\n            }`}\\n          >\\n            <span>{tab.label}</span>\\n            <span\\n              className={`px-1.5 py-0.2 rounded-full text-[10px] font-bold ${\\n                activeTab === tab.id ? \'bg-white text-[#1336E8]\' : \'bg-[#F2F4F7] text-[#667085]\'\\n              }`}\\n            >\\n              {tab.count}\\n            </span>\\n          </button>\\n        ))}\\n      </div>\\n\\n      {/* Main Split Grid: Posts List (Left) + Detail & Chat Panel (Right) */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        {/* Left: Queue Items */}\\n        <div className=\\\"lg:col-span-5 space-y-3\\\">\\n          <span className=\\\"text-xs font-semibold text-[#667085] block\\\">\\n            {filteredPosts.length} Items in this queue:\\n          </span>\\n\\n          {filteredPosts.map(post => {\\n            const isSelected = selectedPost?.id === post.id;\\n            return (\\n              <div\\n                key={post.id}\\n                onClick={() => setSelectedPostId(post.id)}\\n                className={`p-4 rounded-2xl border cursor-pointer transition-all ${\\n                  isSelected\\n                    ? \'border-[#1336E8] bg-white shadow-md ring-2 ring-[#1336E8]/10\'\\n                    : \'border-[#EAECF0] bg-white hover:bg-[#F9FAFB] shadow-sm\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between mb-1.5 gap-2\\\">\\n                  <span className=\\\"px-2 py-0.5 rounded-md bg-[#EFF8FF] text-[#1336E8] text-[10px] font-bold uppercase truncate max-w-[200px]\\\">\\n                    {post.brandName}\\n                  </span>\\n                  <span className=\\\"text-[10px] font-mono text-[#667085] whitespace-nowrap shrink-0\\\">\\n                    v{post.versionNumber} \302\267 {new Date(post.createdAt).toLocaleDateString()}\\n                  </span>\\n                </div>\\n                <h4 className=\\\"text-xs font-bold text-[#101828] line-clamp-1\\\">{post.title}</h4>\\n                <p className=\\\"text-[11px] text-[#475467] line-clamp-2 mt-1 leading-relaxed\\\">\\n                  {post.masterCaption}\\n                </p>\\n\\n                <div className=\\\"flex items-center justify-between mt-3 pt-2 border-t border-[#F2F4F7] text-[11px] text-[#667085]\\\">\\n                  <span className=\\\"flex items-center gap-1\\\">\\n                    <MessageSquare className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>{post.commentsCount || 0} notes</span>\\n                  </span>\\n                  <span className=\\\"capitalize font-semibold text-[#101828]\\\">\\n                    {post.approvalStatus.replace(\'_\', \' \')}\\n                  </span>\\n                </div>\\n              </div>\\n            );\\n          })}\\n\\n          {filteredPosts.length === 0 && (\\n            <div className=\\\"p-8 text-center border border-dashed border-[#EAECF0] rounded-2xl text-xs text-[#667085] bg-white\\\">\\n              No items in this queue.\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Right: Detailed Post Preview + WhatsApp-Style Review Discussion */}\\n        {selectedPost ? (\\n          <div className=\\\"lg:col-span-7 space-y-6\\\" id=\\\"review-detail-panel\\\">\\n            {/* Post Detail Header & Actions */}\\n            <div className=\\\"bg-white p-4 sm:p-6 rounded-2xl border border-[#EAECF0] shadow-sm space-y-4\\\">\\n              <div className=\\\"flex flex-col xl:flex-row items-start xl:items-center justify-between gap-3 border-b border-[#EAECF0] pb-4\\\">\\n                <div className=\\\"space-y-1 min-w-0\\\">\\n                  <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                    <span className=\\\"px-2.5 py-0.5 rounded-md bg-[#EFF8FF] text-[#1336E8] text-[10px] font-bold uppercase tracking-wider whitespace-nowrap\\\">\\n                      {selectedPost.brandName}\\n                    </span>\\n                    <span className=\\\"text-xs text-[#98A2B3]\\\">\302\267</span>\\n                    <span className=\\\"text-xs font-mono text-[#667085] whitespace-nowrap\\\">\\n                      Created by {selectedPost.createdByName}\\n                    </span>\\n                  </div>\\n                  <h3 className=\\\"text-base sm:text-lg font-bold text-[#101828] leading-snug\\\">{selectedPost.title}</h3>\\n                </div>\\n\\n                {/* Primary Approval Actions */}\\n                <div className=\\\"flex flex-wrap items-center gap-2 w-full xl:w-auto shrink-0 pt-1 xl:pt-0\\\">\\n                  {selectedPost.approvalStatus !== \'approved\' && (\\n                    <>\\n                      <button\\n                        onClick={() => {\\n                          setModalInputText(\'\');\\n                          setRevisionModalOpen(true);\\n                        }}\\n                        className=\\\"flex-1 sm:flex-initial min-h-[38px] px-3.5 py-2 bg-[#FEF0C7] hover:bg-[#FEDF89] text-[#B54708] text-xs font-semibold rounded-xl transition-colors text-center\\\"\\n                      >\\n                        Request Revision\\n                      </button>\\n                      <button\\n                        onClick={() => {\\n                          setModalInputText(\'\');\\n                          setRejectReasonModalOpen(true);\\n                        }}\\n                        className=\\\"flex-1 sm:flex-initial min-h-[38px] px-3.5 py-2 bg-[#FEF3F2] hover:bg-[#FECDCA] text-[#B42318] text-xs font-semibold rounded-xl transition-colors text-center\\\"\\n                      >\\n                        Reject\\n                      </button>\\n                      <button\\n                        onClick={() => onApprove(selectedPost.id)}\\n                        className=\\\"w-full sm:w-auto min-h-[38px] px-4 py-2 bg-[#12B76A] hover:bg-[#027A48] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center justify-center gap-1.5\\\"\\n                      >\\n                        <Check className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Approve Content</span>\\n                      </button>\\n                    </>\\n                  )}\\n                  {selectedPost.approvalStatus === \'approved\' && selectedPost.publishingStatus !== \'published\' && (\\n                    <button\\n                      onClick={() => onPublishNow(selectedPost.id)}\\n                      className=\\\"w-full sm:w-auto min-h-[38px] px-4 py-2 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center justify-center gap-1.5\\\"\\n                    >\\n                      <Send className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Trigger n8n Publish Now</span>\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\", \"StartLine\":93, \"TargetContent\":\"      {/* Tabs */}\\n      <div className=\\\"flex items-center gap-2 border-b border-[#EAECF0] pb-3 overflow-x-auto\\\">\\n        {(\\n          [\\n            { id: \'pending\', label: \'Pending Review\', count: posts.filter(p => p.approvalStatus === \'in_review\').length },\\n            { id: \'revision\', label: \'Revision Requested\', count: posts.filter(p => p.approvalStatus === \'revision_requested\').length },\\n            { id: \'approved\', label: \'Approved & Scheduled\', count: posts.filter(p => p.approvalStatus === \'approved\').length },\\n            { id: \'rejected\', label: \'Rejected\', count: posts.filter(p => p.approvalStatus === \'rejected\').length },\\n          ] as const\\n        ).map(tab => (\\n          <button\\n            key={tab.id}\\n            onClick={() => setActiveTab(tab.id)}\\n            className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors ${\\n              activeTab === tab.id\\n                ? \'bg-[#1336E8] text-white shadow-sm\'\\n                : \'text-[#344054] hover:bg-[#F2F4F7]\'\\n            }`}\\n          >\\n            <span>{tab.label}</span>\\n            <span\\n              className={`px-1.5 py-0.2 rounded-full text-[10px] font-bold ${\\n                activeTab === tab.id ? \'bg-white text-[#1336E8]\' : \'bg-[#F2F4F7] text-[#667085]\'\\n              }`}\\n            >\\n              {tab.count}\\n            </span>\\n          </button>\\n        ))}\\n      </div>\\n\\n      {/* Main Split Grid: Posts List (Left) + Detail & Chat Panel (Right) */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        {/* Left: Queue Items */}\\n        <div className=\\\"lg:col-span-5 space-y-3\\\">\\n          <span className=\\\"text-xs font-semibold text-[#667085] block\\\">\\n            {filteredPosts.length} Items in this queue:\\n          </span>\\n\\n          {filteredPosts.map(post => {\\n            const isSelected = selectedPost?.id === post.id;\\n            return (\\n              <div\\n                key={post.id}\\n                onClick={() => setSelectedPostId(post.id)}\\n                className={`p-4 rounded-2xl border cursor-pointer transition-all ${\\n                  isSelected\\n                    ? \'border-[#1336E8] bg-white shadow-md ring-2 ring-[#1336E8]/10\'\\n                    : \'border-[#EAECF0] bg-white hover:bg-[#F9FAFB] shadow-sm\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between mb-1.5\\\">\\n                  <span className=\\\"px-2 py-0.5 rounded-md bg-[#EFF8FF] text-[#1336E8] text-[10px] font-bold uppercase\\\">\\n                    {post.brandName}\\n                  </span>\\n                  <span className=\\\"text-[10px] font-mono text-[#667085]\\\">\\n                    v{post.versionNumber} \302\267 {new Date(post.createdAt).toLocaleDateString()}\\n                  </span>\\n                </div>\\n                <h4 className=\\\"text-xs font-bold text-[#101828] line-clamp-1\\\">{post.title}</h4>\\n                <p className=\\\"text-[11px] text-[#475467] line-clamp-2 mt-1 leading-relaxed\\\">\\n                  {post.masterCaption}\\n                </p>\\n\\n                <div className=\\\"flex items-center justify-between mt-3 pt-2 border-t border-[#F2F4F7] text-[11px] text-[#667085]\\\">\\n                  <span className=\\\"flex items-center gap-1\\\">\\n                    <MessageSquare className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>{post.commentsCount || 0} notes</span>\\n                  </span>\\n                  <span className=\\\"capitalize font-semibold text-[#101828]\\\">\\n                    {post.approvalStatus.replace(\'_\', \' \')}\\n                  </span>\\n                </div>\\n              </div>\\n            );\\n          })}\\n\\n          {filteredPosts.length === 0 && (\\n            <div className=\\\"p-8 text-center border border-dashed border-[#EAECF0] rounded-2xl text-xs text-[#667085] bg-white\\\">\\n              No items in this queue.\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Right: Detailed Post Preview + WhatsApp-Style Review Discussion */}\\n        {selectedPost ? (\\n          <div className=\\\"lg:col-span-7 space-y-6\\\">\\n            {/* Post Detail Header & Actions */}\\n            <div className=\\\"bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm space-y-4\\\">\\n              <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#EAECF0] pb-4\\\">\\n                <div>\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <span className=\\\"text-xs font-mono font-bold text-[#1336E8] uppercase\\\">\\n                      {selectedPost.brandName}\\n                    </span>\\n                    <span className=\\\"text-xs text-[#98A2B3]\\\">\302\267</span>\\n                    <span className=\\\"text-xs font-mono text-[#667085]\\\">\\n                      Created by {selectedPost.createdByName}\\n                    </span>\\n                  </div>\\n                  <h3 className=\\\"text-base font-bold text-[#101828] mt-1\\\">{selectedPost.title}</h3>\\n                </div>\\n\\n                {/* Primary Approval Actions */}\\n                <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                  {selectedPost.approvalStatus !== \'approved\' && (\\n                    <>\\n                      <button\\n                        onClick={() => {\\n                          setModalInputText(\'\');\\n                          setRevisionModalOpen(true);\\n                        }}\\n                        className=\\\"px-3 py-1.5 bg-[#FEF0C7] hover:bg-[#FEDF89] text-[#B54708] text-xs font-semibold rounded-xl transition-colors\\\"\\n                      >\\n                        Request Revision\\n                      </button>\\n                      <button\\n                        onClick={() => {\\n                          setModalInputText(\'\');\\n                          setRejectReasonModalOpen(true);\\n                        }}\\n                        className=\\\"px-3 py-1.5 bg-[#FEF3F2] hover:bg-[#FECDCA] text-[#B42318] text-xs font-semibold rounded-xl transition-colors\\\"\\n                      >\\n                        Reject\\n                      </button>\\n                      <button\\n                        onClick={() => onApprove(selectedPost.id)}\\n                        className=\\\"px-4 py-1.5 bg-[#12B76A] hover:bg-[#027A48] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\\\"\\n                      >\\n                        <Check className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Approve Content</span>\\n                      </button>\\n                    </>\\n                  )}\\n                  {selectedPost.approvalStatus === \'approved\' && selectedPost.publishingStatus !== \'published\' && (\\n                    <button\\n                      onClick={() => onPublishNow(selectedPost.id)}\\n                      className=\\\"px-4 py-1.5 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\\\"\\n                    >\\n                      <Send className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Trigger n8n Publish Now</span>\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\", \"TargetFile\":\"/src/features/approvals/ApprovalQueue.tsx\", \"toolAction\":\"Making ApprovalQueue responsive\", \"toolSummary\":\"Make ApprovalQueue responsive\"}"
