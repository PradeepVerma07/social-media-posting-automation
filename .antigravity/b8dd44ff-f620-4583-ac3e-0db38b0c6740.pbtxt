  view_file {
    absolute_path_uri: "file:///src/features/workflows/AutomationsPage.tsx"
    end_line: 99
    content: "import React, { useState } from \'react\';\nimport {\n  Cpu,\n  Play,\n  Activity,\n  CheckCircle2,\n  AlertCircle,\n  ExternalLink,\n  ShieldCheck,\n  RefreshCw,\n  Clock,\n  Layers,\n  Terminal\n} from \'lucide-react\';\nimport { WorkflowMapping } from \'../../../server/src/types\';\n\ninterface AutomationsPageProps {\n  workflows: WorkflowMapping[];\n  onExecuteWorkflow: (workflowId: number) => void;\n  onTestConnection: () => Promise<{ reachable: boolean; latencyMs: number; version?: string }>;\n  onViewExecutions: () => void;\n}\n\nexport const AutomationsPage: React.FC<AutomationsPageProps> = ({\n  workflows,\n  onExecuteWorkflow,\n  onTestConnection,\n  onViewExecutions,\n}) => {\n  const [testingConnection, setTestingConnection] = useState(false);\n  const [connectionResult, setConnectionResult] = useState<{\n    reachable: boolean;\n    latencyMs: number;\n    version?: string;\n  } | null>(null);\n  const [executingId, setExecutingId] = useState<number | null>(null);\n\n  const handleTest = async () => {\n    setTestingConnection(true);\n    try {\n      const res = await onTestConnection();\n      setConnectionResult(res);\n    } finally {\n      setTestingConnection(false);\n    }\n  };\n\n  const handleExecute = async (id: number) => {\n    setExecutingId(id);\n    try {\n      await onExecuteWorkflow(id);\n    } finally {\n      setTimeout(() => setExecutingId(null), 1000);\n    }\n  };\n\n  return (\n    <div className=\"p-4 sm:p-6 lg:p-8 space-y-8 max-w-7xl mx-auto\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm\">\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-2 text-xs font-mono text-[#1336E8] font-bold\">\n            <span>n8n REST API &amp; PRODUCTION WEBHOOKS</span>\n            <span>\302\267</span>\n            <span>ALLOWLIST ENFORCED</span>\n          </div>\n          <h2 className=\"text-xl font-bold text-[#101828]\">Automations &amp; Workflows</h2>\n          <p className=\"text-xs text-[#667085] max-w-2xl\">\n            Execute and monitor business automations running in your self-hosted n8n environment. All outbound requests are signed with HMAC SHA-256 and include idempotency keys.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2 w-full sm:w-auto shrink-0\">\n          <button\n            onClick={handleTest}\n            disabled={testingConnection}\n            className=\"px-3.5 py-2 bg-white border border-[#D0D5DD] hover:bg-[#F2F4F7] text-[#344054] text-xs font-semibold rounded-xl flex items-center gap-1.5 transition-colors\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 ${testingConnection ? \'animate-spin\' : \'\'}`} />\n            <span>Test n8n Bridge</span>\n          </button>\n          <button\n            onClick={onViewExecutions}\n            className=\"px-3.5 py-2 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\"\n          >\n            <Activity className=\"w-3.5 h-3.5\" />\n            <span>View Executions</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Connection Test Banner if tested */}\n      {connectionResult && (\n        <div\n          className={`p-4 rounded-xl border flex items-center justify-between text-xs animate-in fade-in duration-150 ${\n            connectionResult.reachable\n              ? \'bg-[#ECFDF3] border-[#A6F4C5] text-[#027A48]\'\n              : \'bg-[#FEF3F2] border-[#FECDCA] text-[#B42318]\'\n          }`}\n        >"
    num_lines: 177
    num_bytes: 7263
    line_range_bytes: 3567
  }
}
