    thinking_signature: "\022\221\002\n\216\002\001i\024}\023Z\030\311\360\021\313*lQ\207mc_\207\020\310\200\342}\220\220<\005l\323\315\217B\264Spd\333\004[cC\000D\372\246o\f\275\375\210RL\357\037\236\231\247\264\246h\243\340\225j\334Yd\v\300ws\373\321\224\2560\324\252\221g\377%.\222\006G\342\264e\002\344\225@\217\246-\264\333\216}C\227\323\305\277\361\365\216\205X\022S\202\352\350\017\245\320\006\212\206\310\357T(I\223\t\202\356$\025\210Ty\a\2607?\300\252\017C\374\031\031yHC\270=\323O\345\311\\#\001\206\202Ee\316e\310hK|\253u\252\214P\352D\303\347m\245\304\250\352\f\034\321\2307\036\356\354L:I\223\321I\374\340\323\337\266\355\246\370\300d\262\325\036a\000\346N\344\223f\300\215\025Q\244M\360\233\331\005\261\235\0268\3161\342\274I\243\023e\272G\350G\307$\343\312\370\210\230\341\362\'\201\321\252\225\033Z\024_w.j\276\227\232\312]\220"
