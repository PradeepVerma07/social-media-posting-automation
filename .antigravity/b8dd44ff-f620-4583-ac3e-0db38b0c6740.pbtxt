  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Check,\n  ChevronRight,\n  ChevronLeft,\n  Upload,\n  Link,\n  Image as ImageIcon,\n  Smile,\n  Calendar,\n  Clock,\n  Send,\n  Save,\n  CheckCircle2,\n  AlertTriangle,\n  Globe,\n  FileCheck\n} from \'lucide-react\';\nimport { Brand, SocialPlatform } from \'../../../server/src/types\';\n\ninterface CreatePostComposerProps {\n  brands: Brand[];\n  onSavePost: (postData: any) => void;\n  onCancel: () => void;\n}\n\nexport const CreatePostComposer: React.FC<CreatePostComposerProps> = ({\n  brands,\n  onSavePost,\n  onCancel,\n}) => {\n  const [currentStep, setCurrentStep] = useState<number>(1);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n\n  // Form State\n  const [brandId, setBrandId] = useState<number>(brands[0]?.id || 1);\n  const [campaignName, setCampaignName] = useState(\'Q4 Product Launch\');\n  const [title, setTitle] = useState(\'\');\n  const [internalTags, setInternalTags] = useState(\'cloud, enterprise, release\');\n  const [country, setCountry] = useState(\'US\');\n  const [timezone, setTimezone] = useState(\'America/New_York\');\n\n  // Step 2: Platforms\n  const [selectedPlatforms, setSelectedPlatforms] = useState<SocialPlatform[]>([\n    \'linkedin\',\n    \'x\',\n  ]);\n\n  // Step 3: Media\n  const [mediaUrl, setMediaUrl] = useState(\n    \'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&h=630&q=80\'\n  );\n  const [googleDriveUrl, setGoogleDriveUrl] = useState(\'\');\n  const [altText, setAltText] = useState(\'Product architecture diagram\');\n\n  // Step 4: Captions & Overrides\n  const [masterCaption, setMasterCaption] = useState(\n    \'Announcing our new multi-cloud failover clustering engine! Sub-10ms latency across regions.\'\n  );\n  const [platformOverrides, setPlatformOverrides] = useState<Record<string, string>>({\n    x: \'Zero downtime multi-cloud clustering is live! Sub-10ms latency across regions. #DevOps\',\n  });\n  const [hashtags, setHashtags] = useState(\'#CloudNative #DevOps #Kubernetes\');\n  const [keywords, setKeywords] = useState(\'kubernetes, high availability\');\n  const [targetUrl, setTargetUrl] = useState(\'https://nexuscloud.io/release-v2\');\n  const [firstComment, setFirstComment] = useState(\'Check out the full benchmark report here!\');\n\n  // Step 5: Schedule\n  const [publishTiming, setPublishTiming] = useState<\'now\' | \'scheduled\'>(\'scheduled\');\n  const [scheduledDate, setScheduledDate] = useState(\'2026-10-28\');\n  const [scheduledTime, setScheduledTime] = useState(\'14:00\');\n\n  // Step 6: Approval\n  const [assignedApproverId, setAssignedApproverId] = useState(3);\n  const [internalNote, setInternalNote] = useState(\'Prepared for technical audience. Please review X override.\');\n\n  const togglePlatform = (p: SocialPlatform) => {\n    setSelectedPlatforms(prev =>\n      prev.includes(p) ? prev.filter(item => item !== p) : [...prev, p]\n    );\n  };\n\n  const handleFinish = (submitForApproval: boolean) => {\n    setIsSubmitting(true);\n    const postData = {\n      brandId,\n      campaignName,\n      title: title || \'Untitled Post\',\n      masterCaption,\n      firstComment,\n      hashtags,\n      keywords,\n      targetUrl,\n      internalTags,\n      country,\n      timezone,\n      scheduledAt:\n        publishTiming === \'scheduled\'\n          ? `${scheduledDate}T${scheduledTime}:00Z`\n          : undefined,\n      platforms: selectedPlatforms.map(p => ({\n        platform: p,\n        captionOverride: platformOverrides[p] || undefined,\n        publishingStatus: \'pending\',\n      })),\n      media: mediaUrl\n        ? [\n            {\n              mediaType: \'image\',\n              fileUrl: mediaUrl,\n              originalFileName: \'campaign_image.jpg\',\n              mimeType: \'image/jpeg\',\n              fileSizeBytes: 2100000,\n              altText,\n            },\n          ]\n        : [],\n      assignedApproverId,\n      submitForApproval,\n    };\n\n    onSavePost(postData);\n  };\n\n  const STEPS = [\n    { number: 1, label: \'Brand & Campaign\' },\n    { number: 2, label: \'Platforms\' },\n    { number: 3, label: \'Media Assets\' },\n    { number: 4, label: \'Captions & Preview\' },\n    { number: 5, label: \'Schedule\' },\n    { number: 6, label: \'Approval\' },\n  ];\n\n  return (\n    <div className=\"p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto space-y-8\">\n      {/* Step Indicator Header */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h2 className=\"text-xl font-bold text-[#101828]\">Multi-Step Post Composer</h2>\n            <p className=\"text-xs text-[#667085] mt-0.5\">\n              Draft, customize per platform, and route for automated n8n publishing\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2 text-xs font-mono text-[#12B76A]\">\n            <CheckCircle2 className=\"w-4 h-4\" />\n            <span>Autosaved</span>\n          </div>\n        </div>\n\n        {/* Steps Progress Strip */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-6 gap-2 pt-2 border-t border-[#EAECF0]\">\n          {STEPS.map(s => {\n            const isCurrent = currentStep === s.number;\n            const isCompleted = currentStep > s.number;\n            return (\n              <button\n                key={s.number}\n                type=\"button\"\n                onClick={() => setCurrentStep(s.number)}\n                className={`p-2 rounded-xl text-left border transition-all ${\n                  isCurrent\n                    ? \'border-[#1336E8] bg-[#EFF8FF]\'\n                    : isCompleted\n                    ? \'border-[#EAECF0] bg-white text-[#101828]\'\n                    : \'border-transparent text-[#98A2B3]\'\n                }`}\n              >\n                <div className=\"text-[10px] font-mono uppercase font-bold text-[#1336E8]\">\n                  Step {s.number}\n                </div>\n                <div className=\"text-xs font-semibold truncate\">{s.label}</div>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Step Body */}\n      <div className=\"bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm space-y-6\">\n        {/* STEP 1: BRAND & CAMPAIGN */}\n        {currentStep === 1 && (\n          <div className=\"space-y-4\">\n            <h3 className=\"text-base font-bold text-[#101828]\">Step 1: Brand &amp; Campaign Metadata</h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-[#344054]\">Target Brand</label>\n                <select\n                  value={brandId}\n                  onChange={e => setBrandId(Number(e.target.value))}\n                  className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                >\n                  {brands.map(b => (\n                    <option key={b.id} value={b.id}>\n                      {b.name}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-[#344054]\">Post Title (Internal)</label>\n                <input\n                  type=\"text\"\n                  value={title}\n                  onChange={e => setTitle(e.target.value)}\n                  placeholder=\"e.g. Q4 Kubernetes Failover Release\"\n                  className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-[#344054]\">Campaign Name</label>\n                <input\n                  type=\"text\"\n                  value={campaignName}\n                  onChange={e => setCampaignName(e.target.value)}\n                  className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-[#344054]\">Internal Tags (comma-separated)</label>\n                <input\n                  type=\"text\"\n                  value={internalTags}\n                  onChange={e => setInternalTags(e.target.value)}\n                  className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                />\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* STEP 2: PLATFORMS */}\n        {currentStep === 2 && (\n          <div className=\"space-y-4\">\n            <h3 className=\"text-base font-bold text-[#101828]\">Step 2: Select Social Distribution Channels</h3>\n            <p className=\"text-xs text-[#667085]\">\n              Select which channels will receive this post. You can customize platform-specific captions in step 4.\n            </p>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2\">\n              {(\n                [\n                  { id: \'linkedin\', name: \'LinkedIn Company\', desc: \'B2B Professional\' },\n                  { id: \'x\', name: \'X (Twitter)\', desc: \'Short-form & Threads\' },\n                  { id: \'facebook\', name: \'Facebook Page\', desc: \'Community & Groups\' },\n                  { id: \'instagram\', name: \'Instagram Feed\', desc: \'Visual & Reels\' },\n                ] as const\n              ).map(plat => {\n                const isSelected = selectedPlatforms.includes(plat.id);\n                return (\n                  <button\n                    key={plat.id}\n                    type=\"button\"\n                    onClick={() => togglePlatform(plat.id)}\n                    className={`p-4 rounded-xl border text-left transition-all ${\n                      isSelected\n                        ? \'border-[#1336E8] bg-[#EFF8FF] ring-2 ring-[#1336E8]/20\'\n                        : \'border-[#EAECF0] bg-[#F6F8FC] hover:bg-white text-[#667085]\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <span className=\"w-8 h-8 rounded-lg bg-white border border-[#D0D5DD] flex items-center justify-center font-bold text-xs uppercase text-[#1336E8]\">\n                        {plat.id.substring(0, 2)}\n                      </span>\n                      {isSelected && <Check className=\"w-4 h-4 text-[#1336E8]\" />}\n                    </div>\n                    <div className=\"font-bold text-xs text-[#101828]\">{plat.name}</div>\n                    <div className=\"text-[11px] text-[#667085] mt-0.5\">{plat.desc}</div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        )}\n\n        {/* STEP 3: MEDIA */}\n        {currentStep === 3 && (\n          <div className=\"space-y-4\">\n            <h3 className=\"text-base font-bold text-[#101828]\">Step 3: Media &amp; Asset Validation</h3>\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              <div className=\"space-y-4\">\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">Media Image URL</label>\n                  <input\n                    type=\"text\"\n                    value={mediaUrl}\n                    onChange={e => setMediaUrl(e.target.value)}\n                    placeholder=\"https://...\"\n                    className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                  />\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">Or Import Google Drive Public Link</label>\n                  <div className=\"flex items-center gap-2\">\n                    <input\n                      type=\"text\"\n                      value={googleDriveUrl}\n                      onChange={e => setGoogleDriveUrl(e.target.value)}\n                      placeholder=\"https://drive.google.com/file/d/...\"\n                      className=\"flex-1 h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        if (googleDriveUrl) setMediaUrl(googleDriveUrl);\n                      }}\n                      className=\"px-3 h-10 bg-white border border-[#D0D5DD] text-xs font-medium rounded-xl hover:bg-[#F2F4F7]\"\n                    >\n                      Fetch\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">Accessibility Alt Text</label>\n                  <input\n                    type=\"text\"\n                    value={altText}\n                    onChange={e => setAltText(e.target.value)}\n                    className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                  />\n                </div>\n\n                <div className=\"p-3.5 bg-[#EFF8FF] rounded-xl border border-[#B2DDFF] text-xs text-[#1336E8] space-y-1\">\n                  <div className=\"font-bold flex items-center gap-1.5\">\n                    <FileCheck className=\"w-4 h-4\" />\n                    <span>Media Aspect Ratio Check</span>\n                  </div>\n                  <p className=\"text-[11px] text-[#475467]\">\n                    16:9 Landscape (1200x630) verified. Optimized for LinkedIn, X cards, and Facebook Feed.\n                  </p>\n                </div>\n              </div>\n\n              {/* Preview Box */}\n              <div className=\"space-y-2\">\n                <span className=\"text-xs font-semibold text-[#344054]\">Media Preview</span>\n                <div className=\"h-64 rounded-xl border border-[#D0D5DD] bg-[#F2F4F7] overflow-hidden flex items-center justify-center relative\">\n                  {mediaUrl ? (\n                    <img src={mediaUrl} alt={altText} className=\"w-full h-full object-cover\" />\n                  ) : (\n                    <div className=\"text-center text-xs text-[#98A2B3] space-y-1\">\n                      <ImageIcon className=\"w-8 h-8 mx-auto\" />\n                      <span>No media asset linked</span>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* STEP 4: CAPTIONS & PREVIEW */}\n        {currentStep === 4 && (\n          <div className=\"space-y-6\">\n            <h3 className=\"text-base font-bold text-[#101828]\">Step 4: Master Caption &amp; Channel Overrides</h3>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              {/* Left Column: Form Fields */}\n              <div className=\"lg:col-span-7 space-y-4\">\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex items-center justify-between\">\n                    <label className=\"text-xs font-semibold text-[#344054]\">Master Caption</label>\n                    <span className=\"text-[11px] font-mono text-[#667085]\">\n                      {masterCaption.length} characters\n                    </span>\n                  </div>\n                  <textarea\n                    rows={4}\n                    value={masterCaption}\n                    onChange={e => setMasterCaption(e.target.value)}\n                    className=\"w-full p-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8] leading-relaxed\"\n                  />\n                </div>\n\n                {/* X Override */}\n                {selectedPlatforms.includes(\'x\') && (\n                  <div className=\"space-y-1.5\">\n                    <div className=\"flex items-center justify-between\">\n                      <label className=\"text-xs font-semibold text-[#344054]\">X (Twitter) Override</label>\n                      <span className=\"text-[11px] font-mono text-[#667085]\">\n                        {(platformOverrides[\'x\'] || \'\').length}/280\n                      </span>\n                    </div>\n                    <textarea\n                      rows={2}\n                      value={platformOverrides[\'x\'] || \'\'}\n                      onChange={e =>\n                        setPlatformOverrides({ ...platformOverrides, x: e.target.value })\n                      }\n                      className=\"w-full p-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                    />\n                  </div>\n                )}\n\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div className=\"space-y-1.5\">\n                    <label className=\"text-xs font-semibold text-[#344054]\">Hashtags</label>\n                    <input\n                      type=\"text\"\n                      value={hashtags}\n                      onChange={e => setHashtags(e.target.value)}\n                      className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                    />\n                  </div>\n                  <div className=\"space-y-1.5\">\n                    <label className=\"text-xs font-semibold text-[#344054]\">Target Link</label>\n                    <input\n                      type=\"text\"\n                      value={targetUrl}\n                      onChange={e => setTargetUrl(e.target.value)}\n                      className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">First Comment (Auto-post)</label>\n                  <input\n                    type=\"text\"\n                    value={firstComment}\n                    onChange={e => setFirstComment(e.target.value)}\n                    className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                  />\n                </div>\n              </div>\n\n              {/* Right Column: Simulated Social Card Preview */}\n              <div className=\"lg:col-span-5 space-y-2\">\n                <span className=\"text-xs font-semibold text-[#344054]\">Live Platform Card Preview</span>\n                <div className=\"bg-[#F8F9FA] p-4 rounded-xl border border-[#D0D5DD] space-y-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"w-8 h-8 rounded-full bg-[#1336E8] text-white flex items-center justify-center font-bold text-xs\">\n                      NX\n                    </div>\n                    <div>\n                      <div className=\"text-xs font-bold text-[#101828]\">Nexus Enterprise Cloud</div>\n                      <div className=\"text-[10px] text-[#667085]\">Sponsored \302\267 Just now</div>\n                    </div>\n                  </div>\n\n                  <p className=\"text-xs text-[#101828] leading-relaxed\">\n                    {platformOverrides[\'x\'] || masterCaption}\n                  </p>\n\n                  <div className=\"text-xs text-[#1336E8] font-medium\">{hashtags}</div>\n\n                  {mediaUrl && (\n                    <div className=\"rounded-lg overflow-hidden border border-[#EAECF0] max-h-40\">\n                      <img src={mediaUrl} alt=\"\" className=\"w-full h-full object-cover\" />\n                    </div>\n                  )}\n\n                  <div className=\"pt-2 border-t border-[#EAECF0] flex items-center justify-between text-[11px] text-[#667085]\">\n                    <span>\360\237\221\215 42 Likes</span>\n                    <span>12 Comments \302\267 8 Reposts</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* STEP 5: SCHEDULE */}\n        {currentStep === 5 && (\n          <div className=\"space-y-4\">\n            <h3 className=\"text-base font-bold text-[#101828]\">Step 5: Publishing Schedule &amp; Timezone</h3>\n\n            <div className=\"grid grid-cols-2 gap-3 max-w-md\">\n              <button\n                type=\"button\"\n                onClick={() => setPublishTiming(\'scheduled\')}\n                className={`p-3.5 rounded-xl border text-left transition-all ${\n                  publishTiming === \'scheduled\'\n                    ? \'border-[#1336E8] bg-[#EFF8FF]\'\n                    : \'border-[#EAECF0] bg-[#F6F8FC]\'\n                }`}\n              >\n                <div className=\"font-bold text-xs text-[#101828]\">Schedule for Later</div>\n                <div className=\"text-[11px] text-[#667085] mt-0.5\">Automated release via n8n cron</div>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setPublishTiming(\'now\')}\n                className={`p-3.5 rounded-xl border text-left transition-all ${\n                  publishTiming === \'now\'\n                    ? \'border-[#1336E8] bg-[#EFF8FF]\'\n                    : \'border-[#EAECF0] bg-[#F6F8FC]\'\n                }`}\n              >\n                <div className=\"font-bold text-xs text-[#101828]\">Publish Immediately</div>\n                <div className=\"text-[11px] text-[#667085] mt-0.5\">Trigger webhook upon approval</div>\n              </button>\n            </div>\n\n            {publishTiming === \'scheduled\' && (\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2\">\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">Release Date</label>\n                  <input\n                    type=\"date\"\n                    value={scheduledDate}\n                    onChange={e => setScheduledDate(e.target.value)}\n                    className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                  />\n                </div>\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">Release Time</label>\n                  <input\n                    type=\"time\"\n                    value={scheduledTime}\n                    onChange={e => setScheduledTime(e.target.value)}\n                    className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                  />\n                </div>\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-semibold text-[#344054]\">Timezone</label>\n                  <input\n                    type=\"text\"\n                    value={timezone}\n                    onChange={e => setTimezone(e.target.value)}\n                    className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                  />\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* STEP 6: APPROVAL */}\n        {currentStep === 6 && (\n          <div className=\"space-y-4\">\n            <h3 className=\"text-base font-bold text-[#101828]\">Step 6: Reviewer Assignment &amp; Notes</h3>\n\n            <div className=\"space-y-4 max-w-xl\">\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-[#344054]\">Assign Approver</label>\n                <select\n                  value={assignedApproverId}\n                  onChange={e => setAssignedApproverId(Number(e.target.value))}\n                  className=\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                >\n                  <option value={3}>Marcus Sterling (Senior VP Approver)</option>\n                  <option value={4}>Sophia Al-Mansoor (Brand Director)</option>\n                </select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-semibold text-[#344054]\">Internal Submission Note</label>\n                <textarea\n                  rows={3}\n                  value={internalNote}\n                  onChange={e => setInternalNote(e.target.value)}\n                  placeholder=\"Notes for the reviewer...\"\n                  className=\"w-full p-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\"\n                />\n              </div>\n\n              <div className=\"p-4 bg-[#F9FAFB] rounded-xl border border-[#EAECF0] text-xs space-y-1 text-[#475467]\">\n                <div className=\"font-bold text-[#101828]\">Approval Routing Policy:</div>\n                <p>\n                  Upon submission, an expiring token is signed and the assigned reviewer is notified via email and in-app alert. The content is locked from editing while In Review.\n                </p>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Footer Navigation Buttons */}\n        <div className=\"flex items-center justify-between border-t border-[#EAECF0] pt-4\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              if (currentStep > 1) setCurrentStep(currentStep - 1);\n              else onCancel();\n            }}\n            className=\"px-4 py-2 border border-[#D0D5DD] text-xs font-semibold text-[#344054] rounded-xl hover:bg-[#F2F4F7] transition-colors\"\n          >\n            {currentStep === 1 ? \'Cancel\' : \'Back\'}\n          </button>\n\n          <div className=\"flex items-center gap-2\">\n            {currentStep < 6 ? (\n              <button\n                type=\"button\"\n                onClick={() => setCurrentStep(currentStep + 1)}\n                className=\"px-5 py-2.5 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-md shadow-[#1336E8]/20 transition-all flex items-center gap-1.5\"\n              >\n                <span>Continue</span>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            ) : (\n              <>\n                <button\n                  type=\"button\"\n                  onClick={() => handleFinish(false)}\n                  disabled={isSubmitting}\n                  className=\"px-4 py-2.5 bg-white border border-[#D0D5DD] hover:bg-[#F2F4F7] text-xs font-semibold text-[#344054] rounded-xl transition-colors\"\n                >\n                  Save as Draft\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => handleFinish(true)}\n                  disabled={isSubmitting}\n                  className=\"px-5 py-2.5 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-md shadow-[#1336E8]/20 transition-all flex items-center gap-1.5\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                  <span>Submit for Approval</span>\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
