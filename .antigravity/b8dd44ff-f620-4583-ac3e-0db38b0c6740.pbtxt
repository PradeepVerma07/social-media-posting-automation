      id: "call_538214"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Workflow } from \'../types/workflow\';\\n\\nexport const WORKFLOW_TEMPLATES: Workflow[] = [\\n  {\\n    id: \'tpl-webhook-slack\',\\n    name: \'Webhook Event to Slack Alert\',\\n    active: true,\\n    updatedAt: new Date().toISOString(),\\n    nodes: [\\n      {\\n        id: \'node-1\',\\n        name: \'Webhook Event\',\\n        type: \'webhook\',\\n        position: [80, 220],\\n        parameters: {\\n          path: \'/webhook/customer-events\',\\n          httpMethod: \'POST\',\\n          testPayload: JSON.stringify(\\n            {\\n              event: \'customer.signup\',\\n              company: \'Acme Global Corp\',\\n              contact: \'alex@acme.com\',\\n              plan: \'Enterprise Tier\',\\n              seats: 45,\\n              annualValue: 24000,\\n            },\\n            null,\\n            2\\n          ),\\n        },\\n      },\\n      {\\n        id: \'node-2\',\\n        name: \'Transform & Score\',\\n        type: \'code\',\\n        position: [380, 220],\\n        parameters: {\\n          code: `const items = $input.all();\\nreturn items.map(item => {\\n  const data = item.json || item;\\n  const isHighValue = (data.annualValue || 0) >= 10000;\\n  return {\\n    json: {\\n      ...data,\\n      isHighValue,\\n      urgencyLevel: isHighValue ? \'IMMEDIATE\' : \'STANDARD\',\\n      formattedValue: \'$\' + (data.annualValue || 0).toLocaleString(),\\n      routedAt: new Date().toISOString()\\n    }\\n  };\\n});`,\\n        },\\n      },\\n      {\\n        id: \'node-3\',\\n        name: \'High Value Check\',\\n        type: \'if\',\\n        position: [680, 220],\\n        parameters: {\\n          field: \'isHighValue\',\\n          operator: \'equals\',\\n          value: \'true\',\\n        },\\n      },\\n      {\\n        id: \'node-4\',\\n        name: \'Slack Executive Alert\',\\n        type: \'slackWebhook\',\\n        position: [980, 140],\\n        parameters: {\\n          webhookUrl: \'https://hooks.slack.com/services/T00/B00/X00EXAMPLE\',\\n          channel: \'#enterprise-wins\',\\n          messageTemplate: \'\360\237\216\211 *New Enterprise Lead!* Company: {{company}} ({{formattedValue}}) - Contact: {{contact}}\',\\n        },\\n      },\\n      {\\n        id: \'node-5\',\\n        name: \'Standard Email Dispatch\',\\n        type: \'email\',\\n        position: [980, 320],\\n        parameters: {\\n          toEmail: \'sales-queue@company.internal\',\\n          subject: \'New Lead: {{company}}\',\\n          bodyTemplate: \'Customer {{contact}} signed up for {{plan}} with {{seats}} seats.\',\\n        },\\n      },\\n    ],\\n    connections: [\\n      {\\n        id: \'conn-1\',\\n        fromNodeId: \'node-1\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-2\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-2\',\\n        fromNodeId: \'node-2\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-3\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-3\',\\n        fromNodeId: \'node-3\',\\n        fromOutputIndex: 0, // true branch\\n        toNodeId: \'node-4\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-4\',\\n        fromNodeId: \'node-3\',\\n        fromOutputIndex: 1, // false branch\\n        toNodeId: \'node-5\',\\n        toInputIndex: 0,\\n      },\\n    ],\\n  },\\n  {\\n    id: \'tpl-api-monitor\',\\n    name: \'Scheduled API Health Monitor\',\\n    active: true,\\n    updatedAt: new Date().toISOString(),\\n    nodes: [\\n      {\\n        id: \'node-mon-1\',\\n        name: \'Run Every 5 Min\',\\n        type: \'schedule\',\\n        position: [100, 220],\\n        parameters: {\\n          rule: \'interval\',\\n          intervalHours: 0.08,\\n          cronExpression: \'*/5 * * * *\',\\n          timezone: \'UTC\',\\n        },\\n      },\\n      {\\n        id: \'node-mon-2\',\\n        name: \'Ping API Status\',\\n        type: \'httpRequest\',\\n        position: [400, 220],\\n        parameters: {\\n          method: \'GET\',\\n          url: \'https://jsonplaceholder.typicode.com/posts/1\',\\n          sendHeaders: true,\\n          headers: JSON.stringify({ Accept: \'application/json\' }, null, 2),\\n        },\\n      },\\n      {\\n        id: \'node-mon-3\',\\n        name: \'Verify Payload\',\\n        type: \'code\',\\n        position: [700, 220],\\n        parameters: {\\n          code: `const items = $input.all();\\nreturn items.map(item => {\\n  const json = item.json || item;\\n  const isHealthy = json.id === 1 && json.title;\\n  return {\\n    json: {\\n      healthStatus: isHealthy ? \'HEALTHY\' : \'DEGRADED\',\\n      checkedAt: new Date().toISOString(),\\n      service: \'Customer Microservice\',\\n      responseTitle: json.title\\n    }\\n  };\\n});`,\\n        },\\n      },\\n      {\\n        id: \'node-mon-4\',\\n        name: \'Post Status Digest\',\\n        type: \'slackWebhook\',\\n        position: [1000, 220],\\n        parameters: {\\n          webhookUrl: \'https://hooks.slack.com/services/HEALTH/MONITOR/HOOK\',\\n          channel: \'#status-ops\',\\n          messageTemplate: \'\342\234\205 *System Health Ping*: {{service}} is {{healthStatus}} at {{checkedAt}}\',\\n        },\\n      },\\n    ],\\n    connections: [\\n      {\\n        id: \'conn-mon-1\',\\n        fromNodeId: \'node-mon-1\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-mon-2\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-mon-2\',\\n        fromNodeId: \'node-mon-2\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-mon-3\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-mon-3\',\\n        fromNodeId: \'node-mon-3\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-mon-4\',\\n        toInputIndex: 0,\\n      },\\n    ],\\n  },\\n  {\\n    id: \'tpl-data-etl\',\\n    name: \'REST Data Extraction & Field Normalizer\',\\n    active: false,\\n    updatedAt: new Date().toISOString(),\\n    nodes: [\\n      {\\n        id: \'node-etl-1\',\\n        name: \'Manual Trigger\',\\n        type: \'manual\',\\n        position: [100, 220],\\n        parameters: {\\n          sampleData: JSON.stringify(\\n            {\\n              batchId: \'BATCH_2026_Q4\',\\n              requestedBy: \'Data Team\',\\n              environment: \'Staging\',\\n            },\\n            null,\\n            2\\n          ),\\n        },\\n      },\\n      {\\n        id: \'node-etl-2\',\\n        name: \'Fetch Raw Users\',\\n        type: \'httpRequest\',\\n        position: [390, 220],\\n        parameters: {\\n          method: \'GET\',\\n          url: \'https://jsonplaceholder.typicode.com/users/1\',\\n          sendHeaders: true,\\n          headers: JSON.stringify({ Accept: \'application/json\' }, null, 2),\\n        },\\n      },\\n      {\\n        id: \'node-etl-3\',\\n        name: \'Set Metadata Fields\',\\n        type: \'editFields\',\\n        position: [690, 220],\\n        parameters: {\\n          fields: [\\n            { key: \'etl_version\', value: \'2.4.0\', type: \'string\' },\\n            { key: \'source_pipeline\', value: \'crm_sync\', type: \'string\' },\\n            { key: \'verified\', value: \'true\', type: \'string\' },\\n          ],\\n        },\\n      },\\n      {\\n        id: \'node-etl-4\',\\n        name: \'Format Output\',\\n        type: \'code\',\\n        position: [980, 220],\\n        parameters: {\\n          code: `const items = $input.all();\\nreturn items.map(item => {\\n  const data = item.json || item;\\n  return {\\n    json: {\\n      userId: data.id,\\n      fullName: data.name,\\n      contactEmail: data.email,\\n      companyName: data.company?.name || \'N/A\',\\n      location: data.address?.city || \'Unknown\',\\n      extractedAt: new Date().toISOString(),\\n      status: \'SYNCHRONIZED\'\\n    }\\n  };\\n});`,\\n        },\\n      },\\n    ],\\n    connections: [\\n      {\\n        id: \'conn-etl-1\',\\n        fromNodeId: \'node-etl-1\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-etl-2\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-etl-2\',\\n        fromNodeId: \'node-etl-2\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-etl-3\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-etl-3\',\\n        fromNodeId: \'node-etl-3\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-etl-4\',\\n        toInputIndex: 0,\\n      },\\n    ],\\n  },\\n];\\n\", \"Description\":\"Provide rich n8n workflow templates for instant testing and exploration\", \"Overwrite\":true, \"TargetFile\":\"/src/data/templates.ts\", \"toolAction\":\"Creating workflow templates\", \"toolSummary\":\"Create workflow templates\"}"
      thinking_signature: "\022\342\001\n\337\001\001i\024}\023^%\350-\212\341^\2705\222C\230\256\256\323\027\242\324\0316v\341S\\P\241,\256\345P\213\310=\242\257!\255\351\350\0012\352\250\316\207]L\311Q\347\361\354\247\024\225 G\253\242`\206\317!2\005#\003\325z\214\351z\274<i;\215[5\205o\345A\341)\222\232\205h\244\346\261g\346\270\033\n\221+\371\271\373C\250\261\021cwV\216\021\f(p\367\273V\373a\302\264\005\206\314\3424\305\376j\336~\235-\r\333\365U\221D\277\206\016\363\344\356\t\346(\371\355r\310A\376\016U\022~\206\277\350\230\266\247N\021\254\374\206i\3475\\1\331\365\210\255\205\374KyQrJ>4\260Ey*\212\255v\372*\241\375<\225\023S#\344\'\004B\233\301\314\f9S0X\374\370j"
