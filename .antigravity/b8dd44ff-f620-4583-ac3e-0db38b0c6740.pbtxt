        use_fast_apply: true
        replacement_chunks {
          target_content: "      {/* Central Content Table */}\n      <div className=\"bg-white border border-[#EAECF0] rounded-2xl shadow-sm overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-[#F9FAFB] border-b border-[#EAECF0] text-[#475467] font-semibold\">\n              <tr>\n                <th className=\"py-3 px-4 w-10\">\n                  <input\n                    type=\"checkbox\"\n                    checked={\n                      filteredPosts.length > 0 &&\n                      selectedPostIds.length === filteredPosts.length\n                    }\n                    onChange={e => handleSelectAll(e.target.checked)}\n                    className=\"rounded border-[#D0D5DD] text-[#1336E8] focus:ring-0\"\n                  />\n                </th>\n                <th className=\"py-3 px-4 min-w-[240px]\">Post Title &amp; Media</th>\n                <th className=\"py-3 px-4\">Brand</th>\n                <th className=\"py-3 px-4\">Platforms</th>\n                <th className=\"py-3 px-4\">Scheduled Date</th>\n                <th className=\"py-3 px-4\">Approval</th>\n                <th className=\"py-3 px-4\">Publishing</th>\n                <th className=\"py-3 px-4\">Approver</th>\n                <th className=\"py-3 px-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#EAECF0]\">\n              {filteredPosts.map(post => {\n                const isSelected = selectedPostIds.includes(post.id);\n                const mediaUrl = post.media?.[0]?.fileUrl;\n\n                return (\n                  <tr\n                    key={post.id}\n                    className={`hover:bg-[#F9FAFB] transition-colors ${\n                      isSelected ? \'bg-[#F9FBFF]\' : \'\'\n                    }`}\n                  >\n                    <td className=\"py-3.5 px-4\">\n                      <input\n                        type=\"checkbox\"\n                        checked={isSelected}\n                        onChange={() => handleToggleSelect(post.id)}\n                        className=\"rounded border-[#D0D5DD] text-[#1336E8] focus:ring-0\"\n                      />\n                    </td>\n\n                    {/* Title & Media */}\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-3\">\n                        {mediaUrl ? (\n                          <img\n                            src={mediaUrl}\n                            alt=\"\"\n                            className=\"w-10 h-10 rounded-lg object-cover border border-[#EAECF0] shrink-0\"\n                          />\n                        ) : (\n                          <div className=\"w-10 h-10 rounded-lg bg-[#F2F4F7] flex items-center justify-center text-[#98A2B3] text-xs font-mono shrink-0\">\n                            TXT\n                          </div>\n                        )}\n                        <div className=\"min-w-0\">\n                          <button\n                            onClick={() => onSelectPost(post)}\n                            className=\"font-bold text-[#101828] hover:text-[#1336E8] text-left truncate block max-w-xs transition-colors\"\n                          >\n                            {post.title}\n                          </button>\n                          <p className=\"text-[11px] text-[#667085] truncate max-w-xs\">\n                            {post.masterCaption}\n                          </p>\n                        </div>\n                      </div>\n                    </td>\n\n                    {/* Brand */}\n                    <td className=\"py-3.5 px-4\">\n                      <span className=\"font-semibold text-[#101828]\">{post.brandName}</span>\n                    </td>\n\n                    {/* Platforms */}\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-1\">\n                        {post.platforms.map(p => (\n                          <span\n                            key={p.platform}\n                            className=\"px-1.5 py-0.5 rounded bg-[#F2F4F7] text-[10px] font-mono text-[#344054] uppercase font-bold\"\n                          >\n                            {p.platform[0]}\n                          </span>\n                        ))}\n                      </div>\n                    </td>\n\n                    {/* Scheduled Date */}\n                    <td className=\"py-3.5 px-4 font-mono text-[11px] text-[#475467]\">\n                      {post.scheduledAt ? (\n                        <span>{new Date(post.scheduledAt).toLocaleDateString([], { month: \'short\', day: \'numeric\', hour: \'2-digit\', minute: \'2-digit\' })}</span>\n                      ) : (\n                        <span className=\"text-[#98A2B3]\">\342\200\224</span>\n                      )}\n                    </td>\n\n                    {/* Approval Status */}\n                    <td className=\"py-3.5 px-4\">{getApprovalBadge(post.approvalStatus)}</td>\n\n                    {/* Publishing Status */}\n                    <td className=\"py-3.5 px-4\">{getPublishingBadge(post.publishingStatus)}</td>\n\n                    {/* Approver */}\n                    <td className=\"py-3.5 px-4 text-[#475467]\">\n                      {post.assignedApproverName || \'Marcus Sterling\'}\n                    </td>\n\n                    {/* Actions Menu */}\n                    <td className=\"py-3.5 px-4 text-right\">\n                      <div className=\"flex items-center justify-end gap-1.5\">\n                        <button\n                          onClick={() => onSelectPost(post)}\n                          className=\"p-1.5 rounded-lg text-[#667085] hover:text-[#1336E8] hover:bg-[#EFF8FF] transition-colors\"\n                          title=\"View Details & Comments\"\n                        >\n                          <Eye className=\"w-4 h-4\" />\n                        </button>\n\n                        {post.approvalStatus === \'in_review\' && (\n                          <button\n                            onClick={() => onApprovePost(post.id)}\n                            className=\"p-1.5 rounded-lg text-[#12B76A] hover:bg-[#ECFDF3] transition-colors\"\n                            title=\"Approve Post\"\n                          >\n                            <CheckCircle2 className=\"w-4 h-4\" />\n                          </button>\n                        )}\n\n                        {post.approvalStatus === \'approved\' && post.publishingStatus !== \'published\' && (\n                          <button\n                            onClick={() => onPublishNow(post.id)}\n                            className=\"p-1.5 rounded-lg text-[#1336E8] hover:bg-[#EFF8FF] transition-colors\"\n                            title=\"Publish to n8n Webhook Now\"\n                          >\n                            <Play className=\"w-4 h-4 fill-current\" />\n                          </button>\n                        )}\n\n                        <button\n                          onClick={() => onDeletePost(post.id)}\n                          className=\"p-1.5 rounded-lg text-[#667085] hover:text-[#F04438] hover:bg-[#FEF3F2] transition-colors\"\n                          title=\"Delete Post\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n          {filteredPosts.length === 0 && (\n            <div className=\"p-12 text-center text-xs text-[#667085]\">\n              No posts match your filters. Click \"+ Create Post\" to draft a new post!\n            </div>\n          )}\n        </div>\n      </div>"
          replacement_content: "      {/* Central Content Table (Desktop View) */}\n      <div className=\"hidden md:block bg-white border border-[#EAECF0] rounded-2xl shadow-sm overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-[#F9FAFB] border-b border-[#EAECF0] text-[#475467] font-semibold\">\n              <tr>\n                <th className=\"py-3 px-4 w-10\">\n                  <input\n                    type=\"checkbox\"\n                    checked={\n                      filteredPosts.length > 0 &&\n                      selectedPostIds.length === filteredPosts.length\n                    }\n                    onChange={e => handleSelectAll(e.target.checked)}\n                    className=\"rounded border-[#D0D5DD] text-[#1336E8] focus:ring-0\"\n                  />\n                </th>\n                <th className=\"py-3 px-4 min-w-[240px]\">Post Title &amp; Media</th>\n                <th className=\"py-3 px-4\">Brand</th>\n                <th className=\"py-3 px-4\">Platforms</th>\n                <th className=\"py-3 px-4\">Scheduled Date</th>\n                <th className=\"py-3 px-4\">Approval</th>\n                <th className=\"py-3 px-4\">Publishing</th>\n                <th className=\"py-3 px-4\">Approver</th>\n                <th className=\"py-3 px-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#EAECF0]\">\n              {filteredPosts.map(post => {\n                const isSelected = selectedPostIds.includes(post.id);\n                const mediaUrl = post.media?.[0]?.fileUrl;\n\n                return (\n                  <tr\n                    key={post.id}\n                    className={`hover:bg-[#F9FAFB] transition-colors ${\n                      isSelected ? \'bg-[#F9FBFF]\' : \'\'\n                    }`}\n                  >\n                    <td className=\"py-3.5 px-4\">\n                      <input\n                        type=\"checkbox\"\n                        checked={isSelected}\n                        onChange={() => handleToggleSelect(post.id)}\n                        className=\"rounded border-[#D0D5DD] text-[#1336E8] focus:ring-0\"\n                      />\n                    </td>\n\n                    {/* Title & Media */}\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-3\">\n                        {mediaUrl ? (\n                          <img\n                            src={mediaUrl}\n                            alt=\"\"\n                            className=\"w-10 h-10 rounded-lg object-cover border border-[#EAECF0] shrink-0\"\n                          />\n                        ) : (\n                          <div className=\"w-10 h-10 rounded-lg bg-[#F2F4F7] flex items-center justify-center text-[#98A2B3] text-xs font-mono shrink-0\">\n                            TXT\n                          </div>\n                        )}\n                        <div className=\"min-w-0\">\n                          <button\n                            onClick={() => onSelectPost(post)}\n                            className=\"font-bold text-[#101828] hover:text-[#1336E8] text-left truncate block max-w-xs transition-colors\"\n                          >\n                            {post.title}\n                          </button>\n                          <p className=\"text-[11px] text-[#667085] truncate max-w-xs\">\n                            {post.masterCaption}\n                          </p>\n                        </div>\n                      </div>\n                    </td>\n\n                    {/* Brand */}\n                    <td className=\"py-3.5 px-4\">\n                      <span className=\"font-semibold text-[#101828]\">{post.brandName}</span>\n                    </td>\n\n                    {/* Platforms */}\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-1\">\n                        {post.platforms.map(p => (\n                          <span\n                            key={p.platform}\n                            className=\"px-1.5 py-0.5 rounded bg-[#F2F4F7] text-[10px] font-mono text-[#344054] uppercase font-bold\"\n                          >\n                            {p.platform[0]}\n                          </span>\n                        ))}\n                      </div>\n                    </td>\n\n                    {/* Scheduled Date */}\n                    <td className=\"py-3.5 px-4 font-mono text-[11px] text-[#475467]\">\n                      {post.scheduledAt ? (\n                        <span>{new Date(post.scheduledAt).toLocaleDateString([], { month: \'short\', day: \'numeric\', hour: \'2-digit\', minute: \'2-digit\' })}</span>\n                      ) : (\n                        <span className=\"text-[#98A2B3]\">\342\200\224</span>\n                      )}\n                    </td>\n\n                    {/* Approval Status */}\n                    <td className=\"py-3.5 px-4\">{getApprovalBadge(post.approvalStatus)}</td>\n\n                    {/* Publishing Status */}\n                    <td className=\"py-3.5 px-4\">{getPublishingBadge(post.publishingStatus)}</td>\n\n                    {/* Approver */}\n                    <td className=\"py-3.5 px-4 text-[#475467]\">\n                      {post.assignedApproverName || \'Marcus Sterling\'}\n                    </td>\n\n                    {/* Actions Menu */}\n                    <td className=\"py-3.5 px-4 text-right\">\n                      <div className=\"flex items-center justify-end gap-1.5\">\n                        <button\n                          onClick={() => onSelectPost(post)}\n                          className=\"p-1.5 rounded-lg text-[#667085] hover:text-[#1336E8] hover:bg-[#EFF8FF] transition-colors\"\n                          title=\"View Details & Comments\"\n                        >\n                          <Eye className=\"w-4 h-4\" />\n                        </button>\n\n                        {post.approvalStatus === \'in_review\' && (\n                          <button\n                            onClick={() => onApprovePost(post.id)}\n                            className=\"p-1.5 rounded-lg text-[#12B76A] hover:bg-[#ECFDF3] transition-colors\"\n                            title=\"Approve Post\"\n                          >\n                            <CheckCircle2 className=\"w-4 h-4\" />\n                          </button>\n                        )}\n\n                        {post.approvalStatus === \'approved\' && post.publishingStatus !== \'published\' && (\n                          <button\n                            onClick={() => onPublishNow(post.id)}\n                            className=\"p-1.5 rounded-lg text-[#1336E8] hover:bg-[#EFF8FF] transition-colors\"\n                            title=\"Publish to n8n Webhook Now\"\n                          >\n                            <Play className=\"w-4 h-4 fill-current\" />\n                          </button>\n                        )}\n\n                        <button\n                          onClick={() => onDeletePost(post.id)}\n                          className=\"p-1.5 rounded-lg text-[#667085] hover:text-[#F04438] hover:bg-[#FEF3F2] transition-colors\"\n                          title=\"Delete Post\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n          {filteredPosts.length === 0 && (\n            <div className=\"p-12 text-center text-xs text-[#667085]\">\n              No posts match your filters. Click \"+ Create Post\" to draft a new post!\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Mobile Card Feed (Small Screens) */}\n      <div className=\"md:hidden space-y-3\">\n        {filteredPosts.length === 0 ? (\n          <div className=\"bg-white p-6 rounded-2xl border border-[#EAECF0] text-center text-xs text-[#667085]\">\n            No posts match your filters. Click \"+ Create Post\" to draft a new post!\n          </div>\n        ) : (\n          filteredPosts.map(post => {\n            const mediaUrl = post.media?.[0]?.fileUrl;\n            return (\n              <div\n                key={post.id}\n                className=\"bg-white p-4 rounded-2xl border border-[#EAECF0] shadow-sm space-y-3\"\n              >\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div className=\"flex items-center gap-2.5 min-w-0\">\n                    {mediaUrl ? (\n                      <img\n                        src={mediaUrl}\n                        alt=\"\"\n                        className=\"w-12 h-12 rounded-xl object-cover border border-[#EAECF0] shrink-0\"\n                      />\n                    ) : (\n                      <div className=\"w-12 h-12 rounded-xl bg-[#F2F4F7] flex items-center justify-center text-[#98A2B3] text-xs font-mono shrink-0\">\n                        TXT\n                      </div>\n                    )}\n                    <div className=\"min-w-0\">\n                      <span className=\"text-[10px] font-mono font-bold text-[#1336E8] uppercase block\">\n                        {post.brandName}\n                      </span>\n                      <h4\n                        onClick={() => onSelectPost(post)}\n                        className=\"text-xs font-bold text-[#101828] truncate cursor-pointer hover:text-[#1336E8]\"\n                      >\n                        {post.title}\n                      </h4>\n                    </div>\n                  </div>\n                  <div className=\"shrink-0\">{getApprovalBadge(post.approvalStatus)}</div>\n                </div>\n\n                <p className=\"text-[11px] text-[#475467] line-clamp-2 leading-relaxed\">\n                  {post.masterCaption}\n                </p>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-[#F2F4F7] text-[11px]\">\n                  <div className=\"flex items-center gap-1\">\n                    {post.platforms.map(p => (\n                      <span\n                        key={p.platform}\n                        className=\"px-1.5 py-0.5 rounded bg-[#F2F4F7] text-[9px] font-mono text-[#344054] uppercase font-bold\"\n                      >\n                        {p.platform[0]}\n                      </span>\n                    ))}\n                  </div>\n\n                  <span className=\"text-[#667085] font-mono text-[10px]\">\n                    {post.scheduledAt\n                      ? new Date(post.scheduledAt).toLocaleDateString([], { month: \'short\', day: \'numeric\', hour: \'2-digit\', minute: \'2-digit\' })\n                      : \'Unscheduled\'}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-2 pt-1 border-t border-[#F2F4F7]\">\n                  <button\n                    onClick={() => onSelectPost(post)}\n                    className=\"flex-1 min-h-[38px] px-3 py-1.5 rounded-xl border border-[#D0D5DD] bg-white hover:bg-[#F9FAFB] text-xs font-semibold text-[#344054] flex items-center justify-center gap-1.5\"\n                  >\n                    <Eye className=\"w-3.5 h-3.5 text-[#1336E8]\" />\n                    <span>View / Chat</span>\n                  </button>\n\n                  {post.approvalStatus === \'in_review\' && (\n                    <button\n                      onClick={() => onApprovePost(post.id)}\n                      className=\"min-h-[38px] px-3.5 py-1.5 rounded-xl bg-[#12B76A] hover:bg-[#027A48] text-white text-xs font-semibold flex items-center justify-center gap-1.5 shadow-sm\"\n                    >\n                      <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                      <span>Approve</span>\n                    </button>\n                  )}\n\n                  {post.approvalStatus === \'approved\' && post.publishingStatus !== \'published\' && (\n                    <button\n                      onClick={() => onPublishNow(post.id)}\n                      className=\"min-h-[38px] px-3.5 py-1.5 rounded-xl bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold flex items-center justify-center gap-1.5 shadow-sm\"\n                    >\n                      <Play className=\"w-3.5 h-3.5 fill-current\" />\n                      <span>Publish</span>\n                    </button>\n                  )}\n\n                  <button\n                    onClick={() => onDeletePost(post.id)}\n                    className=\"min-h-[38px] px-2.5 py-1.5 rounded-xl border border-[#FECDCA] text-[#F04438] hover:bg-[#FEF3F2] flex items-center justify-center\"\n                    title=\"Delete Post\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>"
          start_line: 200
          end_line: 373
        }
      }
    }
    action_result {
    }
    use_fast_apply: true
