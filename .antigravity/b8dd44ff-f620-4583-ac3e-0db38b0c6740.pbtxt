  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Bell,\n  Search,\n  CheckCircle2,\n  Calendar,\n  Globe,\n  LogOut,\n  Shield,\n  User,\n  ChevronDown,\n  Activity,\n  Layers\n} from \'lucide-react\';\nimport { Brand, InAppNotification, RoleName } from \'../../../server/src/types\';\n\ninterface HeaderProps {\n  brands: Brand[];\n  selectedBrandId: number | null;\n  onSelectBrand: (brandId: number | null) => void;\n  notifications: InAppNotification[];\n  currentRole: RoleName;\n  onChangeRole: (role: RoleName) => void;\n  onOpenN8nStatus: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  brands,\n  selectedBrandId,\n  onSelectBrand,\n  notifications,\n  currentRole,\n  onChangeRole,\n  onOpenN8nStatus,\n}) => {\n  const [isNotifOpen, setIsNotifOpen] = useState(false);\n  const [isProfileOpen, setIsProfileOpen] = useState(false);\n  const [dateRange, setDateRange] = useState(\'Last 30 Days\');\n\n  const unreadCount = notifications.filter(n => !n.isRead).length;\n  const activeBrand = brands.find(b => b.id === selectedBrandId);\n\n  return (\n    <header className=\"h-16 px-4 sm:px-6 bg-white border-b border-[#EAECF0] flex items-center justify-between gap-4 sticky top-0 z-30\">\n      {/* Left: Brand Switcher & Global Search */}\n      <div className=\"flex items-center gap-3 sm:gap-4 flex-1 max-w-xl\">\n        {/* Brand Dropdown */}\n        <div className=\"relative\">\n          <select\n            value={selectedBrandId || \'\'}\n            onChange={e => onSelectBrand(e.target.value ? Number(e.target.value) : null)}\n            className=\"h-9 pl-3 pr-8 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs font-semibold text-[#101828] focus:outline-none focus:border-[#1336E8] cursor-pointer appearance-none transition-colors\"\n          >\n            <option value=\"\">All Brands ({brands.length})</option>\n            {brands.map(b => (\n              <option key={b.id} value={b.id}>\n                {b.name}\n              </option>\n            ))}\n          </select>\n          <ChevronDown className=\"w-3.5 h-3.5 text-[#667085] absolute right-2.5 top-3 pointer-events-none\" />\n        </div>\n\n        {/* Global Search */}\n        <div className=\"relative flex-1 hidden md:block\">\n          <Search className=\"w-4 h-4 text-[#667085] absolute left-3 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search posts, campaigns, tags...\"\n            className=\"w-full h-9 pl-9 pr-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] placeholder-[#667085] focus:outline-none focus:border-[#1336E8] transition-colors\"\n          />\n        </div>\n      </div>\n\n      {/* Right: n8n Connection status, Date Range, Notifications & User */}\n      <div className=\"flex items-center gap-2 sm:gap-3 shrink-0\">\n        {/* n8n Status Pill */}\n        <button\n          onClick={onOpenN8nStatus}\n          className=\"h-8 px-2.5 rounded-lg border border-[#D0D5DD] bg-[#F6F8FC] hover:bg-[#F2F4F7] flex items-center gap-1.5 text-[11px] font-medium text-[#344054] transition-colors\"\n          title=\"Click to view n8n Orchestrator status\"\n        >\n          <span className=\"w-2 h-2 rounded-full bg-[#12B76A] ring-2 ring-[#12B76A]/20\"></span>\n          <span className=\"hidden sm:inline font-mono\">n8n Connected</span>\n        </button>\n\n        {/* Date Range Selector */}\n        <div className=\"hidden lg:flex items-center gap-1.5 h-8 px-2.5 bg-[#F6F8FC] border border-[#D0D5DD] rounded-lg text-xs font-medium text-[#344054]\">\n          <Calendar className=\"w-3.5 h-3.5 text-[#667085]\" />\n          <span>{dateRange}</span>\n        </div>\n\n        {/* Notifications Bell */}\n        <div className=\"relative\">\n          <button\n            onClick={() => setIsNotifOpen(!isNotifOpen)}\n            className=\"w-9 h-9 rounded-xl border border-[#D0D5DD] bg-white hover:bg-[#F6F8FC] flex items-center justify-center text-[#344054] relative transition-colors\"\n          >\n            <Bell className=\"w-4 h-4\" />\n            {unreadCount > 0 && (\n              <span className=\"absolute -top-1 -right-1 w-4 h-4 bg-[#F04438] text-white rounded-full text-[10px] font-bold flex items-center justify-center\">\n                {unreadCount}\n              </span>\n            )}\n          </button>\n\n          {isNotifOpen && (\n            <div className=\"absolute right-0 mt-2 w-80 bg-white border border-[#EAECF0] rounded-2xl shadow-xl p-3 z-50 space-y-2 animate-in fade-in duration-150\">\n              <div className=\"flex items-center justify-between border-b border-[#EAECF0] pb-2 px-1\">\n                <span className=\"text-xs font-bold text-[#101828]\">Activity Notifications</span>\n                <span className=\"text-[11px] text-[#1336E8] cursor-pointer\">Mark all as read</span>\n              </div>\n              <div className=\"space-y-1.5 max-h-64 overflow-y-auto\">\n                {notifications.map(n => (\n                  <div\n                    key={n.id}\n                    className={`p-2.5 rounded-xl text-xs space-y-1 transition-colors ${\n                      n.isRead ? \'bg-[#F9FAFB] text-[#475467]\' : \'bg-[#EFF8FF] text-[#1D2939]\'\n                    }`}\n                  >\n                    <div className=\"font-semibold text-[11px] text-[#101828]\">{n.title}</div>\n                    <p className=\"text-[11px] leading-relaxed line-clamp-2\">{n.message}</p>\n                    <span className=\"text-[10px] text-[#98A2B3] block\">\n                      {new Date(n.createdAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* User Profile & RBAC Switcher */}\n        <div className=\"relative\">\n          <button\n            onClick={() => setIsProfileOpen(!isProfileOpen)}\n            className=\"flex items-center gap-2 pl-1 pr-2 py-1 rounded-xl border border-[#D0D5DD] hover:bg-[#F6F8FC] transition-colors\"\n          >\n            <img\n              src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&h=80&q=80\"\n              alt=\"David Vance\"\n              className=\"w-7 h-7 rounded-lg object-cover\"\n            />\n            <div className=\"text-left hidden sm:block\">\n              <span className=\"text-xs font-semibold text-[#101828] block leading-tight\">David Vance</span>\n              <span className=\"text-[10px] text-[#1336E8] font-medium block leading-tight\">{currentRole}</span>\n            </div>\n            <ChevronDown className=\"w-3.5 h-3.5 text-[#667085]\" />\n          </button>\n\n          {isProfileOpen && (\n            <div className=\"absolute right-0 mt-2 w-64 bg-white border border-[#EAECF0] rounded-2xl shadow-xl p-3 z-50 space-y-3 animate-in fade-in duration-150\">\n              <div className=\"border-b border-[#EAECF0] pb-2\">\n                <span className=\"text-xs font-bold text-[#101828] block\">Switch Active Role (RBAC)</span>\n                <span className=\"text-[10px] text-[#667085]\">Test permission policies live:</span>\n              </div>\n              <div className=\"space-y-1\">\n                {([\'Super Admin\', \'Admin\', \'Content Manager\', \'Approver\', \'Analyst\', \'Client\'] as RoleName[]).map(r => (\n                  <button\n                    key={r}\n                    onClick={() => {\n                      onChangeRole(r);\n                      setIsProfileOpen(false);\n                    }}\n                    className={`w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center justify-between ${\n                      currentRole === r\n                        ? \'bg-[#1336E8] text-white\'\n                        : \'text-[#344054] hover:bg-[#F2F4F7]\'\n                    }`}\n                  >\n                    <span>{r}</span>\n                    {currentRole === r && <CheckCircle2 className=\"w-3.5 h-3.5\" />}\n                  </button>\n                ))}\n              </div>\n              <div className=\"border-t border-[#EAECF0] pt-2 text-[11px] text-[#667085]\">\n                <span>Logged in as: admin@ci360.internal</span>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/layout/Header.tsx"
        }
        overwrite: true
      }
    }
