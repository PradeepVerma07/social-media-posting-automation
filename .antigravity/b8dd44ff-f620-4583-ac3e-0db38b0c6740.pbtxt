    content: "      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm\">\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-2 text-xs font-mono text-[#1336E8] font-bold\">\n            <span>n8n REST API &amp; PRODUCTION WEBHOOKS</span>\n            <span>\302\267</span>\n            <span>ALLOWLIST ENFORCED</span>\n          </div>\n          <h2 className=\"text-xl font-bold text-[#101828]\">Automations &amp; Workflows</h2>\n          <p className=\"text-xs text-[#667085] max-w-2xl\">\n            Execute and monitor business automations running in your self-hosted n8n environment. All outbound requests are signed with HMAC SHA-256 and include idempotency keys.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <button\n            onClick={handleTest}\n            disabled={testingConnection}\n            className=\"px-3.5 py-2 bg-white border border-[#D0D5DD] hover:bg-[#F2F4F7] text-[#344054] text-xs font-semibold rounded-xl flex items-center gap-1.5 transition-colors\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 ${testingConnection ? \'animate-spin\' : \'\'}`} />\n            <span>Test n8n Bridge</span>\n          </button>\n          <button\n            onClick={onViewExecutions}\n            className=\"px-3.5 py-2 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\"\n          >\n            <Activity className=\"w-3.5 h-3.5\" />\n            <span>View Executions</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Connection Test Banner if tested */}\n      {connectionResult && (\n        <div\n          className={`p-4 rounded-xl border flex items-center justify-between text-xs animate-in fade-in duration-150 ${\n            connectionResult.reachable\n              ? \'bg-[#ECFDF3] border-[#A6F4C5] text-[#027A48]\'\n              : \'bg-[#FEF3F2] border-[#FECDCA] text-[#B42318]\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2 font-medium\">\n            <CheckCircle2 className=\"w-4 h-4 text-[#12B76A]\" />\n            <span>n8n Core API is responding normally ({connectionResult.latencyMs}ms roundtrip). Version: {connectionResult.version}</span>\n          </div>\n          <span className=\"font-mono text-[11px] font-bold\">HMAC VERIFIED</span>\n        </div>\n      )}\n\n      {/* Workflows Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {workflows.map(wf => {\n          const totalRuns = wf.successCount + wf.failureCount;\n          const successRate = totalRuns > 0 ? Math.round((wf.successCount / totalRuns) * 100) : 100;\n          const isRunning = executingId === wf.id;\n\n          return (\n            <div\n              key={wf.id}\n              className=\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm p-6 space-y-4 hover:shadow-md transition-shadow\"\n            >"
    num_lines: 177
