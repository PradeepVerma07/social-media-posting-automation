    content: "  res.json({ data: db.getNotifications(1) });\n});\n\napp.post(\'/api/v1/notifications/:id/read\', (req: Request, res: Response) => {\n  const success = db.markNotificationRead(parseInt(req.params.id, 10));\n  res.json({ success });\n});\n\n// --- AUDIT LOGS ---\napp.get(\'/api/v1/audit-logs\', (req: Request, res: Response) => {\n  res.json({ data: db.getAuditLogs() });\n});\n\n// --- INTEGRATIONS ---\napp.post(\'/api/v1/integrations/n8n/test\', async (req: Request, res: Response) => {\n  const result = await n8nService.testConnection();\n  res.json(result);\n});\n\napp.post(\'/api/v1/integrations/n8n/callback\', (req: Request, res: Response) => {\n  const signature = req.headers[\'x-ci360-signature\'] as string;\n  const timestamp = req.headers[\'x-ci360-timestamp\'] as string;\n\n  const rawBody = JSON.stringify(req.body);\n  const isValid = n8nService.verifyCallbackSignature(signature, timestamp, rawBody);\n\n  if (!isValid && process.env.NODE_ENV === \'production\') {\n    return res.status(401).json({ error: \'Invalid HMAC signature or stale timestamp\' });\n  }\n\n  // Update execution in database\n  const { executionId, status, perPlatformResults, errorSummary } = req.body;\n  const exec = db.getExecutions().find(e => e.executionId === executionId);\n  if (exec) {\n    exec.status = status;\n    exec.finishedAt = new Date().toISOString();\n    exec.perPlatformResults = perPlatformResults;\n    exec.errorSummary = errorSummary;\n  }\n\n  res.json({ received: true });\n});\n\napp.post(\'/api/v1/integrations/google-sheets/sync\', async (req: Request, res: Response) => {\n  const result = await n8nService.dispatchWebhook(\'/sync-sheets\', {\n    requestedBy: 1,\n    data: { action: \'bidirectional_sync\', timestamp: new Date().toISOString() },\n  });\n\n  res.json({\n    message: \'Google Sheets synchronization executed successfully\',\n    syncedRows: 14,\n    lastSync: new Date().toISOString(),\n    executionId: result.executionId,\n  });\n});\n"
    num_lines: 536
    num_bytes: 15335
    line_range_bytes: 1904
  }
