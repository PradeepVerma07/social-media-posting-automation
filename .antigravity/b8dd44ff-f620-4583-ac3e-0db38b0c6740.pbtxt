        instruction: "import { NodeDefinition } from \'../types/workflow\';\n\nexport const NODE_DEFINITIONS: Record<string, NodeDefinition> = {\n  webhook: {\n    type: \'webhook\',\n    name: \'Webhook\',\n    category: \'trigger\',\n    icon: \'Webhook\',\n    description: \'Starts the workflow when an HTTP request is received\',\n    inputs: 0,\n    outputs: 1,\n    defaultParameters: {\n      path: \'/webhook/test-event\',\n      httpMethod: \'POST\',\n      responseMode: \'onReceived\',\n      responseData: \'allEntries\',\n      testPayload: JSON.stringify(\n        {\n          event: \'order.created\',\n          orderId: \'ORD-98231\',\n          customer: {\n            name: \'Sarah Connor\',\n            email: \'sarah@example.com\',\n          },\n          total: 149.5,\n          items: [\n            { id: \'sku-1\', name: \'Standard Subscription\', price: 99.5 },\n            { id: \'sku-2\', name: \'Priority Support Add-on\', price: 50.0 },\n          ],\n        },\n        null,\n        2\n      ),\n    },\n  },\n  schedule: {\n    type: \'schedule\',\n    name: \'Schedule Trigger\',\n    category: \'trigger\',\n    icon: \'Clock\',\n    description: \'Triggers the workflow at set recurring intervals or cron times\',\n    inputs: 0,\n    outputs: 1,\n    defaultParameters: {\n      rule: \'interval\',\n      intervalHours: 1,\n      cronExpression: \'0 * * * *\',\n      timezone: \'UTC\',\n    },\n  },\n  manual: {\n    type: \'manual\',\n    name: \'When clicking Test workflow\',\n    category: \'trigger\',\n    icon: \'PlayCircle\',\n    description: \'Triggers the workflow immediately on manual execution\',\n    inputs: 0,\n    outputs: 1,\n    defaultParameters: {\n      sampleData: JSON.stringify(\n        {\n          timestamp: new Date().toISOString(),\n          userId: \'usr_7721\',\n          action: \'manual_verification\',\n          status: \'initiated\',\n        },\n        null,\n        2\n      ),\n    },\n  },\n  httpRequest: {\n    type: \'httpRequest\',\n    name: \'HTTP Request\',\n    category: \'action\',\n    icon: \'Globe\',\n    description: \'Sends an HTTP/REST request to any API endpoint\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      method: \'GET\',\n      url: \'https://jsonplaceholder.typicode.com/posts/1\',\n      sendHeaders: true,\n      headers: JSON.stringify({ \'Content-Type\': \'application/json\' }, null, 2),\n      sendBody: false,\n      body: \'{}\',\n    },\n  },\n  code: {\n    type: \'code\',\n    name: \'Code (JavaScript)\',\n    category: \'transform\',\n    icon: \'Code2\',\n    description: \'Run custom JavaScript to transform and process data\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      code: `// Loop over input items and transform\nconst items = $input.all();\nreturn items.map((item, index) => {\n  const data = item.json || item;\n  return {\n    json: {\n      ...data,\n      processedAt: new Date().toISOString(),\n      itemIndex: index + 1,\n      isProcessed: true,\n      normalizedScore: Math.round(((data.total || data.id || 100) * 1.15) * 100) / 100,\n    }\n  };\n});`,\n    },\n  },\n  editFields: {\n    type: \'editFields\',\n    name: \'Edit Fields (Set)\',\n    category: \'transform\',\n    icon: \'Sliders\',\n    description: \'Set, update, or remove key-value fields on incoming items\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      fields: [\n        { key: \'environment\', value: \'production\', type: \'string\' },\n        { key: \'priority\', value: \'high\', type: \'string\' },\n        { key: \'retryCount\', value: \'0\', type: \'number\' },\n      ],\n    },\n  },\n  if: {\n    type: \'if\',\n    name: \'If\',\n    category: \'flow\',\n    icon: \'GitFork\',\n    description: \'Split workflow execution depending on condition results\',\n    inputs: 1,\n    outputs: 2, // 0 = true, 1 = false\n    defaultParameters: {\n      field: \'total\',\n      operator: \'greaterThan\',\n      value: \'100\',\n    },\n  },\n  filter: {\n    type: \'filter\',\n    name: \'Filter\',\n    category: \'transform\',\n    icon: \'Filter\',\n    description: \'Keep or discard items based on defined criteria\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      field: \'status\',\n      operator: \'notEmpty\',\n      value: \'\',\n    },\n  },\n  slackWebhook: {\n    type: \'slackWebhook\',\n    name: \'Slack / Discord Webhook\',\n    category: \'action\',\n    icon: \'Send\',\n    description: \'Post structured notifications to a chat webhook URL\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      webhookUrl: \'https://hooks.slack.com/services/SIMULATED/WORKSPACE/WEBHOOK\',\n      channel: \'#automations\',\n      messageTemplate: \'\360\237\224\224 *Workflow Alert*: Processed item with ID: {{orderId || id || \"N/A\"}} at {{new Date().toLocaleTimeString()}}\',\n    },\n  },\n  email: {\n    type: \'email\',\n    name: \'Send Email Notification\',\n    category: \'action\',\n    icon: \'Mail\',\n    description: \'Send transactional email notification or report\',\n    inputs: 1,\n    outputs: 1,\n    defaultParameters: {\n      toEmail: \'ops-team@company.internal\',\n      subject: \'Automation Digest: Workflow Success\',\n      bodyTemplate: \'Hello,\\n\\nThe workflow completed successfully.\\nItem summary:\\nTotal: ${{total || \"0\"}}\\nTimestamp: {{new Date().toISOString()}}\',\n    },\n  },\n};\n"
        path {
          absolute_uri: "file:///src/data/nodeDefinitions.ts"
        }
        overwrite: true
      }
    }
