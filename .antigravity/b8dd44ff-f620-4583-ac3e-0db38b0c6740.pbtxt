              text: "              className=\"px-4 py-2 bg-[#ff6d5a] hover:bg-[#ea503c] disabled:opacity-50 text-white rounded-lg text-xs font-medium transition-colors flex items-center gap-1.5 shadow-sm\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
