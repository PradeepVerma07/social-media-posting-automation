    content: "          )}\n\n          {activeTab === \'sheets\' && (\n            <GoogleSheetsSyncPage onTriggerSync={() => api.syncGoogleSheets()} />\n          )}\n\n          {activeTab === \'team\' && (\n            <div className=\"p-8 max-w-5xl mx-auto space-y-6\">\n              <div>\n                <h2 className=\"text-2xl font-bold text-[#101828]\">Team &amp; Role-Based Access Control</h2>\n                <p className=\"text-xs text-[#667085] mt-1\">\n                  Manage members across Super Admin, Admin, Content Manager, Approver, Analyst, and Client roles.\n                </p>\n              </div>\n\n              <div className=\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm overflow-hidden\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-[#F9FAFB] border-b border-[#EAECF0] text-[#475467] font-semibold\">\n                    <tr>\n                      <th className=\"py-3 px-4\">Name</th>\n                      <th className=\"py-3 px-4\">Email</th>\n                      <th className=\"py-3 px-4\">Role</th>\n                      <th className=\"py-3 px-4\">Tenant Scope</th>\n                      <th className=\"py-3 px-4\">Status</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-[#EAECF0]\">\n                    <tr>\n                      <td className=\"py-3 px-4 font-bold text-[#101828]\">David Vance</td>\n                      <td className=\"py-3 px-4 text-[#667085]\">admin@ci360.internal</td>\n                      <td className=\"py-3 px-4\"><span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#EFF8FF] text-[#1336E8]\">Super Admin</span></td>\n                      <td className=\"py-3 px-4 text-[#475467]\">Global (All Brands)</td>\n                      <td className=\"py-3 px-4 text-[#12B76A] font-bold\">Active</td>\n                    </tr>\n                    <tr>\n                      <td className=\"py-3 px-4 font-bold text-[#101828]\">Elena Rostova</td>\n                      <td className=\"py-3 px-4 text-[#667085]\">editor@ci360.internal</td>\n                      <td className=\"py-3 px-4\"><span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#ECFDF3] text-[#027A48]\">Content Manager</span></td>\n                      <td className=\"py-3 px-4 text-[#475467]\">Nexus &amp; Starlight</td>\n                      <td className=\"py-3 px-4 text-[#12B76A] font-bold\">Active</td>\n                    </tr>\n                    <tr>\n                      <td className=\"py-3 px-4 font-bold text-[#101828]\">Marcus Sterling</td>\n                      <td className=\"py-3 px-4 text-[#667085]\">approver@ci360.internal</td>\n                      <td className=\"py-3 px-4\"><span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#FEF0C7] text-[#B54708]\">Approver</span></td>\n                      <td className=\"py-3 px-4 text-[#475467]\">Global (All Brands)</td>\n                      <td className=\"py-3 px-4 text-[#12B76A] font-bold\">Active</td>\n                    </tr>\n                    <tr>\n                      <td className=\"py-3 px-4 font-bold text-[#101828]\">Sophia Al-Mansoor</td>\n                      <td className=\"py-3 px-4 text-[#667085]\">client@nexusglobal.com</td>\n                      <td className=\"py-3 px-4\"><span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#F2F4F7] text-[#344054]\">Client</span></td>\n                      <td className=\"py-3 px-4 text-[#475467]\">Nexus Enterprise Cloud Only</td>\n                      <td className=\"py-3 px-4 text-[#12B76A] font-bold\">Active</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n\n          {activeTab === \'audit\' && (\n            <AuditLogsPage logs={auditLogs} />\n          )}\n\n          {activeTab === \'settings\' && (\n            <SettingsPage />\n          )}\n        </main>\n      </div>\n    </div>\n  );\n}\n"
