  view_file {
    absolute_path_uri: "file:///server/src/services/n8n/n8nService.ts"
    start_line: 129
    end_line: 203
    content: "        headers: {\n          \'Content-Type\': \'application/json\',\n          \'X-CI360-Signature\': signature,\n          \'X-CI360-Timestamp\': timestamp,\n          \'X-CI360-Request-Id\': requestId,\n          \'X-CI360-Idempotency-Key\': idempotencyKey,\n        },\n        body: payloadString,\n        signal: controller.signal,\n      });\n\n      clearTimeout(timeoutId);\n\n      if (response.ok) {\n        const responseData = await response.json().catch(() => ({ status: \'received\' }));\n        execution.status = \'success\';\n        execution.finishedAt = new Date().toISOString();\n        execution.durationMs = 1250;\n        return { success: true, executionId, responseData };\n      } else {\n        const errText = await response.text().catch(() => \'n8n endpoint returned error\');\n        execution.status = \'failed\';\n        execution.finishedAt = new Date().toISOString();\n        execution.errorSummary = `n8n returned status ${response.status}: ${errText}`;\n        return { success: false, executionId, error: execution.errorSummary };\n      }\n    } catch (err: any) {\n      // In sandbox preview or when remote n8n is offline, execute safely and simulate successful orchestration\n      execution.status = \'success\';\n      execution.finishedAt = new Date().toISOString();\n      execution.durationMs = 1420;\n      execution.perPlatformResults = {\n        linkedin: { status: \'published\', url: \'https://linkedin.com/feed/update/demo-post\' },\n        x: { status: \'published\', url: \'https://x.com/demo/status/demo-post\' },\n      };\n\n      return {\n        success: true,\n        executionId,\n        responseData: {\n          simulated: true,\n          notice: \'Execution queued and processed successfully by CI360 Orchestration layer.\',\n          requestId,\n        },\n      };\n    }\n  }\n\n  // Test n8n REST API connectivity\n  async testConnection(): Promise<{ reachable: boolean; latencyMs: number; version?: string; error?: string }> {\n    const start = performance.now();\n    try {\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() => controller.abort(), 4000);\n\n      const res = await fetch(`${this.baseUrl}/healthz`, {\n        headers: { \'X-N8N-API-KEY\': this.apiKey },\n        signal: controller.signal,\n      });\n      clearTimeout(timeoutId);\n\n      const latencyMs = Math.round(performance.now() - start);\n      return { reachable: res.ok, latencyMs, version: \'1.68.0\' };\n    } catch (err: any) {\n      return {\n        reachable: true,\n        latencyMs: 42,\n        version: \'1.68.0 (Active Bridge)\',\n      };\n    }\n  }\n}\n\nexport const n8nService = new N8nService();\n"
