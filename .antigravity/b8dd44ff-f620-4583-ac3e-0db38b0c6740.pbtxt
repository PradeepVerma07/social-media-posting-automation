      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Make ContentCalendar header, month grid, and agenda view fully responsive on all screens\", \"EndLine\":120, \"Instruction\":\"Add horizontal scrolling wrapper to month view and wrap header controls\", \"ReplacementContent\":\"      {/* Calendar Header */}\\n      <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 sm:p-6 rounded-2xl border border-[#EAECF0] shadow-sm\\\">\\n        <div className=\\\"flex items-center gap-3 sm:gap-4\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-[#EFF8FF] text-[#1336E8] flex items-center justify-center font-bold shrink-0\\\">\\n            <CalendarIcon className=\\\"w-5 h-5\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-lg sm:text-xl font-bold text-[#101828]\\\">{currentMonth}</h2>\\n            <p className=\\\"text-xs text-[#667085]\\\">Multi-brand automated publishing schedule (America/New_York)</p>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2 sm:gap-3 w-full sm:w-auto\\\">\\n          {/* View Mode Toggle */}\\n          <div className=\\\"flex items-center p-1 bg-[#F2F4F7] rounded-xl text-xs font-semibold flex-1 sm:flex-initial justify-center\\\">\\n            <button\\n              onClick={() => setViewMode(\'month\')}\\n              className={`flex-1 sm:flex-initial px-3 py-1.5 rounded-lg transition-colors text-center ${\\n                viewMode === \'month\' ? \'bg-white text-[#101828] shadow-sm\' : \'text-[#667085]\'\\n              }`}\\n            >\\n              Month\\n            </button>\\n            <button\\n              onClick={() => setViewMode(\'agenda\')}\\n              className={`flex-1 sm:flex-initial px-3 py-1.5 rounded-lg transition-colors text-center ${\\n                viewMode === \'agenda\' ? \'bg-white text-[#101828] shadow-sm\' : \'text-[#667085]\'\\n              }`}\\n            >\\n              Agenda\\n            </button>\\n          </div>\\n\\n          <button\\n            onClick={onCreatePost}\\n            className=\\\"w-full sm:w-auto px-3.5 py-2 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl flex items-center justify-center gap-1.5 shadow-sm\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            <span>Schedule Post</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* MONTH VIEW */}\\n      {viewMode === \'month\' && (\\n        <div className=\\\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm overflow-hidden\\\">\\n          <div className=\\\"overflow-x-auto\\\">\\n            <div className=\\\"min-w-[640px]\\\">\\n              {/* Day of Week Headers */}\\n              <div className=\\\"grid grid-cols-7 border-b border-[#EAECF0] bg-[#F9FAFB] text-center text-xs font-semibold text-[#475467] py-2.5\\\">\\n                <div>Sun</div>\\n                <div>Mon</div>\\n                <div>Tue</div>\\n                <div>Wed</div>\\n                <div>Thu</div>\\n                <div>Fri</div>\\n                <div>Sat</div>\\n              </div>\\n\\n              {/* Calendar Grid */}\\n              <div className=\\\"grid grid-cols-7 auto-rows-[120px] divide-x divide-y divide-[#EAECF0]\\\">\\n                {/* Empty slots before month start */}\\n                {Array.from({ length: START_DAY_OFFSET }).map((_, i) => (\\n                  <div key={`offset-${i}`} className=\\\"bg-[#F9FAFB]/50 p-2\\\" />\\n                ))}\", \"StartLine\":48, \"TargetContent\":\"      {/* Calendar Header */}\\n      <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm\\\">\\n        <div className=\\\"flex items-center gap-4\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-[#EFF8FF] text-[#1336E8] flex items-