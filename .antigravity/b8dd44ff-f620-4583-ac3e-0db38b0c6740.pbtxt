  view_file {
    absolute_path_uri: "file:///src/features/approvals/ApprovalQueue.tsx"
    start_line: 179
    end_line: 249
    content: "            {/* Post Detail Header & Actions */}\n            <div className=\"bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm space-y-4\">\n              <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#EAECF0] pb-4\">\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs font-mono font-bold text-[#1336E8] uppercase\">\n                      {selectedPost.brandName}\n                    </span>\n                    <span className=\"text-xs text-[#98A2B3]\">\302\267</span>\n                    <span className=\"text-xs font-mono text-[#667085]\">\n                      Created by {selectedPost.createdByName}\n                    </span>\n                  </div>\n                  <h3 className=\"text-base font-bold text-[#101828] mt-1\">{selectedPost.title}</h3>\n                </div>\n\n                {/* Primary Approval Actions */}\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  {selectedPost.approvalStatus !== \'approved\' && (\n                    <>\n                      <button\n                        onClick={() => {\n                          setModalInputText(\'\');\n                          setRevisionModalOpen(true);\n                        }}\n                        className=\"px-3 py-1.5 bg-[#FEF0C7] hover:bg-[#FEDF89] text-[#B54708] text-xs font-semibold rounded-xl transition-colors\"\n                      >\n                        Request Revision\n                      </button>\n                      <button\n                        onClick={() => {\n                          setModalInputText(\'\');\n                          setRejectReasonModalOpen(true);\n                        }}\n                        className=\"px-3 py-1.5 bg-[#FEF3F2] hover:bg-[#FECDCA] text-[#B42318] text-xs font-semibold rounded-xl transition-colors\"\n                      >\n                        Reject\n                      </button>\n                      <button\n                        onClick={() => onApprove(selectedPost.id)}\n                        className=\"px-4 py-1.5 bg-[#12B76A] hover:bg-[#027A48] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\"\n                      >\n                        <Check className=\"w-3.5 h-3.5\" />\n                        <span>Approve Content</span>\n                      </button>\n                    </>\n                  )}\n                  {selectedPost.approvalStatus === \'approved\' && selectedPost.publishingStatus !== \'published\' && (\n                    <button\n                      onClick={() => onPublishNow(selectedPost.id)}\n                      className=\"px-4 py-1.5 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                      <span>Trigger n8n Publish Now</span>\n                    </button>\n                  )}\n                </div>\n              </div>\n\n              {/* Master Caption & Overrides */}\n              <div className=\"space-y-3 text-xs\">\n                <div>\n                  <span className=\"font-semibold text-[#344054] block mb-1\">Master Caption:</span>\n                  <div className=\"p-3.5 rounded-xl bg-[#F6F8FC] border border-[#EAECF0] text-[#101828] leading-relaxed\">\n                    {selectedPost.masterCaption}\n                  </div>\n                </div>\n\n                {selectedPost.firstComment && (\n                  <div>\n                    <span className=\"font-semibold text-[#344054] block mb-1\">First Comment:</span>"
    num_lines: 449
