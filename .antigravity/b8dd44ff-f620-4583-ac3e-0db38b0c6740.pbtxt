    content: "      {/* MONTH VIEW */}\n      {viewMode === \'month\' && (\n        <div className=\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm overflow-hidden\">\n          {/* Day of Week Headers */}\n          <div className=\"grid grid-cols-7 border-b border-[#EAECF0] bg-[#F9FAFB] text-center text-xs font-semibold text-[#475467] py-2.5\">\n            <div>Sun</div>\n            <div>Mon</div>\n            <div>Tue</div>\n            <div>Wed</div>\n            <div>Thu</div>\n            <div>Fri</div>\n            <div>Sat</div>\n          </div>\n\n          {/* Calendar Grid */}\n          <div className=\"grid grid-cols-7 auto-rows-[120px] divide-x divide-y divide-[#EAECF0]\">\n            {/* Empty slots before month start */}\n            {Array.from({ length: START_DAY_OFFSET }).map((_, i) => (\n              <div key={`offset-${i}`} className=\"bg-[#F9FAFB]/50 p-2\" />\n            ))}\n\n            {/* Days */}\n            {calendarDays.map(day => {\n              const dayPosts = getPostsForDay(day);\n              const isToday = day === 23;\n              const hasCollision = dayPosts.length > 2;\n\n              return (\n                <div\n                  key={day}\n                  className={`p-2 flex flex-col justify-between transition-colors overflow-hidden ${\n                    isToday ? \'bg-[#EFF8FF]/40\' : \'hover:bg-[#F9FAFB]\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`text-xs font-mono font-bold w-6 h-6 rounded-full flex items-center justify-center ${\n                        isToday ? \'bg-[#1336E8] text-white\' : \'text-[#344054]\'\n                      }`}\n                    >\n                      {day}\n                    </span>"
    num_lines: 215
    num_bytes: 8711
    line_range_bytes: 1778
  }
}
