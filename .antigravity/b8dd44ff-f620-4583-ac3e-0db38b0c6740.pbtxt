      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add X (Twitter) v2 Social Orchestrator template\", \"EndLine\":6, \"Instruction\":\"Insert the X (Twitter) template at the beginning of WORKFLOW_TEMPLATES\", \"ReplacementContent\":\"export const WORKFLOW_TEMPLATES: Workflow[] = [\\n  {\\n    id: \'tpl-x-social-orchestrator\',\\n    name: \'X (Twitter) v2 Auto-Publisher & Thread Orchestrator\',\\n    active: true,\\n    updatedAt: new Date().toISOString(),\\n    nodes: [\\n      {\\n        id: \'node-x-1\',\\n        name: \'Inbound Social Post Webhook\',\\n        type: \'webhook\',\\n        position: [60, 240],\\n        parameters: {\\n          path: \'/webhook/ci360/x-dispatch\',\\n          httpMethod: \'POST\',\\n          testPayload: JSON.stringify(\\n            {\\n              event: \'post.approved\',\\n              brand: \'Nexus Enterprise Cloud\',\\n              author: \'Elena Rostova\',\\n              masterCaption: \'Zero-downtime multi-region K8s autoscaling is live! Sub-10ms latency failover across global clusters for mission-critical enterprise workloads.\',\\n              hashtags: \'#Cloud #DevOps #Kubernetes #Microservices\',\\n              mediaUrl: \'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&h=630&q=80\',\\n              hasThreadFollowup: true,\\n              threadReplyText: \'Want a deep dive into our cross-Atlantic latency benchmarks? Read our architectural whitepaper at https://nexuscloud.io/whitepapers/k8s-multi-region \360\237\232\200\',\\n            },\\n            null,\\n            2\\n          ),\\n        },\\n      },\\n      {\\n        id: \'node-x-2\',\\n        name: \'Format Post & Thread Splitter\',\\n        type: \'code\',\\n        position: [360, 240],\\n        parameters: {\\n          code: `// Normalize incoming post and prepare Twitter v2 payload\\nconst items = $input.all();\\nreturn items.map(item => {\\n  const data = item.json || item;\\n  const fullText = (data.masterCaption || \'\') + \' \' + (data.hashtags || \'\');\\n  const rootText = fullText.length > 280 ? fullText.substring(0, 276) + \'...\' : fullText;\\n  \\n  return {\\n    json: {\\n      ...data,\\n      firstTweetText: rootText,\\n      hasThread: Boolean(data.hasThreadFollowup || data.threadReplyText),\\n      threadReplyText: data.threadReplyText || \'Follow @NexusCloudTech for weekly infrastructure architecture patterns.\',\\n      mediaUrl: data.mediaUrl || \'\',\\n      preparedAt: new Date().toISOString(),\\n      accountHandle: \'@NexusCloudTech\'\\n    }\\n  };\\n});`,\\n        },\\n      },\\n      {\\n        id: \'node-x-3\',\\n        name: \'X (Twitter) - Post Root Tweet\',\\n        type: \'xNode\',\\n        position: [680, 240],\\n        parameters: {\\n          operation: \'createTweet\',\\n          authType: \'oauth2\',\\n          text: \'Zero-downtime multi-region K8s autoscaling is live! Sub-10ms latency failover across global clusters. #Cloud #DevOps #Kubernetes\',\\n          mediaUrls: \'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&h=630&q=80\',\\n          replySettings: \'everyone\',\\n          apiKey: \'ci360_x_client_id_live\',\\n          apiSecretKey: \'ci360_x_client_secret_live\',\\n          bearerToken: \'ci360_x_bearer_token_v2_live\',\\n        },\\n      },\\n      {\\n        id: \'node-x-4\',\\n        name: \'Has Thread Follow-up?\',\\n        type: \'if\',\\n        position: [1000, 240],\\n        parameters: {\\n          field: \'hasThread\',\\n          operator: \'equals\',\\n          value: \'true\',\\n        },\\n      },\\n      {\\n        id: \'node-x-5\',\\n        name: \'X (Twitter) - Thread Reply\',\\n        type: \'xNode\',\\n        position: [1300, 160],\\n        parameters: {\\n          operation: \'replyTweet\',\\n          authType: \'oauth2\',\\n          inReplyToTweetId: \'1849204918293012480\',\\n          text: \'Want a deep dive into our cross-Atlantic latency benchmarks? Read our architectural whitepaper at https://nexuscloud.io/whitepapers/k8s-multi-region \360\237\232\200\',\\n          apiKey: \'ci360_x_client_id_live\',\\n        },\\n      },\\n      {\\n        id: \'node-x-6\',\\n        name: \'Slack Ops Notification\',\\n        type: \'slackWebhook\',\\n        position: [1300, 320],\\n        parameters: {\\n          webhookUrl: \'https://hooks.slack.com/services/SIMULATED/SOCIAL_OPS\',\\n          channel: \'#social-publishing\',\\n          messageTemplate: \'\360\237\232\200 *X (Twitter) Post Published*: Status Live! View Tweet at https://x.com/NexusCloudTech/status/1849204918293012480 at {{new Date().toLocaleTimeString()}}\',\\n        },\\n      },\\n    ],\\n    connections: [\\n      {\\n        id: \'conn-x-1\',\\n        fromNodeId: \'node-x-1\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-x-2\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-x-2\',\\n        fromNodeId: \'node-x-2\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-x-3\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-x-3\',\\n        fromNodeId: \'node-x-3\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-x-4\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-x-4\',\\n        fromNodeId: \'node-x-4\',\\n        fromOutputIndex: 0, // true\\n        toNodeId: \'node-x-5\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-x-5\',\\n        fromNodeId: \'node-x-4\',\\n        fromOutputIndex: 1, // false\\n        toNodeId: \'node-x-6\',\\n        toInputIndex: 0,\\n      },\\n      {\\n        id: \'conn-x-6\',\\n        fromNodeId: \'node-x-5\',\\n        fromOutputIndex: 0,\\n        toNodeId: \'node-x-6\',\\n        toInputIndex: 0,\\n      },\\n    ],\\n  },\\n  {\\n    id: \'tpl-form-crm-sync\',\", \"StartLine\":3, \"TargetContent\":\"export const WORKFLOW_TEMPLATES: Workf