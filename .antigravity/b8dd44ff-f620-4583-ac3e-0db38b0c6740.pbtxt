            lines {
              text: "      <svg"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        className=\"absolute inset-0 pointer-events-none w-full h-full\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
