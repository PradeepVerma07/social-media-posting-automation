  planner_response {
    thinking: "**Designing the Canvas**\n\nI\'m now focusing on `src/components/WorkflowCanvas.tsx`. My current focus is on designing the visual node canvas. I\'m thinking about node dimensions, with a width around 220px and height around 84px. I\'m also considering the components within each node: a title, icon, node type badge, and an execution indicator badge.\n\n\n"
    tool_calls {
      id: "call_609567"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useRef, useEffect } from \'react\';\\nimport {\\n  Webhook,\\n  Clock,\\n  PlayCircle,\\n  Globe,\\n  Code2,\\n  Sliders,\\n  GitFork,\\n  Filter,\\n  Send,\\n  Mail,\\n  Loader2,\\n  CheckCircle2,\\n  AlertCircle,\\n  Plus,\\n  Trash2,\\n  ZoomIn,\\n  ZoomOut,\\n  Maximize2\\n} from \'lucide-react\';\\nimport { WorkflowNode, WorkflowConnection, NodeType } from \'../types/workflow\';\\n\\ninterface WorkflowCanvasProps {\\n  nodes: WorkflowNode[];\\n  connections: WorkflowConnection[];\\n  selectedNodeId: string | null;\\n  onSelectNode: (nodeId: string | null) => void;\\n  onUpdateNodePosition: (nodeId: string, position: [number, number]) => void;\\n  onAddConnection: (connection: Omit<WorkflowConnection, \'id\'>) => void;\\n  onDeleteConnection: (connectionId: string) => void;\\n  onDeleteNode: (nodeId: string) => void;\\n  onOpenLibrary: () => void;\\n  isRunning?: boolean;\\n}\\n\\nconst ICON_MAP: Record<NodeType, React.FC<{ className?: string }>> = {\\n  webhook: Webhook,\\n  schedule: Clock,\\n  manual: PlayCircle,\\n  httpRequest: Globe,\\n  code: Code2,\\n  editFields: Sliders,\\n  if: GitFork,\\n  filter: Filter,\\n  slackWebhook: Send,\\n  email: Mail,\\n};\\n\\nconst NODE_WIDTH = 210;\\nconst NODE_HEIGHT = 80;\\n\\nexport const WorkflowCanvas: React.FC<WorkflowCanvasProps> = ({\\n  nodes,\\n  connections,\\n  selectedNodeId,\\n  onSelectNode,\\n  onUpdateNodePosition,\\n  onAddConnection,\\n  onDeleteConnection,\\n  onDeleteNode,\\n  onOpenLibrary,\\n  isRunning,\\n}) => {\\n  const canvasRef = useRef<HTMLDivElement>(null);\\n\\n  // Pan and Zoom state\\n  const [zoom, setZoom] = useState(1);\\n  const [pan, setPan] = useState<{ x: number; y: number }>({ x: 40, y: 40 });\\n  const [isPanning, setIsPanning] = useState(false);\\n  const [panStart, setPanStart] = useState<{ x: number; y: number }>({ x: 0, y: 0 });\\n\\n  // Dragging Node state\\n  const [draggingNodeId, setDraggingNodeId] = useState<string | null>(null);\\n  const [dragOffset, setDragOffset] = useState<{ x: number; y: number }>({ x: 0, y: 0 });\\n\\n  // Connecting wire in progress\\n  const [connectingFrom, setConnectingFrom] = useState<{\\n    nodeId: string;\\n    outputIndex: number;\\n    startX: number;\\n    startY: number;\\n  } | null>(null);\\n  const [mouseCanvasPos, setMouseCanvasPos] = useState<{ x: number; y: number }>({ x: 0, y: 0 });\\n\\n  // Convert screen coordinates to canvas space\\n  const screenToCanvas = (screenX: number, screenY: number) => {\\n    if (!canvasRef.current) return { x: 0, y: 0 };\\n    const rect = canvasRef.current.getBoundingClientRect();\\n    return {\\n      x: (screenX - rect.left - pan.x) / zoom,\\n      y: (screenY - rect.top - pan.y) / zoom,\\n    };\\n  };\\n\\n  // Node position lookups for wire calculation\\n  const nodeMap = new Map<string, WorkflowNode>();\\n  nodes.forEach(n => nodeMap.set(n.id, n));\\n\\n  const getNodePortPos = (node: WorkflowNode, type: \'input\' | \'output\', index = 0) => {\\n    const [x, y] = node.position;\\n    if (type === \'input\') {\\n      return { x, y: y + NODE_HEIGHT / 2 };\\n    }\\n    // Output port\\n    if (node.type === \'if\') {\\n      // 2 outputs\\n      return {\\n        x: x + NODE_WIDTH,\\n        y: index === 0 ? y + 26 : y + NODE_HEIGHT - 26,\\n      };\\n    }\\n    return { x: x + NODE_WIDTH, y: y + NODE_HEIGHT / 2 };\\n  };\\n\\n  // Canvas Mouse Listeners\\n  const handleMouseDown = (e: React.MouseEvent) => {\\n    // If clicked directly on canvas background, start pan\\n    if (e.target === canvasRef.current || (e.target as HTMLElement).classList.contains(\'canvas-background\')) {\\n      setIsPanning(true);\\n      setPanStart({ x: e.clientX - pan.x, y: e.clientY - pan.y });\\n      onSelectNode(null);\\n    }\\n  };\\n\\n  const handleMouseMove = (e: React.MouseEvent) => {\\n    const canvasPos = screenToCanvas(e.clientX, e.clientY);\\n    setMouseCanvasPos(canvasPos);\\n\\n    if (isPanning) {\\n      setPan({\\n        x: e.clientX - panStart.x,\\n        y: e.clientY - panStart.y,\\n      });\\n    } else if (draggingNodeId) {\\n      onUpdateNodePosition(draggingNodeId, [\\n        Math.round(canvasPos.x - dragOffset.x),\\n        Math.round(canvasPos.y - dragOffset.y),\\n      ]);\\n    }\\n  };\\n\\n  const handleMouseUp = () => {\\n    setIsPanning(false);\\n    setDraggingNodeId(null);\\n    setConnectingFrom(null);\\n  };\\n\\n  const handleNodeMouseDown = (e: React.MouseEvent, node: WorkflowNode) => {\\n    e.stopPropagation();\\n    onSelectNode(node.id);\\n    const canvasPos = screenToCanvas(e.clientX, e.clientY);\\n    setDraggingNodeId(node.id);\\n    setDragOffset({\\n      x: canvasPos.x - node.position[0],\\n      y: canvasPos.y - node.position[1],\\n    });\\n  };\\n\\n  const handleStartConnection = (\\n    e: React.MouseEvent,\\n    nodeId: string,\\n    outputIndex: number\\n  ) => {\\n    e.stopPropagation();\\n    const node = nodeMap.get(nodeId);\\n    if (!node) return;\\n    const port = getNodePortPos(node, \'output\', outputIndex);\\n    setConnectingFrom({\\n      nodeId,\\n      outputIndex,\\n      startX: port.x,\\n      startY: port.y,\\n    });\\n  };\\n\\n  const handleCompleteConnection = (e: React.MouseEvent, targetNodeId: string, inputIndex = 0) => {\\n    e.stopPropagation();\\n    if (connectingFrom && connectingFrom.nodeId !== targetNodeId) {\\n      // Check if connection already exists\\n      const exists = connections.some(\\n        c =>\\n          c.fromNodeId === connectingFrom.nodeId &&\\n          c.fromOutputIndex === connectingFrom.outputIndex &&\\n          c.toNodeId === targetNodeId &&\\n          c.toInputIndex === inputIndex\\n      );\\n\\n      if (!exists) {\\n        onAddConnection({\\n          fromNodeId: connectingFrom.nodeId,\\n          fromOutputIndex: connectingFrom.outputIndex,\\n          toNodeId: targetNodeId,\\n          toInputIndex: inputIndex,\\n        });\\n      }\\n    }\\n    setConnectingFrom(null);\\n  };\\n\\n  // Zoom controls\\n  const handleZoom = (delta: number) => {\\n    setZoom(prev => Math.min(Math.max(0.4, prev + delta), 2.0));\\n  };\\n\\n  const resetView = () => {\\n    setZoom(1);\\n    setPan({ x: 60, y: 60 });\\n  };\\n\\n  return (\\n    <div\\n      ref={canvasRef}\\n      onMouseDown={handleMouseDown}\\n      onMouseMove={handleMouseMove}\\n      onMouseUp={handleMouseUp}\\n      className=\\\"relative w-full h-full overflow-hidden bg-slate-950 canvas-dot-grid cursor-grab active:cursor-grabbing select-none\\\"\\n    >\\n      {/* Zoom & Canvas Actions Toolbar */}\\n      <div className=\\\"absolute bottom-6 left-6 z-20 flex items-center gap-1 bg-slate-900/90 border border-slate-800 p-1.5 rounded-lg shadow-xl backdrop-blur-sm\\\">\\n        <button\\n          onClick={() => handleZoom(0.1)}\\n          className=\\\"p-1.5 text-slate-400 hover:text-white hover:bg-slate-800 rounded transition-colors\\\"\\n          title=\\\"Zoom In\\\"\\n        >\\n          <ZoomIn className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <span className=\\\"text-[11px] font-mono text-slate-400 px-2 min-w-[42px] text-center\\\">\\n          {Math.round(zoom * 100)}%\\n        </span>\\n        <button\\n          onClick={() => handleZoom(-0.1)}\\n          className=\\\"p-1.5 text-slate-400 hover:text-white hover:bg-slate-800 rounded transition-colors\\\"\\n          title=\\\"Zoom Out\\\"\\n        >\\n          <ZoomOut className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <div className=\\\"w-px h-4 bg-slate-800 mx-1\\\" />\\n        <button\\n          onClick={resetView}\\n          className=\\\"p-1.5 text-slate-400 hover:text-white hover:bg-slate-800 rounded transition-colors\\\"\\n          title=\\\"Reset Zoom & Pan\\\"\\n        >\\n          <Maximize2 className=\\\"w-4 h-4\\\" />\\n        </button>\\n      </div>\\n\\n      {/* Floating Add Node & Action Controls */}\\n      <div className=\\\"absolute top-6 left-6 z-20 flex items-center gap-2\\\">\\n        <button\\n          onClick={onOpenLibrary}\\n          className=\\\"flex items-center gap-2 px-3.5 py-2 bg-[#ff6d5a] hover:bg-[#ea503c] text-white text-xs font-semibold rounded-lg shadow-lg shadow-[#ff6d5a]/20 transition-all hover:scale-[1.02]\\\"\\n        >\\n          <Plus className=\\\"w-4 h-4\\\" />\\n          <span>Add Node</span>\\n        </button>\\n\\n        {selectedNodeId && (\\n          <button\\n            onClick={() => onDeleteNode(selectedNodeId)}\\n            className=\\\"flex items-center gap-1.5 px-3 py-2 bg-slate-900/90 hover:bg-red-950/40 text-slate-300 hover:text-red-400 border border-slate-800 hover:border-red-800/80 text-xs font-medium rounded-lg shadow-md transition-all\\\"\\n            title=\\\"Delete Selected Node\\\"\\n          >\\n            <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Delete</span>\\n          </button>\\n        )}\\n      </div>\\n\\n      {/* SVG Layer for Connection Wires */}\\n      <svg\\n        className=\\\"absolute inset-0 pointer-events-none w-full h-full\\\"\\n        style={{\\n          transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`,\\n          transformOrigin: \'0 0\',\\n        }}\\n      >\\n        <defs>\\n          <linearGradient id=\\\"wire-gradient\\\" x1=\\\"0%\\\" y1=\\\"0%\\\" x2=\\\"100%\\\" y2=\\\"0%\\\">\\n            <stop offset=\\\"0%\\\" stopColor=\\\"#64748b\\\" />\\n            <stop offset=\\\"100%\\\" stopColor=\\\"#ff6d5a\\\" />\\n          </linearGradient>\\n          <linearGradient id=\\\"wire-active\\\" x1=\\\"0%\\\" y1=\\\"0%\\\" x2=\\\"100%\\\" y2=\\\"0%\\\">\\n            <stop offset=\\\"0%\\\" stopColor=\\\"#ff6d5a\\\" />\\n            <stop offset=\\\"100%\\\" stopColor=\\\"#38bdf8\\\" />\\n          </linearGradient>\\n        </defs>\\n\\n        {/* Existing Connections */}\\n        {connections.map(conn => {\\n          const fromNode = nodeMap.get(conn.fromNodeId);\\n          const toNode = nodeMap.get(conn.toNodeId);\\n          if (!fromNode || !toNode) return null;\\n\\n          const start = getNodePortPos(fromNode, \'output\', conn.fromOutputIndex);\\n          const end = getNodePortPos(toNode, \'input\', conn.toInputIndex);\\n\\n          const dx = Math.max(Math.abs(end.x - start.x) * 0.5, 40);\\n          const pathD = `M ${start.x} ${start.y} C ${start.x + dx} ${start.y}, ${end.x - dx} ${end.y}, ${end.x} ${end.y}`;\\n\\n          const isNodeActive = isRunning && (fromNode.status === \'running\' || toNode.status === \'running\');\\n\\n          return (\\n            <g key={conn.id} className=\\\"pointer-events-auto group\\\">\\n              {/* Invisible wider hit area for easy hover/clicking to delete wire */}\\n              <path\\n                d={pathD}\\n                fill=\\\"none\\\"\\n                stroke=\\\"transparent\\\"\\n                strokeWidth={14}\\n                className=\\\"cursor-pointer\\\"\\n                onClick={e => {\\n                  e.stopPropagation();\\n                  onDeleteConnection(conn.id);\\n                }}\\n              />\\n              <path\\n                d={pathD}\\n                fill=\\\"none\\\"\\n                stroke={isNodeActive ? \'url(#wire-active)\' : \'#475569\'}\\n                strokeWidth={isNodeActive ? 3 : 2}\\n                strokeDasharray={isNodeActive ? \'6,4\' : undefined}\\n                className={`transition-colors group-hover:stroke-red-400 ${\\n                  isNodeActive ? \'animate-pulse\' : \'\'\\n                }`}\\n              />\\n              {/* Output branch label for IF nodes */}\\n              {fromNode.type === \'if\' && (\\n                <text\\n                  x={start.x + 12}\\n                  y={start.y - 4}\\n                  fill=\\\"#94a3b8\\\"\\n                  fontSize=\\\"10\\\"\\n                  fontFamily=\\\"monospace\\\"\\n                >\\n                  {conn.fromOutputIndex === 0 ? \'true\' : \'false\'}\\n                </text>\\n              )}\\n            </g>\\n          );\\n        })}\\n\\n        {/* Connection currently being dragged */}\\n        {connectingFrom && (\\n          <path\\n            d={`M ${connectingFrom.startX} ${connectingFrom.startY} C ${\\n              connectingFrom.startX + 60\\n            } ${connectingFrom.startY}, ${mouseCanvasPos.x - 60} ${\\n              mouseCanvasPos.y\\n            }, ${mouseCanvasPos.x} ${mouseCanvasPos.y}`}\\n            fill=\\\"none\\\"\\n            stroke=\\\"#ff6d5a\\\"\\n            strokeWidth={2.5}\\n            strokeDasharray=\\\"4,4\\\"\\n          />\\n        )}\\n      </svg>\\n\\n      {/* Nodes Layer */}\\n      <div\\n        className=\\\"absolute inset-0 pointer-events-none\\\"\\n        style={{\\n          transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`,\\n          transformOrigin: \'0 0\',\\n        }}\\n      >\\n        {nodes.map(node => {\\n          const IconComponent = ICON_MAP[node.type] || Globe;\\n          const isSelected = selectedNodeId === node.id;\\n          const [posX, posY] = node.position;\\n\\n          return (\\n            <div\\n              key={node.id}\\n              onMouseDown={e => handleNodeMouseDown(e, node)}\\n              style={{\\n                transform: `translate(${posX}px, ${posY}px)`,\\n                width: `${NODE_WIDTH}px`,\\n                height: `${NODE_HEIGHT}px`,\\n              }}\\n              className={`absolute pointer-events-auto rounded-xl p-3 flex flex-col justify-between transition-shadow cursor-grab active:cursor-grabbing border ${\\n                isSelected\\n                  ? \'bg-slate-900 border-[#ff6d5a] ring-2 ring-[#ff6d5a]/30 shadow-xl\'\\n                  : \'bg-slate-900/90 hover:bg-slate-900 border-slate-800 hover:border-slate-700 shadow-md\'\\n              }`}\\n            >\\n              {/* Left Input Port */}\\n              {node.type !== \'manual\' && node.type !== \'schedule\' && node.type !== \'webhook\' && (\\n                <div\\n                  onMouseUp={e => handleCompleteConnection(e, node.id, 0)}\\n                  className=\\\"absolute -left-2.5 top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-slate-800 border-2 border-slate-600 hover:border-[#ff6d5a] hover:scale-125 transition-transform flex items-center justify-center cursor-pointer z-10\\\"\\n                  title=\\\"Connect input\\\"\\n                >\\n                  <div className=\\\"w-1.5 h-1.5 rounded-full bg-slate-400\\\" />\\n                </div>\\n              )}\\n\\n              {/* Node Header */}\\n              <div className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n                <div\\n                  className={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 border transition-colors ${\\n                    isSelected\\n                      ? \'bg-[#ff6d5a]/20 border-[#ff6d5a] text-[#ff6d5a]\'\\n                      : \'bg-slate-950 border-slate-800 text-[#ff6d5a]\'\\n                  }`}\\n                >\\n                  <IconComponent className=\\\"w-4 h-4\\\" />\\n                </div>\\n\\n                <div className=\\\"min-w-0 flex-1\\\">\\n                  <div className=\\\"text-xs font-semibold text-white truncate leading-tight\\\">\\n                    {node.name}\\n                  </div>\\n                  <div className=\\\"text-[10px] text-slate-400 capitalize truncate mt-0.5\\\">\\n                    {node.type}\\n                  </div>\\n                </div>\\n\\n                {/* Status Indicator */}\\n                <div className=\\\"shrink-0\\\">\\n                  {node.status === \'running\' && (\\n                    <Loader2 className=\\\"w-4 h-4 text-[#ff6d5a] animate-spin\\\" />\\n                  )}\\n                  {node.status === \'success\' && (\\n                    <CheckCircle2 className=\\\"w-4 h-4 text-emerald-400\\\" />\\n                  )}\\n                  {node.status === \'error\' && (\\n                    <AlertCircle className=\\\"w-4 h-4 text-red-400\\\" />\\n                  )}\\n                  {(!node.status || node.status === \'idle\') && (\\n                    <div className=\\\"w-2 h-2 rounded-full bg-slate-700\\\" />\\n                  )}\\n                </div>\\n              </div>\\n\\n              {/* Node Footer Info */}\\n              <div className=\\\"flex items-center justify-between text-[10px] text-slate-500 font-mono pt-1 border-t border-slate-800/80\\\">\\n                <span className=\\\"truncate\\\">\\n                  {node.executionResult?.durationMs !== undefined\\n                    ? `${node.executionResult.durationMs}ms`\\n                    : \'Ready\'}\\n                </span>\\n                <span className=\\\"capitalize\\\">{node.status || \'idle\'}</span>\\n              </div>\\n\\n              {/* Right Output Port(s) */}\\n              {node.type === \'if\' ? (\\n                <>\\n                  {/* True Port (index 0) */}\\n                  <div\\n                    onMouseDown={e => handleStartConnection(e, node.id, 0)}\\n                    className=\\\"absolute -right-2.5 top-[26px] -translate-y-1/2 w-5 h-5 rounded-full bg-slate-800 border-2 border-emerald-500 hover:scale-125 transition-transform flex items-center justify-center cursor-crosshair z-10 group\\\"\\n                    title=\\\"True Branch (Drag to connect)\\\"\\n                  >\\n                    <div className=\\\"w-1.5 h-1.5 rounded-full bg-emerald-400\\\" />\\n                  </div>\\n                  {/* False Port (index 1) */}\\n                  <div\\n                    onMouseDown={e => handleStartConnection(e, node.id, 1)}\\n                    className=\\\"absolute -right-2.5 bottom-[14px] w-5 h-5 rounded-full bg-slate-800 border-2 border-amber-500 hover:scale-125 transition-transform flex items-center justify-center cursor-crosshair z-10 group\\\"\\n                    title=\\\"False Branch (Drag to connect)\\\"\\n                  >\\n                    <div className=\\\"w-1.5 h-1.5 rounded-full bg-amber-400\\\" />\\n                  </div>\\n                </>\\n              ) : (\\n                <div\\n                  onMouseDown={e => handleStartConnection(e, node.id, 0)}\\n                  className=\\\"absolute -right-2.5 top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-slate-800 border-2 border-slate-600 hover:border-[#ff6d5a] hover:scale-125 transition-transform flex items-center justify-center cursor-crosshair z-10\\\"\\n                  title=\\\"Drag to connect\\\"\\n                >\\n                  <div className=\\\"w-1.5 h-1.5 rounded-full bg-[#ff6d5a]\\\" />\\n                </div>\\n              )}\\n            </div>\\n          );\\n        })}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create WorkflowCanvas component with smooth SVG wiring, node dragging, port handles, and execution flow\", \"Overwrite\":true, \"TargetFile\":\"/src/components/WorkflowCanvas.tsx\", \"toolAction\":\"Creating WorkflowCanvas component\", \"toolSummary\":\"Create WorkflowCanvas\"}"
      thinking_signature: "\022\321\v\n\316\v\001i\024}\023p\367\026U\251\037\370\320\024q\330\027\036r<|\365U\036\217\242.\366!}\3626\371\350\375\037\375\364\300\214\215W\211q\250F\307,()z\256\331\001&\320s\334<M\335z(\257\313v\347\324H\025\273{*\327-\273/KkC7\331\263|+?\016\354\364\321}ud\v9\203\a6\232u\315\250\026b\277\233\263\253\301M\2425-\276\303\247\3375\245xE\302\205\262\023\350\v\363\2736\231\215\225\226\357\026O\212\266\177\031\312\345O\030\305\370\\\350`\036\274\231\002\0275%\315\252:\345\023\256\360\212\211\233\257\210\376\263\340\\BO\004\213\360\334\020U\325c\210\346\227\315\231\353\227\321\233g\250D?{T\225\022\264\025B\307o<\232!\341T\024W#\204\200]>\177G\a&\201\312x\017\367\307=\377\374Ts\301U\272\351\022b\030\022YLw\346\330f\313\351\f\243\330\200\310\220,5-\370\201\350\272\314\257\022.18\352\241\005\251 ?\344z\221\373=\254\'\001,\366v\340b=-x\304\245\0051\355:gR\341#\021]4q,\355\357\f\024\026\201\366\227\316\302-\245l\026\216\211\343bf\035\365=\221\300 \245\367:3\2119K\257\002\232H!\026\372-\3508w\355\272\262\225l[\303\260\nK\256\027}\252\225\302\271ia\356\351\262\234bk\017\241\273\361s~9\234\3057F\213C\214#\024\356\212+\362Op\036\227\372\246\001(L\vc\017C\232\345\004Oc)\374m\263\227\334zB\240\n;I\017\232{\022\336@\201\n\302^]\016\336\036\354\265\216q\302\261n\355\247\342l\024\027G\335\205\346\032RW\021\025J\332\017|\360\355aW\224\366\003\210AG\207\371\177.\226-\242\220\227\344}\360!Ui\312?\314\205\276\177\034\026\247\246\240F\032\366Y\356\330\353%k\224/E\376Z\306\326\306R\376\306\246\265\237\2569aW*Q\2050\023\2572\301Q\213\267r\037i{D\021\025\306\335@\266*\3067\177@\371\240\361\b&B\335\225\351\320<\242#\016\372\342J\347\022\315\324\207#|edg\360\231\030X\n\033\022\275\327\026*\325p\330\026\265\375\362O&\210\375\a\006\251\357\322\022\332\271o\210\314CE\363:\033\363\220\372>\302l\200hj\tY\274\362Z\336\006\232\203KE\000CpB\374r\370B\223\320\27089\325\200j\352\001\271\226\266=F!TpP\202o5F\257,&\205|\330\032{Z\307\303\351X\"\320\002z\024.\267\001\375\311o\221\370\355%\364\321\271s\325R\326\372\2206\\\311\211ZEBn\355\351\340\210\357\nh7\205Wh\343\257?n\217u\273\002\005\020=L\303\177\363\032i\261O2G\325Y\003\261\025\351/e\360\276\367Y\334\346:\b1\331\372\272\213\260\307\267\357\243\324~\300Se+ul\334\216\346h\230\213\250\375\r_\207\361\322\371\242^\272U\030F\254R\226!\032\034\033\332\361\245\243\256\213G\254\\\025\022\230m1\305\220\365\236K\237\225K\276?\026\227`\026\356\275\202\375\t0\346\033\213\'^\023\207\264\370#\271\326i\245\213%h\301\177\357\335\243\0202\363\021^\367z\274g\273\tJ\227T{w\027\363\022\337\246z\276x\225\221\0279\260\233E\307\037\323\032\261\232`\251<\223\211\207.\'\245Y\2332\331\\\f\246\235p:p1\255<m\bxS\006\325\026P\236\027V4W\354\271M\t\377HD\f\375\031JQ~\034\313*\037.x\232\277x\177\3639%b\230\332\336\210\2731E\345\2257 T\217i\237\231\350\266\237\037\375\004\275+\301\254\027\215M\231#R\254\206\246Ej+^\v\216\311\277OFD1,\027\003\325w\373\n\224L\272\317)\323C\372\342\254 #\204<\231\217\n\201B\205\256O\203\000}\330\314e\250HX\f\244\206\224\214\a\006\177\373\333[3\302\30677\036\251_\342\376\237\257\271^KL\033\016tQ>\310\324r =\367Z\360\227G\247\372\005J\000N\307\233\341+Ro\315\030\276\301\ab\256\357h\3545\017\232\340\363%\374t\206}K\360\022\333Xl\257\247=\370\310\\\270KD\351\005[h&Q\204tt\221\232\375\276\330R\233_\206B\265b\224~\177\247\276\336\350[q\\y\257\332\303\360\a\t\210\227\234\203q\346\bdL\250Q\315*g\nC\253\326\211\241\350:p\333\357\037k\265\363\016\314o\220\206\242(\231\fR\303\021\210O2\001\317\314\324!\317\231\347\304\353l\\\355\336\204\234\361\271\325a\346\n\245@\n\317\246e\371\265Z\303O\216\240\"x\3053\307&\365\272w\246\340g\300X\211:\v9\341\362\314`\211\003Z\323\265*\304\001y[\376\v\231\\>\210\325[\322-\311\033\2357\244\332\030\034/dl\266y\314\224\360\357oL\\\364\225>\022i\357MM\347%\346\370\314?3\363\334\004i\214\023\350\242\217\000dD\036W\246\330\312\0339*\334\246\372&\356\275@\303\027,5r\375V\271\214\202\255\202\277\333R\332eU-`\365\217\276^\f\020\351-F\a||\033\264\315B\315iFzR\346\017\