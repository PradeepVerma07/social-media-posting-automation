            lines {
              text: "    setZoom(1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setPan({ x: 60, y: 60 });"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
