  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport {\n  Play,\n  Layers,\n  Terminal,\n  History,\n  Download,\n  Upload,\n  Webhook as WebhookIcon,\n  CheckCircle2,\n  AlertCircle,\n  FileText,\n  Loader2,\n  Plus\n} from \'lucide-react\';\nimport { Workflow, WorkflowNode, WorkflowConnection, ExecutionLogEntry, NodeType } from \'./types/workflow\';\nimport { WORKFLOW_TEMPLATES } from \'./data/templates\';\nimport { NODE_DEFINITIONS } from \'./data/nodeDefinitions\';\nimport { runWorkflow, executeSingleNode } from \'./utils/workflowEngine\';\nimport { WorkflowCanvas } from \'./components/WorkflowCanvas\';\nimport { NodeInspector } from \'./components/NodeInspector\';\nimport { NodeLibraryModal } from \'./components/NodeLibraryModal\';\nimport { WebhookSandbox } from \'./components/WebhookSandbox\';\nimport { JsonWorkflowModal } from \'./components/JsonWorkflowModal\';\nimport { InstallHub } from \'./components/InstallHub\';\n\nexport default function App() {\n  const [currentView, setCurrentView] = useState<\'canvas\' | \'install\' | \'executions\'>(\'install\');\n  const [activeWorkflow, setActiveWorkflow] = useState<Workflow>(WORKFLOW_TEMPLATES[0]);\n  const [selectedNodeId, setSelectedNodeId] = useState<string | null>(null);\n\n  // Modals & Panels\n  const [isLibraryOpen, setIsLibraryOpen] = useState(false);\n  const [isWebhookSandboxOpen, setIsWebhookSandboxOpen] = useState(false);\n  const [jsonModalMode, setJsonModalMode] = useState<\'export\' | \'import\' | null>(null);\n\n  // Execution state\n  const [isRunning, setIsRunning] = useState(false);\n  const [lastExecutionResult, setLastExecutionResult] = useState<{\n    success: boolean;\n    durationMs: number;\n  } | null>(null);\n  const [executionLogs, setExecutionLogs] = useState<ExecutionLogEntry[]>([]);\n\n  // Selected Node for Inspector\n  const selectedNode = activeWorkflow.nodes.find(n => n.id === selectedNodeId) || null;\n\n  // Handler: Update Node Position\n  const handleUpdateNodePosition = (nodeId: string, position: [number, number]) => {\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: prev.nodes.map(n => (n.id === nodeId ? { ...n, position } : n)),\n      updatedAt: new Date().toISOString(),\n    }));\n  };\n\n  // Handler: Update Node Parameters\n  const handleUpdateNodeParameters = (nodeId: string, parameters: Record<string, any>) => {\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: prev.nodes.map(n => (n.id === nodeId ? { ...n, parameters } : n)),\n      updatedAt: new Date().toISOString(),\n    }));\n  };\n\n  // Handler: Add Connection\n  const handleAddConnection = (connData: Omit<WorkflowConnection, \'id\'>) => {\n    const newConn: WorkflowConnection = {\n      ...connData,\n      id: `conn-${Date.now().toString(36)}-${Math.random().toString(36).substring(2, 5)}`,\n    };\n    setActiveWorkflow(prev => ({\n      ...prev,\n      connections: [...prev.connections, newConn],\n      updatedAt: new Date().toISOString(),\n    }));\n  };\n\n  // Handler: Delete Connection\n  const handleDeleteConnection = (connectionId: string) => {\n    setActiveWorkflow(prev => ({\n      ...prev,\n      connections: prev.connections.filter(c => c.id !== connectionId),\n      updatedAt: new Date().toISOString(),\n    }));\n  };\n\n  // Handler: Delete Node\n  const handleDeleteNode = (nodeId: string) => {\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: prev.nodes.filter(n => n.id !== nodeId),\n      connections: prev.connections.filter(c => c.fromNodeId !== nodeId && c.toNodeId !== nodeId),\n      updatedAt: new Date().toISOString(),\n    }));\n    if (selectedNodeId === nodeId) {\n      setSelectedNodeId(null);\n    }\n  };\n\n  // Handler: Add Node from Library\n  const handleAddNodeFromType = (type: NodeType) => {\n    const def = NODE_DEFINITIONS[type];\n    const newId = `node-${Date.now().toString(36)}`;\n    const newNode: WorkflowNode = {\n      id: newId,\n      name: `${def.name} ${activeWorkflow.nodes.length + 1}`,\n      type,\n      position: [240 + (activeWorkflow.nodes.length % 4) * 80, 200 + (activeWorkflow.nodes.length % 3) * 60],\n      parameters: JSON.parse(JSON.stringify(def.defaultParameters)),\n      status: \'idle\',\n    };\n\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: [...prev.nodes, newNode],\n      updatedAt: new Date().toISOString(),\n    }));\n\n    setSelectedNodeId(newId);\n  };\n\n  // Handler: Load Template\n  const handleLoadTemplate = (template: Workflow) => {\n    setActiveWorkflow(JSON.parse(JSON.stringify(template)));\n    setSelectedNodeId(null);\n    setLastExecutionResult(null);\n  };\n\n  // Handler: Run Single Node Step\n  const handleRunSingleNode = async (nodeId: string) => {\n    const node = activeWorkflow.nodes.find(n => n.id === nodeId);\n    if (!node) return;\n\n    // Set running status\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: prev.nodes.map(n => (n.id === nodeId ? { ...n, status: \'running\' } : n)),\n    }));\n\n    // Find incoming data from parent nodes\n    const incomingConns = activeWorkflow.connections.filter(c => c.toNodeId === nodeId);\n    let incomingItems: any[] = [];\n    if (incomingConns.length > 0) {\n      const parentNode = activeWorkflow.nodes.find(n => n.id === incomingConns[0].fromNodeId);\n      if (parentNode?.executionResult?.output) {\n        incomingItems = Array.isArray(parentNode.executionResult.output)\n          ? parentNode.executionResult.output\n          : [parentNode.executionResult.output];\n      }\n    }\n\n    const output = await executeSingleNode(node, incomingItems);\n\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: prev.nodes.map(n =>\n        n.id === nodeId\n          ? {\n              ...n,\n              status: output.error ? \'error\' : \'success\',\n              executionResult: {\n                input: incomingItems,\n                output: output.rawOutput,\n                durationMs: output.durationMs,\n                error: output.error,\n                timestamp: new Date().toISOString(),\n              },\n            }\n          : n\n      ),\n    }));\n  };\n\n  // Handler: Run Entire Workflow\n  const handleExecuteWorkflow = async (customPayload?: any) => {\n    if (isRunning) return;\n    setIsRunning(true);\n    setLastExecutionResult(null);\n\n    // Reset node statuses\n    setActiveWorkflow(prev => ({\n      ...prev,\n      nodes: prev.nodes.map(n => ({ ...n, status: \'idle\' })),\n    }));\n\n    const result = await runWorkflow(\n      activeWorkflow,\n      (nodeId, status, res) => {\n        setActiveWorkflow(prev => ({\n          ...prev,\n          nodes: prev.nodes.map(n =>\n            n.id === nodeId\n              ? {\n                  ...n,\n                  status,\n                  executionResult: res || n.executionResult,\n                }\n              : n\n          ),\n        }));\n      },\n      customPayload\n    );\n\n    setIsRunning(false);\n    setLastExecutionResult({\n      success: result.success,\n      durationMs: result.durationMs,\n    });\n\n    // Add to execution logs\n    const logEntry: ExecutionLogEntry = {\n      id: `exec-${Date.now().toString(36)}`,\n      workflowId: activeWorkflow.id,\n      workflowName: activeWorkflow.name,\n      status: result.success ? \'success\' : \'error\',\n      startedAt: new Date().toISOString(),\n      durationMs: result.durationMs,\n      triggeredBy: customPayload ? \'Webhook Event\' : \'Manual Test\',\n      nodeCount: activeWorkflow.nodes.length,\n      itemCount: 1,\n    };\n    setExecutionLogs(prev => [logEntry, ...prev.slice(0, 19)]);\n  };\n\n  return (\n    <div className=\"flex flex-col h-screen w-screen overflow-hidden bg-slate-950 text-slate-100 font-sans\">\n      {/* Top Bar (Single-line 3-Zone Contract) */}\n      <header className=\"flex items-center justify-between gap-8 px-6 py-3.5 border-b border-slate-800 bg-slate-950/90 backdrop-blur shrink-0 z-30\">\n        {/* Zone 1: Single text element wordmark */}\n        <div className=\"flex items-center gap-2.5 whitespace-nowrap shrink-0\">\n          <div className=\"w-7 h-7 rounded-lg bg-[#ff6d5a] flex items-center justify-center text-white font-bold text-xs tracking-tighter shadow-sm\">\n            n8n\n          </div>\n          <span className=\"text-base font-bold tracking-tight text-white\">\n            Workflow Studio\n          </span>\n        </div>\n\n        {/* Zone 2: Navigation Links */}\n        <nav className=\"hidden md:flex items-center gap-6 text-xs font-medium text-slate-400\">\n          <button\n            onClick={() => setCurrentView(\'install\')}\n            className={`transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 ${\n              currentView === \'install\'\n                ? \'text-[#ff6d5a] font-semibold\'\n                : \'hover:text-white\'\n            }`}\n          >\n            <Terminal className=\"w-3.5 h-3.5\" />\n            <span>Install &amp; Self-Host</span>\n          </button>\n          <button\n            onClick={() => setCurrentView(\'canvas\')}\n            className={`transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 ${\n              currentView === \'canvas\'\n                ? \'text-[#ff6d5a] font-semibold\'\n                : \'hover:text-white\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span>Workflow Editor</span>\n          </button>\n          <button\n            onClick={() => setCurrentView(\'executions\')}\n            className={`transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5 ${\n              currentView === \'executions\'\n                ? \'text-[#ff6d5a] font-semibold\'\n                : \'hover:text-white\'\n            }`}\n          >\n            <History className=\"w-3.5 h-3.5\" />\n            <span>Executions Log</span>\n          </button>\n        </nav>\n\n        {/* Zone 3: Primary Action Button */}\n        <div className=\"flex items-center gap-2.5 shrink-0\">\n          {currentView === \'canvas\' ? (\n            <button\n              onClick={() => handleExecuteWorkflow()}\n              disabled={isRunning}\n              className=\"px-4 py-2 text-xs font-semibold text-white bg-[#ff6d5a] hover:bg-[#ea503c] disabled:opacity-60 rounded-lg shadow-sm transition-all flex items-center gap-1.5 whitespace-nowrap shrink-0\"\n            >\n              {isRunning ? (\n                <>\n                  <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Executing...</span>\n                </>\n              ) : (\n                <>\n                  <Play className=\"w-3.5 h-3.5 fill-current\" />\n                  <span>Test Workflow</span>\n                </>\n              )}\n            </button>\n          ) : (\n            <button\n              onClick={() => setCurrentView(\'canvas\')}\n              className=\"px-4 py-2 text-xs font-semibold text-white bg-[#ff6d5a] hover:bg-[#ea503c] rounded-lg shadow-sm transition-all whitespace-nowrap shrink-0\"\n            >\n              Open Workflow Canvas\n            </button>\n          )}\n        </div>\n      </header>\n\n      {/* Main Viewport */}\n      <main className=\"flex-1 relative overflow-hidden flex flex-col\">\n        {/* VIEW: INSTALL & SELF-HOSTING HUB */}\n        {currentView === \'install\' && (\n          <div className=\"flex-1 overflow-y-auto\">\n            <InstallHub onOpenWorkflow={() => setCurrentView(\'canvas\')} />\n          </div>\n        )}\n\n        {/* VIEW: WORKFLOW CANVAS */}\n        {currentView === \'canvas\' && (\n          <div className=\"flex-1 flex flex-col relative overflow-hidden\">\n            {/* Secondary Canvas Sub-Header */}\n            <div className=\"flex items-center justify-between gap-4 px-6 py-2.5 border-b border-slate-800/80 bg-slate-900/60 backdrop-blur text-xs shrink-0 z-10\">\n              {/* Workflow Name & Templates */}\n              <div className=\"flex items-center gap-3 min-w-0\">\n                <input\n                  type=\"text\"\n                  value={activeWorkflow.name}\n                  onChange={e =>\n                    setActiveWorkflow(prev => ({\n                      ...prev,\n                      name: e.target.value,\n                      updatedAt: new Date().toISOString(),\n                    }))\n                  }\n                  className=\"bg-transparent border border-transparent hover:border-slate-700 focus:border-[#ff6d5a] rounded px-2 py-1 text-white font-semibold text-xs focus:outline-none transition-colors\"\n                />\n\n                <div className=\"hidden sm:flex items-center gap-1.5 text-slate-400\">\n                  <span>\302\267</span>\n                  <select\n                    value={activeWorkflow.id}\n                    onChange={e => {\n                      const tpl = WORKFLOW_TEMPLATES.find(t => t.id === e.target.value);\n                      if (tpl) handleLoadTemplate(tpl);\n                    }}\n                    className=\"bg-slate-950 border border-slate-800 text-slate-300 rounded px-2 py-1 text-xs focus:outline-none focus:border-[#ff6d5a]\"\n                  >\n                    <option disabled value=\"\">\n                      Load Prebuilt Template...\n                    </option>\n                    {WORKFLOW_TEMPLATES.map(tpl => (\n                      <option key={tpl.id} value={tpl.id}>\n                        {tpl.name}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n              </div>\n\n              {/* Action Buttons */}\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => setIsWebhookSandboxOpen(true)}\n                  className=\"px-2.5 py-1.5 bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 rounded-md text-slate-200 hover:text-white transition-colors flex items-center gap-1.5\"\n                  title=\"Simulate incoming webhook trigger\"\n                >\n                  <WebhookIcon className=\"w-3.5 h-3.5 text-[#ff6d5a]\" />\n                  <span className=\"hidden sm:inline\">Webhook Simulator</span>\n                </button>\n\n                <button\n                  onClick={() => setJsonModalMode(\'import\')}\n                  className=\"px-2.5 py-1.5 bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 rounded-md text-slate-200 hover:text-white transition-colors flex items-center gap-1.5\"\n                  title=\"Import n8n JSON\"\n                >\n                  <Upload className=\"w-3.5 h-3.5\" />\n                  <span className=\"hidden sm:inline\">Import</span>\n                </button>\n\n                <button\n                  onClick={() => setJsonModalMode(\'export\')}\n                  className=\"px-2.5 py-1.5 bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 rounded-md text-slate-200 hover:text-white transition-colors flex items-center gap-1.5\"\n                  title=\"Export as official n8n JSON\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span className=\"hidden sm:inline\">Export</span>\n                </button>\n\n                {lastExecutionResult && (\n                  <div\n                    className={`hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-mono ${\n                      lastExecutionResult.success\n                        ? \'bg-emerald-950/60 text-emerald-300 border border-emerald-800/60\'\n                        : \'bg-red-950/60 text-red-300 border border-red-800/60\'\n                    }`}\n                  >\n                    {lastExecutionResult.success ? (\n                      <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    ) : (\n                      <AlertCircle className=\"w-3.5 h-3.5 text-red-400\" />\n                    )}\n                    <span>{lastExecutionResult.durationMs}ms</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Visual Canvas Area */}\n            <div className=\"flex-1 relative\">\n              <WorkflowCanvas\n                nodes={activeWorkflow.nodes}\n                connections={activeWorkflow.connections}\n                selectedNodeId={selectedNodeId}\n                onSelectNode={setSelectedNodeId}\n                onUpdateNodePosition={handleUpdateNodePosition}\n                onAddConnection={handleAddConnection}\n                onDeleteConnection={handleDeleteConnection}\n                onDeleteNode={handleDeleteNode}\n                onOpenLibrary={() => setIsLibraryOpen(true)}\n                isRunning={isRunning}\n              />\n\n              {/* Node Inspector Drawer */}\n              {selectedNode && (\n                <NodeInspector\n                  node={selectedNode}\n                  onClose={() => setSelectedNodeId(null)}\n                  onUpdateParameters={handleUpdateNodeParameters}\n                  onRunSingleNode={handleRunSingleNode}\n                  isRunning={isRunning}\n                />\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* VIEW: EXECUTIONS LOG */}\n        {currentView === \'executions\' && (\n          <div className=\"flex-1 overflow-y-auto p-6 max-w-5xl mx-auto w-full space-y-6\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n              <div>\n                <h3 className=\"text-lg font-bold text-white\">Workflow Execution Logs</h3>\n                <p className=\"text-xs text-slate-400 mt-1\">\n                  History of all automated triggers and manual test runs.\n                </p>\n              </div>\n              <button\n                onClick={() => handleExecuteWorkflow()}\n                className=\"px-3.5 py-2 bg-[#ff6d5a] hover:bg-[#ea503c] text-white text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5\"\n              >\n                <Play className=\"w-3.5 h-3.5 fill-current\" />\n                Trigger Test Run\n              </button>\n            </div>\n\n            {executionLogs.length > 0 ? (\n              <div className=\"border border-slate-800 rounded-xl overflow-hidden bg-slate-900/60\">\n                <table className=\"w-full text-left text-xs font-mono\">\n                  <thead className=\"bg-slate-900 border-b border-slate-800 text-slate-400\">\n                    <tr>\n                      <th className=\"py-3 px-4\">Status</th>\n                      <th className=\"py-3 px-4\">Workflow Name</th>\n                      <th className=\"py-3 px-4\">Trigger</th>\n                      <th className=\"py-3 px-4\">Execution Time</th>\n                      <th className=\"py-3 px-4\">Duration</th>\n                      <th className=\"py-3 px-4\">Nodes</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-800/80 text-slate-300\">\n                    {executionLogs.map(log => (\n                      <tr key={log.id} className=\"hover:bg-slate-800/40 transition-colors\">\n                        <td className=\"py-3 px-4\">\n                          <span\n                            className={`inline-flex items-center gap-1.5 text-xs font-medium ${\n                              log.status === \'success\' ? \'text-emerald-400\' : \'text-red-400\'\n                            }`}\n                          >\n                            {log.status === \'success\' ? (\n                              <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                            ) : (\n                              <AlertCircle className=\"w-3.5 h-3.5\" />\n                            )}\n                            <span className=\"capitalize\">{log.status}</span>\n                          </span>\n                        </td>\n                        <td className=\"py-3 px-4 text-white font-sans font-medium\">\n                          {log.workflowName}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-400\">{log.triggeredBy}</td>\n                        <td className=\"py-3 px-4 text-slate-400\">\n                          {new Date(log.startedAt).toLocaleTimeString()}\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-300 tabular-nums\">\n                          {log.durationMs}ms\n                        </td>\n                        <td className=\"py-3 px-4 text-slate-400 tabular-nums\">\n                          {log.nodeCount} nodes\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            ) : (\n              <div className=\"p-12 text-center border border-dashed border-slate-800 rounded-xl space-y-3\">\n                <FileText className=\"w-8 h-8 text-slate-600 mx-auto\" />\n                <h4 className=\"text-sm font-semibold text-slate-300\">No Executions Recorded Yet</h4>\n                <p className=\"text-xs text-slate-500 max-w-sm mx-auto\">\n                  Switch to the Workflow Editor and click \"Test Workflow\" or dispatch a test webhook to start logging executions.\n                </p>\n                <button\n                  onClick={() => setCurrentView(\'canvas\')}\n                  className=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-medium transition-colors\"\n                >\n                  Go to Workflow Editor\n                </button>\n              </div>\n            )}\n          </div>\n        )}\n      </main>\n\n      {/* Node Catalog Library Modal */}\n      <NodeLibraryModal\n        isOpen={isLibraryOpen}\n        onClose={() => setIsLibraryOpen(false)}\n        onSelectNode={handleAddNodeFromType}\n      />\n\n      {/* Webhook Sandbox Modal */}\n      <WebhookSandbox\n        isOpen={isWebhookSandboxOpen}\n        onClose={() => setIsWebhookSandboxOpen(false)}\n        onTriggerWebhook={payload => handleExecuteWorkflow(payload)}\n        isRunning={isRunning}\n      />\n\n      {/* JSON Import / Export Modal */}\n      {jsonModalMode && (\n        <JsonWorkflowModal\n          isOpen={true}\n          onClose={() => setJsonModalMode(null)}\n          workflow={activeWorkflow}\n          onImportWorkflow={imported => {\n            setActiveWorkflow(imported);\n            setSelectedNodeId(null);\n          }}\n          mode={jsonModalMode}\n        />\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
