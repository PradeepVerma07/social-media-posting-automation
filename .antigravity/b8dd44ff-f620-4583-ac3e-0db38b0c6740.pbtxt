      id: "call_562325"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  CheckSquare,\\n  Clock,\\n  XCircle,\\n  AlertCircle,\\n  CheckCircle2,\\n  Send,\\n  MessageSquare,\\n  Check,\\n  CheckCheck,\\n  Paperclip,\\n  Smile,\\n  Reply,\\n  Shield,\\n  Eye,\\n  Calendar,\\n  Layers,\\n  ChevronRight\\n} from \'lucide-react\';\\nimport { Post, PostComment, ApprovalStatus } from \'../../../server/src/types\';\\n\\ninterface ApprovalQueueProps {\\n  posts: Post[];\\n  commentsMap: Record<number, PostComment[]>;\\n  onApprove: (postId: number) => void;\\n  onReject: (postId: number, reason: string) => void;\\n  onRequestRevision: (postId: number, comments: string) => void;\\n  onAddComment: (postId: number, text: string) => void;\\n  onPublishNow: (postId: number) => void;\\n}\\n\\nexport const ApprovalQueue: React.FC<ApprovalQueueProps> = ({\\n  posts,\\n  commentsMap,\\n  onApprove,\\n  onReject,\\n  onRequestRevision,\\n  onAddComment,\\n  onPublishNow,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'pending\' | \'revision\' | \'approved\' | \'rejected\'>(\'pending\');\\n  const [selectedPostId, setSelectedPostId] = useState<number>(posts[0]?.id || 101);\\n  const [newCommentText, setNewCommentText] = useState(\'\');\\n  const [rejectReasonModalOpen, setRejectReasonModalOpen] = useState(false);\\n  const [revisionModalOpen, setRevisionModalOpen] = useState(false);\\n  const [modalInputText, setModalInputText] = useState(\'\');\\n\\n  const selectedPost = posts.find(p => p.id === selectedPostId) || posts[0];\\n  const postComments = selectedPost ? commentsMap[selectedPost.id] || [] : [];\\n\\n  const filteredPosts = posts.filter(p => {\\n    if (activeTab === \'pending\') return p.approvalStatus === \'in_review\';\\n    if (activeTab === \'revision\') return p.approvalStatus === \'revision_requested\';\\n    if (activeTab === \'approved\') return p.approvalStatus === \'approved\';\\n    if (activeTab === \'rejected\') return p.approvalStatus === \'rejected\';\\n    return true;\\n  });\\n\\n  const handleSendComment = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!newCommentText.trim() || !selectedPost) return;\\n    onAddComment(selectedPost.id, newCommentText.trim());\\n    setNewCommentText(\'\');\\n  };\\n\\n  const handleConfirmReject = () => {\\n    if (!selectedPost || !modalInputText.trim()) return;\\n    onReject(selectedPost.id, modalInputText.trim());\\n    setRejectReasonModalOpen(false);\\n    setModalInputText(\'\');\\n  };\\n\\n  const handleConfirmRevision = () => {\\n    if (!selectedPost || !modalInputText.trim()) return;\\n    onRequestRevision(selectedPost.id, modalInputText.trim());\\n    setRevisionModalOpen(false);\\n    setModalInputText(\'\');\\n  };\\n\\n  return (\\n    <div className=\\\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto\\\">\\n      {/* Header */}\\n      <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h2 className=\\\"text-2xl font-bold tracking-tight text-[#101828]\\\">Approval Queue &amp; Review Chat</h2>\\n          <p className=\\\"text-xs text-[#667085] mt-1\\\">\\n            Collaborative review workspace with WhatsApp/Instagram-style internal discussion.\\n          </p>\\n        </div>\\n      </div>\\n\\n      {/* Tabs */}\\n      <div className=\\\"flex items-center gap-2 border-b border-[#EAECF0] pb-3 overflow-x-auto\\\">\\n        {(\\n          [\\n            { id: \'pending\', label: \'Pending Review\', count: posts.filter(p => p.approvalStatus === \'in_review\').length },\\n            { id: \'revision\', label: \'Revision Requested\', count: posts.filter(p => p.approvalStatus === \'revision_requested\').length },\\n            { id: \'approved\', label: \'Approved & Scheduled\', count: posts.filter(p => p.approvalStatus === \'approved\').length },\\n            { id: \'rejected\', label: \'Rejected\', count: posts.filter(p => p.approvalStatus === \'rejected\').length },\\n          ] as const\\n        ).map(tab => (\\n          <button\\n            key={tab.id}\\n            onClick={() => setActiveTab(tab.id)}\\n            className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors ${\\n              activeTab === tab.id\\n                ? \'bg-[#1336E8] text-white shadow-sm\'\\n                : \'text-[#344054] hover:bg-[#F2F4F7]\'\\n            }`}\\n          >\\n            <span>{tab.label}</span>\\n            <span\\n              className={`px-1.5 py-0.2 rounded-full text-[10px] font-bold ${\\n                activeTab === tab.id ? \'bg-white text-[#1336E8]\' : \'bg-[#F2F4F7] text-[#667085]\'\\n              }`}\\n            >\\n              {tab.count}\\n            </span>\\n          </button>\\n        ))}\\n      </div>\\n\\n      {/* Main Split Grid: Posts List (Left) + Detail & Chat Panel (Right) */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        {/* Left: Queue Items */}\\n        <div className=\\\"lg:col-span-5 space-y-3\\\">\\n          <span className=\\\"text-xs font-semibold text-[#667085] block\\\">\\n            {filteredPosts.length} Items in this queue:\\n          </span>\\n\\n          {filteredPosts.map(post => {\\n            const isSelected = selectedPost?.id === post.id;\\n            return (\\n              <div\\n                key={post.id}\\n                onClick={() => setSelectedPostId(post.id)}\\n                className={`p-4 rounded-2xl border cursor-pointer transition-all ${\\n                  isSelected\\n                    ? \'border-[#1336E8] bg-white shadow-md ring-2 ring-[#1336E8]/10\'\\n                    : \'border-[#EAECF0] bg-white hover:bg-[#F9FAFB] shadow-sm\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between mb-1.5\\\">\\n                  <span className=\\\"px-2 py-0.5 rounded-md bg-[#EFF8FF] text-[#1336E8] text-[10px] font-bold uppercase\\\">\\n                    {post.brandName}\\n                  </span>\\n                  <span className=\\\"text-[10px] font-mono text-[#667085]\\\">\\n                    v{post.versionNumber} \302\267 {new Date(post.createdAt).toLocaleDateString()}\\n                  </span>\\n                </div>\\n                <h4 className=\\\"text-xs font-bold text-[#101828] line-clamp-1\\\">{post.title}</h4>\\n                <p className=\\\"text-[11px] text-[#475467] line-clamp-2 mt-1 leading-relaxed\\\">\\n                  {post.masterCaption}\\n                </p>\\n\\n                <div className=\\\"flex items-center justify-between mt-3 pt-2 border-t border-[#F2F4F7] text-[11px] text-[#667085]\\\">\\n                  <span className=\\\"flex items-center gap-1\\\">\\n                    <MessageSquare className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>{post.commentsCount || 0} notes</span>\\n                  </span>\\n                  <span className=\\\"capitalize font-semibold text-[#101828]\\\">\\n                    {post.approvalStatus.replace(\'_\', \' \')}\\n                  </span>\\n                </div>\\n              </div>\\n            );\\n          })}\\n\\n          {filteredPosts.length === 0 && (\\n            <div className=\\\"p-8 text-center border border-dashed border-[#EAECF0] rounded-2xl text-xs text-[#667085] bg-white\\\">\\n              No items in this queue.\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Right: Detailed Post Preview + WhatsApp-Style Review Discussion */}\\n        {selectedPost ? (\\n          <div className=\\\"lg:col-span-7 space-y-6\\\">\\n            {/* Post Detail Header & Actions */}\\n            <div className=\\\"bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm space-y-4\\\">\\n              <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#EAECF0] pb-4\\\">\\n                <div>\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <span className=\\\"text-xs font-mono font-bold text-[#1336E8] uppercase\\\">\\n                      {selectedPost.brandName}\\n                    </span>\\n                    <span className=\\\"text-xs text-[#98A2B3]\\\">\302\267</span>\\n                    <span className=\\\"text-xs font-mono text-[#667085]\\\">\\n                      Created by {selectedPost.createdByName}\\n                    </span>\\n                  </div>\\n                  <h3 className=\\\"text-base font-bold text-[#101828] mt-1\\\">{selectedPost.title}</h3>\\n                </div>\\n\\n                {/* Primary Approval Actions */}\\n                <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                  {selectedPost.approvalStatus !== \'approved\' && (\\n                    <>\\n                      <button\\n                        onClick={() => {\\n                          setModalInputText(\'\');\\n                          setRevisionModalOpen(true);\\n                        }}\\n                        className=\\\"px-3 py-1.5 bg-[#FEF0C7] hover:bg-[#FEDF89] text-[#B54708] text-xs font-semibold rounded-xl transition-colors\\\"\\n                      >\\n                        Request Revision\\n                      </button>\\n                      <button\\n                        onClick={() => {\\n                          setModalInputText(\'\');\\n                          setRejectReasonModalOpen(true);\\n                        }}\\n                        className=\\\"px-3 py-1.5 bg-[#FEF3F2] hover:bg-[#FECDCA] text-[#B42318] text-xs font-semibold rounded-xl transition-colors\\\"\\n                      >\\n                        Reject\\n                      </button>\\n                      <button\\n                        onClick={() => onApprove(selectedPost.id)}\\n                        className=\\\"px-4 py-1.5 bg-[#12B76A] hover:bg-[#027A48] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\\\"\\n                      >\\n                        <Check className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Approve Content</span>\\n                      </button>\\n                    </>\\n                  )}\\n                  {selectedPost.approvalStatus === \'approved\' && selectedPost.publishingStatus !== \'published\' && (\\n                    <button\\n                      onClick={() => onPublishNow(selectedPost.id)}\\n                      className=\\\"px-4 py-1.5 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl shadow-sm transition-colors flex items-center gap-1.5\\\"\\n                    >\\n                      <Send className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Trigger n8n Publish Now</span>\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\\n\\n              {/* Master Caption & Overrides */}\\n              <div className=\\\"space-y-3 text-xs\\\">\\n                <div>\\n                  <span className=\\\"font-semibold text-[#344054] block mb-1\\\">Master Caption:</span>\\n                  <div className=\\\"p-3.5 rounded-xl bg-[#F6F8FC] border border-[#EAECF0] text-[#101828] leading-relaxed\\\">\\n                    {selectedPost.masterCaption}\\n                  </div>\\n                </div>\\n\\n                {selectedPost.firstComment && (\\n                  <div>\\n                    <span className=\\\"font-semibold text-[#344054] block mb-1\\\">First Comment:</span>\\n                    <div className=\\\"p-2.5 rounded-lg bg-[#F6F8FC] border border-[#EAECF0] text-[#475467] font-mono text-[11px]\\\">\\n                      {selectedPost.firstComment}\\n                    </div>\\n                  </div>\\n                )}\\n\\n                {selectedPost.media?.[0]?.fileUrl && (\\n                  <div>\\n                    <span className=\\\"font-semibold text-[#344054] block mb-1\\\">Attached Media:</span>\\n                    <div className=\\\"rounded-xl overflow-hidden border border-[#EAECF0] max-h-56\\\">\\n                      <img\\n                        src={selectedPost.media[0].fileUrl}\\n                        alt=\\\"\\\"\\n                        className=\\\"w-full h-full object-cover\\\"\\n                      />\\n                    </div>\\n                  </div>\\n                )}\\n              </div>\\n            </div>\\n\\n            {/* WhatsApp/Instagram-style Internal Discussion Chat */}\\n            <div className=\\\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm overflow-hidden flex flex-col h-[480px]\\\">\\n              {/* Chat Header */}\\n              <div className=\\\"p-4 bg-[#F8F9FA] border-b border-[#EAECF0] flex items-center justify-between\\\">\\n                <div className=\\\"flex items-center gap-2.5\\\">\\n                  <div className=\\\"w-8 h-8 rounded-full bg-[#1336E8] text-white flex items-center justify-center font-bold text-xs\\\">\\n                    \360\237\222\254\\n                  </div>\\n                  <div>\\n                    <div className=\\\"text-xs font-bold text-[#101828]\\\">Internal Review Discussion</div>\\n                    <div className=\\\"text-[10px] text-[#667085]\\\">End-to-end encrypted approval log</div>\\n                  </div>\\n                </div>\\n                <span className=\\\"text-[11px] font-mono text-[#12B76A] flex items-center gap-1\\\">\\n                  <span className=\\\"w-2 h-2 rounded-full bg-[#12B76A]\\\"></span>\\n                  <span>Active Channel</span>\\n                </span>\\n              </div>\\n\\n              {/* Chat Messages Body */}\\n              <div className=\\\"flex-1 p-4 overflow-y-auto space-y-3 bg-[#EFEAE2]/30\\\">\\n                {postComments.map(comment => {\\n                  if (comment.isSystemMessage) {\\n                    return (\\n                      <div key={comment.id} className=\\\"flex justify-center my-2\\\">\\n                        <span className=\\\"px-3 py-1 rounded-full bg-[#E4E7EC] text-[#475467] text-[10px] font-semibold text-center\\\">\\n                          \342\232\231\357\270\217 {comment.commentText}\\n                        </span>\\n                      </div>\\n                    );\\n                  }\\n\\n                  const isMe = comment.userId === 1; // David\\n                  return (\\n                    <div\\n                      key={comment.id}\\n                      className={`flex flex-col ${isMe ? \'items-end\' : \'items-start\'}`}\\n                    >\\n                      <div className=\\\"flex items-center gap-1.5 text-[10px] text-[#667085] mb-0.5 px-1\\\">\\n                        <span className=\\\"font-semibold text-[#101828]\\\">{comment.userFullName}</span>\\n                        <span>\302\267</span>\\n                        <span className=\\\"text-[#1336E8]\\\">{comment.userRole}</span>\\n                      </div>\\n\\n                      <div\\n                        className={`max-w-md p-3 rounded-2xl text-xs shadow-sm leading-relaxed ${\\n                          isMe\\n                            ? \'bg-[#1336E8] text-white rounded-tr-none\'\\n                            : \'bg-white text-[#101828] border border-[#EAECF0] rounded-tl-none\'\\n                        }`}\\n                      >\\n                        <p>{comment.commentText}</p>\\n                        <div\\n                          className={`flex items-center justify-end gap-1 mt-1 text-[9px] font-mono ${\\n                            isMe ? \'text-white/80\' : \'text-[#98A2B3]\'\\n                          }`}\\n                        >\\n                          <span>{new Date(comment.createdAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}</span>\\n                          <CheckCheck className=\\\"w-3 h-3\\\" />\\n                        </div>\\n                      </div>\\n                    </div>\\n                  );\\n                })}\\n\\n                {postComments.length === 0 && (\\n                  <div className=\\\"text-center py-12 text-xs text-[#667085]\\\">\\n                    No comments yet. Leave feedback, request revisions, or ask the content lead questions here.\\n                  </div>\\n                )}\\n              </div>\\n\\n              {/* Chat Input Bar */}\\n              <form\\n                onSubmit={handleSendComment}\\n                className=\\\"p-3 bg-white border-t border-[#EAECF0] flex items-center gap-2\\\"\\n              >\\n                <input\\n                  type=\\\"text\\\"\\n                  value={newCommentText}\\n                  onChange={e => setNewCommentText(e.target.value)}\\n                  placeholder=\\\"Type an internal review comment...\\\"\\n                  className=\\\"flex-1 h-10 px-3.5 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#1336E8]\\\"\\n                />\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={!newCommentText.trim()}\\n                  className=\\\"w-10 h-10 rounded-xl bg-[#1336E8] hover:bg-[#0E27B3] disabled:opacity-50 text-white flex items-center justify-center transition-colors shadow-sm\\\"\\n                >\\n                  <Send className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </form>\\n            </div>\\n          </div>\\n        ) : (\\n          <div className=\\\"lg:col-span-7 bg-white p-12 rounded-2xl border border-[#EAECF0] text-center text-xs text-[#667085]\\\">\\n            Select a post from the queue to view details and discussion.\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Reject Reason Modal */}\\n      {rejectReasonModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150\\\">\\n          <div className=\\\"bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4\\\">\\n            <h3 className=\\\"text-base font-bold text-[#101828]\\\">Reject Post</h3>\\n            <p className=\\\"text-xs text-[#667085]\\\">\\n              Please provide an explicit business or compliance reason for rejecting this content. This will be recorded in the audit log.\\n            </p>\\n            <textarea\\n              rows={3}\\n              value={modalInputText}\\n              onChange={e => setModalInputText(e.target.value)}\\n              placeholder=\\\"e.g. Messaging conflicts with updated enterprise PR guidelines...\\\"\\n              className=\\\"w-full p-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#F04438]\\\"\\n              autoFocus\\n            />\\n            <div className=\\\"flex items-center justify-end gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setRejectReasonModalOpen(false)}\\n                className=\\\"px-4 py-2 border border-[#D0D5DD] text-xs font-semibold rounded-xl text-[#344054] hover:bg-[#F2F4F7]\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleConfirmReject}\\n                disabled={!modalInputText.trim()}\\n                className=\\\"px-4 py-2 bg-[#F04438] hover:bg-[#D92D20] disabled:opacity-50 text-white text-xs font-semibold rounded-xl\\\"\\n              >\\n                Confirm Rejection\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Revision Comments Modal */}\\n      {revisionModalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150\\\">\\n          <div className=\\\"bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4\\\">\\n            <h3 className=\\\"text-base font-bold text-[#101828]\\\">Request Revision</h3>\\n            <p className=\\\"text-xs text-[#667085]\\\">\\n              Specify what edits, captions, or asset changes the content creator should apply before resubmitting.\\n            </p>\\n            <textarea\\n              rows={3}\\n              value={modalInputText}\\n              onChange={e => setModalInputText(e.target.value)}\\n              placeholder=\\\"e.g. Please shorten the second sentence and add the link in the first comment...\\\"\\n              className=\\\"w-full p-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs text-[#101828] focus:outline-none focus:border-[#F79009]\\\"\\n              autoFocus\\n            />\\n            <div className=\\\"flex items-center justify-end gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setRevisionModalOpen(false)}\\n                className=\\\"px-4 py-2 border border-[#D0D5DD] text-xs font-semibold rounded-xl text-[#344054] hover:bg-[#F2F4F7]\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleConfirmRevision}\\n                disabled={!modalInputText.trim()}\\n                className=\\\"px-4 py-2 bg-[#F79009] hover:bg-[#DC6803] disabled:opacity-50 text-white text-xs font-semibold rounded-xl\\\"\\n              >\\n                Send Revision Request\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ApprovalQueue with WhatsApp/Instagram-style chat and formal review approval controls\", \"Overwrite\":true, \"TargetFile\":\"/src/features/approvals/ApprovalQueue.tsx\", \"toolAction\":\"Creating ApprovalQueue component\", \"toolSummary\":\"Create src/features/approvals/ApprovalQueue.tsx\"}"
      thinking_signature: "\022\367\t\n\364\t\001i\024}\023N\225kh\250\237\251X\302{\356\271\305\203}{&62\252r8\211\3447\354\264JC\256\302\314\b5\301\377b\002\257\341\354\331\3677\016\322\273\363q|]\000R\215\371\370\201!\301\244\025\001\b\025\031\265v\003\330x\260\203w\345\316gtaVH\230e\037e\207\227c{-eN\023X\215\000\3755\234zDS9\370\003P\241\353\314\215kk\204\326\001I\270\032z\203\241\201\277\243\2013\020\321J\270d\313<\022o\261C\335p\370?\3109\324$)\226D\245a\022\2069\355!\324\353\254\224\325\372\310\024)\002B\266\330\346O\026\222\214\367q\020\372\006\241\242\\k\376\\\205O-\202\037\251\030\030\207\355OQ\351\024\347c\304\236\020M\326\r:\006\214C\366\032b\211\251\374\337\005\037k\305v\346\300\257\v$\354\324\365B\243\263\202#\355\354lD\177\023\001\206\225=\233\315\274>AS\034\210I\250R\177\227\026\017\376\376\304 \363d\213\005l\272;\305m:@\226\f\027\276m\220d\232\213\2313X\217L\023\216\325\264ZZ0n\331\242\231Q\216\304ug\371\366\006%\334\031\025+S\261\231,Q\201\020\252v\225V\026/\205MVAIn=\263\2063\367\331\260d\262+\340T\302-EC<\030\225\325$\035*\276z|c\315\366B\343\271=f\327?\222\237fY\027\340\316]$Y\334\220T\022\325\375m\316\331<\244+\027\005\001\372\344<\331\263k\227qh\201\305\376\244@\320\303\021hu\332\366\202\331\342\373z@^xIw\031\334\255\332\035\315*WTd!\241u\321j\251k\223\345\326\005\226\200\250\2162\251\364\275\223;\230h\275\353\303cB@\344\207\313!z_\205\005\235\302\222\245\003\207]J\331:\245\333\232\233:\242^\016\214l\220\334\f\324\024\211\215Ig\314g\256E\303ukI\230\377A\322tL\361ZLt\336CW\032\v\260~\r\365\374\266\001\226\316:Q\202e\307\274J-\260p\334w\364!c6\214\331}+~*\213\365\212P\035\234Y\363;\006?!\344E\270i\202\256\210\301\023g\3106\373\321\230\364\301\027\027\355VCTM\327\311\275\253\212J\025\276\215\f~\0237i\333\3501V\266\316\244\fi\261\310\002\367\254t\205^\230\004\v*0\213\2213\241~ir\355\320\246\305\320\366\225\202\031\330(X>n\211\215\276\202l\022XuL/i(\366\035JU\352\b\205\217\371(:\351yg\265\000{\325\261\265\037\371\330^\203\266\304\352\260\\\026|\000\236\354\213\350\b\020~e\027\203\026\3116de\311ba\302\202\210\2565\301\226\254\222\316Q(\257\337\337\346\354@\352\376\340\362MJ\202\034\335\300K\343\b\f\365?1\257\204\036\3211y\205\020[r)\256\243P\302\234\017\t/B\367\016\273\202\330+#\222=\314\217A\223x\374\363\350\306\000\226\217\305\240\366*\237\227\177\365\275\273\254~\377\304R.\315b\371ph\323\263v\244w\362D\260\230<\346\227\231\237\212 \233ZV\rh\315\v\222l6\234\030\200\333\224\237\217Ff\377M\345\362\336\"6\032o\016Y\310\2405\274\363e\321\3177\250\357\245\036=V\335xud\221\370:z9\033\275^\0054\022\261\251\037\302\245\347\032\253/5^\262\266\326o\263\005\n\t\216p\000\265\257\341G\037\230\234\026\003\317\367\240\277\224T\276ud\343_\243\177\232\266fG?1D\353\344e\370\364\372Mq\235f\326\234\030\362\304\216#\304\257\367n~\301\224\354\236\356\216\2710e4\b\347\376\257\033^\214\377\201\243# \316[n\244\262\302\241\266d\352b>\221\345\324y]\220@\311\375\225\222%!\235*\371\205\201\226\261\360^\271\226\300\221\242\265\223\371\316\226\254\'\310td\240\3669\253\274\325\023m\205u\355\234\316\017w\030[\367\243\270Q~ U6h5hh=\3559\331\251\2024P\310\b:\r\374\34578cX\263\n\207\240\373\242O\201\2773\004\242\017\002NJz*\254\327\230\327D\250q\005\234\304^\257]\004\355s\360\254\357\255\222\266,\224%\221\005\023\324\350l \266Ho\210fk\330\267\242q\005\233I\205\231\324\322:+\031\330\027\3718\002\311/\355\030G)\223\375\177\241w\242\023\206\355\313\255#\000\203S\351\a~\234\221M-Y\311\016\330\213R}\345\242\375\361H\340\\\201\316\311\374eAAcz\264\3238\243g?I\241T+\346\362t(r\260\250,\346\311e\005\363;\270\256\322\255P\344\257\255\2774\261\t\r\335\355f\332\257\301\016\256\355\343\207u2\366\202NtS\212\356[e\221\334\"4w"
