  view_file {
    absolute_path_uri: "file:///src/features/calendar/ContentCalendar.tsx"
    end_line: 119
    content: "import React, { useState } from \'react\';\nimport {\n  Calendar as CalendarIcon,\n  ChevronLeft,\n  ChevronRight,\n  Clock,\n  Plus,\n  AlertTriangle,\n  Send,\n  Eye,\n  CheckCircle2\n} from \'lucide-react\';\nimport { Post, Brand } from \'../../../server/src/types\';\n\ninterface ContentCalendarProps {\n  posts: Post[];\n  brands: Brand[];\n  onSelectPost: (post: Post) => void;\n  onCreatePost: () => void;\n}\n\nexport const ContentCalendar: React.FC<ContentCalendarProps> = ({\n  posts,\n  brands,\n  onSelectPost,\n  onCreatePost,\n}) => {\n  const [viewMode, setViewMode] = useState<\'month\' | \'week\' | \'agenda\'>(\'month\');\n  const [currentMonth, setCurrentMonth] = useState(\'October 2026\');\n\n  // Days in October 2026: 31 days. Starts on Thursday (day 4).\n  const DAYS_IN_MONTH = 31;\n  const START_DAY_OFFSET = 4; // Thursday\n\n  const calendarDays = Array.from({ length: DAYS_IN_MONTH }, (_, i) => i + 1);\n\n  // Map posts to day numbers\n  const getPostsForDay = (day: number) => {\n    return posts.filter(p => {\n      if (!p.scheduledAt && !p.publishedAt) return false;\n      const date = new Date(p.scheduledAt || p.publishedAt || \'\');\n      return date.getDate() === day && date.getMonth() === 9 && date.getFullYear() === 2026;\n    });\n  };\n\n  return (\n    <div className=\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto\">\n      {/* Calendar Header */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-[#EAECF0] shadow-sm\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#EFF8FF] text-[#1336E8] flex items-center justify-center font-bold\">\n            <CalendarIcon className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-xl font-bold text-[#101828]\">{currentMonth}</h2>\n            <p className=\"text-xs text-[#667085]\">Multi-brand automated publishing schedule (Timezone: America/New_York)</p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {/* View Mode Toggle */}\n          <div className=\"flex items-center p-1 bg-[#F2F4F7] rounded-xl text-xs font-semibold\">\n            <button\n              onClick={() => setViewMode(\'month\')}\n              className={`px-3 py-1.5 rounded-lg transition-colors ${\n                viewMode === \'month\' ? \'bg-white text-[#101828] shadow-sm\' : \'text-[#667085]\'\n              }`}\n            >\n              Month View\n            </button>\n            <button\n              onClick={() => setViewMode(\'week\')}\n              className={`px-3 py-1.5 rounded-lg transition-colors ${\n                viewMode === \'week\' ? \'bg-white text-[#101828] shadow-sm\' : \'text-[#667085]\'\n              }`}\n            >\n              Week View\n            </button>\n            <button\n              onClick={() => setViewMode(\'agenda\')}\n              className={`px-3 py-1.5 rounded-lg transition-colors ${\n                viewMode === \'agenda\' ? \'bg-white text-[#101828] shadow-sm\' : \'text-[#667085]\'\n              }`}\n            >\n              Agenda\n            </button>\n          </div>\n\n          <button\n            onClick={onCreatePost}\n            className=\"px-3.5 py-2 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl flex items-center gap-1.5 shadow-sm\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Schedule Post</span>\n          </button>\n        </div>\n      </div>\n\n      {/* MONTH VIEW */}\n      {viewMode === \'month\' && (\n        <div className=\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm overflow-hidden\">\n          {/* Day of Week Headers */}\n          <div className=\"grid grid-cols-7 border-b border-[#EAECF0] bg-[#F9FAFB] text-center text-xs font-semibold text-[#475467] py-2.5\">\n            <div>Sun</div>\n            <div>Mon</div>\n            <div>Tue</div>\n            <div>Wed</div>\n            <div>Thu</div>\n            <div>Fri</div>\n            <div>Sat</div>\n          </div>\n\n          {/* Calendar Grid */}\n          <div className=\"grid grid-cols-7 auto-rows-[120px] divide-x divide-y divide-[#EAECF0]\">\n            {/* Empty slots before month start */}\n            {Array.from({ length: START_DAY_OFFSET }).map((_, i) => (\n              <div key={`offset-${i}`} className=\"bg-[#F9FAFB]/50 p-2\" />\n            ))}\n\n            {/* Days */}"
    num_lines: 215
    num_bytes: 8711
    line_range_bytes: 4363
  }
}
