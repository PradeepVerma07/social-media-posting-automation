      thinking_signature: "\022\255\030\n\252\030\001i\024}\0230\221\324\354(&\361,\330\301\354hFF9F\203\332\035\374N,\030#\322\035\207\2718\361\232K\305\217X\207\304W\004\222\272=\317|\0238\r\302@\250!\352\016\216\366y`\226\271w:bi\2248\3260\330x}\030\2428xJ\252v\030\331C0\005R\335$\271\315\274\313hb\"\222\303\356\274h\247\226\274X\340\222\242\016r\304\237s\b\030\235\252\210\243\303\033\337+\312\236\266[\307\313\255\255*\343b\330\373\261\356q\343\270(\264\207\315\032\331}\351\256/\a>\207Lz\363\346\022\364\264B\311n\375\201\004P\317\f\325Z\2158\235\270\301Eo\357\247v\227\235Z\356s^\275H\204w\024\363\256T\376\246\374\000a\256\365\257\235\237i\235\227\226\032,\310\017\341\342b*\235V\036\022kh4\341m\222\356rh\003\355l\246_8\216E\352\353_\203\243\277\'\336\225\273\304\367\356\217nApV)`Swr\300@\203\334\021P\237 n\267%\202\301\313\005\b{%&`\334\270NJ\244\327\235\273E\251\224\250*\213\245\202G\237\036!\234k\005\037\001\276\316z\257\371\220t7\362o\355\234\267\021Tal\r\253\200M\3048\324i\351Jr\026\233?0)\022t\244\a|,\020/\345\031\271\347\3448\220wGp\030\315G\272\243O\374q\301\365\364\244~\274\242\221\344#\351\"\177\227-\337\235\'$\277A\377\vT*O;\243\2561\204\322B\207{\352P\352\332\360\261\301\306A\222\206\000\370\004.V!\314\3324\271\313\375\256\211I\311d\260\\\265\3564\234\241\000\256|\262\327\242b\367\tTi\213}\254\006\350#\264\265{e\204\327\344?{;9\203\340\032[\004\307\177`\353gu5\024\274\241\343\261H4\314}!\330\365\336\264\311\313\304\210\247\357\332e\a\271\341\003\363\301\212\345\221\216\220O;\271K\211\037\273\030\307\031\232\177\354\026pd\230m\222\343\021n\005\2045\307?\a\365eZ\320\272\365f+\345\364\265\3271\350b`\003\nJ\212\254\233t \300\206qW\334\251\305\3657\260\032\030\200\247\321\030\201N\367%\341\t-\034\315?\340(\256mY1X\310-\033\3677\035z\t\276\201\364l\256\336\036Y\235\372A\356z\367\200\202>\314\230#\341J\322\234c\336\307\027cm\330\372\346\304\377\334Z\201\201\206N\003\026\332\333\312\177r\341\241\270\375\367\365\a-\037\345\031\265Le`\201\247\254`?L\021`v\202\204