      thinking_signature: "\022\200\025\n\375\024\001i\024}\023P\236o\0350\227V\221\000\351Ci\226\247\311A\352F\\\023\243t\b\321\3431\006.\344\330\253\212\002\002\0347\312\334\035\375\021\343P\202\274\310\306_@\326\324\032\022\227\343\303\021\261\024\'\360\336\a\356\221\375\206HD\a\261\030\362h\200\342@\206\373\213Z\354\332|\336#\245\2653\264\017\351b\242\261M3\373\213\\\352\377>\225\314\315eG\310X:E\221K z\224v\3742\364<\351\032q\341\312\254\253\274TZ_|\016\245?\201X.T\221\300\'k\224\t\240\261\234H\2137\320\27644P\321\204;\3375\a\252\266\274m\326I~\311\304\305\314\206\237\313\tJ\323\235\317\022{\265\335\tp\f\3031-\037\216\241K\031%\217^\301\371\233\003J\321; \214\344\376\250\321v\2576\366\215\265\360\261\257[\3204\3721f\263\327\360-\023\230\274\221p\3037\337\037\217\020*.\\\223)b\231 1\002\270\207\257\'P\206\227\3316ecY\206Z\2424\272\232\332\203B#\330|-\245\241|\332\240\322<)\251\323\177X\314\025\334\327h\314\324W\241\221\215\304\r\212\356hg\315\210wp\236B?w\177\352\'\214\027]m\240\034\360\335g\221\256\2556C\354O6\312f\276\212\020s#\202=\n\022p\340\325b*y\355\212\001\216\255~\231\345\177V\341\366L\304\177\305\203n\"mr\244\223\2246m\206${|\002\016_\r\252\354F\266_(.\344\f\317\247\214\240m\316!vQ\0245\252e\247\361\002\231\351#\274\n\360_g\363\261h+d\331\237\222\331j\257\244S\217\355\220ok\"s\\\344\231-\361\256\341\360%\347,\277g\201\214N&\223\355\017\266y\237Y\333\207\343YI\216\021\303\350\260\\#\333\020vv\027q\225\203\2556\312\243\336Yn\303\374PK\r\034\306\215\321@\317\315y\251\313\352\356\027\374\203\033};\203\276\2705\261\346N\251\363{\364wS\002\362\245\301w\211^\247\027U\362\240i\225jS\003\005\224\336\275Y:\254\337\035\334\035\217\343\001\213\313j\327R\222\274\235\213 \a\351m\264\227\341Gb\373\311\023\t\271\260\230\255\353\346\350\342\310\234\376\223p\251IXy\3263\035\006\027V\v{\253\315\377Y\037V\254\274\342\210]?,\316E\276\210\322\264\262\003\276\264\367~$\257\217\036\027\001\207^\220\v\002\225\372U\370\342\262\205\001x\003\223HG\031WxI\236\303\305\027!\3312\206Y&\017<\372\246\274\227\023\032<\346\202vPC{F\r\251\005\370\362\305\257%\344\036\\\001\376\252y\267m\214\2122`\300\240\217\311Q\272\223\v\027\374\334\316\030\370\210\243\213\257\372F\343\177\262S\232m\371\004O\312\037V\034(\310\272\277\345,\213#\300\247|\363\322\036\361\253\201P\370\371BV\215>8\030\346=H\017\305:\232\233\3470r\343\367\307\2077\004X\255\251\217\004\245\334\331\373\331\342[\026\335\355\003Wg6\026i\352n\353\222\274B/\310\265\332\314\207\273\371\357w\3558\340\240.\254b\240T\212\204t:G\021E\304F\231\360@x\355i\375\272\376\221:\356\355\334n{7\356q#\327\317.\211\3518\242mo\256?\020\030r\223\026r\005ZR\255\353\036U\372kr\202{\367\027\221^\276,\f\375e\253C\351U\242\372\3127\351\265\\\342K|N\306\215\376\364&\206M\025T\271\373\2321\b\327w\234\202\206\352ld~\347\336\324\226\374\327e\017\315$;z\362\261\222$^T+\b\350\016\203\3368\350\271\232^\210\353nAK\204\b\225\276*\026k\215*-\342\261\250\302xc\315/6z\360g \336\357\235!M\260\237sT\036j\232\230\234\210R@C\222>\314\347\270D<\330\201\270D;\355\245\272C\364Q\370<F\311(\244nhk\323\262\306\210\307\f_\246\242\350\345qLW[\231\3072\213\204\\\363Jg\212\217T\337r\312u\021\226l`\346 \025w\210!\231%\230Z\246_\216\001\302\364]\213\270d\240I?\313\233\236\024\266\273\200v\b\020i\2317\000 `4\342\273\317no\366a\255Q\340\001\203\374\227\221I\376\030do`\334Vu\350v\347\244\304\316\277\234nV\204\324\002\362\376i\032\353\226\n\364\025\016\343\203\256l\313\001MaqY\030)\253:m`>\374\354\363GE\333\006\237\320\n\213\241,8\204\365\316\020@b\342\271\227\246n\315\371\277\254\234\243\f3\275\336\207\b?\2545\357\231Mt\305\354\376~\240\027W2\355\366\372\311\272P\352\363>g0c\363\3473\267\224\266*\3718$E\017\232\312\003\027\332\232\371\350U\313\"N\244\r\250\302\177\205?-6\216\017\240\f1C\027\247\v\374 \231\307ud\310GI\325m\300\220/\235i\036\373\216q\223\332O(\255\220h\322\223\221\242\335\335\310C\2563\363xC(\376\243\250[0\016G\001\220\247\376(\376^\241\025@\034\276\206v\024\034\300n^\032{\200\\J\332I\254\324\342w\230\257 \363\264\232\267m`(\245\001B\037\003\233\211\235qi\335\031xl\006\205\254M\261\252\200\272\020\307\366h\300\026\322\365\225\341\301]\315\275c\234\357\006\251\023\354Z)7/\n\024o\333/\215;8\331\215t\n\2247\237\004\264Z\353\325^\034\"\221A9\214pg\r\036\275\306\270\235\000P\312H\3165\332P&Q\336q\245h\'\002\227\253\250S\340\032\266\313Q\005\236\203\317\0034u\215h\r\356*8\260\325lN\323 \374\026\314\330\325\335\376\312A\345\f\357\216\226\342\236\357T@M\310C\261\a\251\322\b\237\263N\356\221\0361\374\vbJ\251\342\017\233\305\213\202Ny\344f~\344\337\'>\\\231\222\304\322Z\261\275M\201,M\270AW\240\326e8\252\270\316.8\361\323\351\273\333o\342\356\227\252\352\253\366\223\036\274\241\316\024\250\241\376\022\215(\035\254c\306\215 \343*\236\230\034\320\271\tc\215\340S\257ic\366a\2207y\316\301\226^(\233\247@\t\2406\355\b2\311c\177\024\266\314U#,\255\246\022#\022\261\017v\305\276@\355\\\335\377?K\2207\327\'$\270\236\t\266\353\v\025\232\347\021\305\330}/\245X=i\206\327\311\366\266\255\031\323\275;\260~\342\350\217\343=\301\357\243\333(\342z>\326\330\272\027&\272\363R\2241)\342?E^k>\275\315N\321\354#\356Z\337}\327\360\310yP\fa\254\'\327,\363\224\377\275\363\305\322\330wJ/\3306\340g\235\247\247p\361\227\351\000\270\271\3622)J\023t_\aQ\237\211\347\207(?\347(\326\265,;i\"\211\261b\350\216\261A\240u\330e\206[\244\205.\336\261\270\366h\006\276W\002\253\374M\024r\300*\b8\253\270\230A\302\343\313\202\321,\213\nB\350\375<\222\360E\242\251+s\312zQ{\b\3636k\371\303\"yk\255I\373\r\306\231\236g\2571\217pT\361\234\305\272\377\205sws\260\203\337\233a\3007\366%(\334v\001)@\302Kl\026Yqd@\001\206\323\264\361>M\250\3225\373\236C\235\n\327\204\226Ik\b(7\305\032\227\372\302Z\002h\254\273\266*\356\375\2405\003.\322\366\244\340\031\3012<\260\225\215\267\373\327\n\315\257\354\005\354\337\351\344\024\377\305\253\037\204\323\244\v\373\242p\362\206\212\242\217\351Y\020\345s>\307k\331D\247\314\276&\305\334/\307\360u\334\204D5\0265\r\v\r\213\317^LmH\327\337\022\b<C\263\264\202|}]\026\032\220:\030\227\374f\315\204%\240L\017\237\325\317\334\352\t\267\245\267bI\371\332Z\354\021\266O\035z\001)\000~B\244\331]\207\245:\352q\276\n\270.\275\274A\220\023\231\r\301\027\266\366c\330\3052$C\350\nm\300m\256\021)\031\357D\247\257\365\\\024\326Gq\303\252\345\314\rD1\272O\353\016\2542\335s\363\017\aq,q\357\345,\341\b\301\024\002\236{:\a&l\370\r\357e\223\326\276>&\257\313V\026\020\02548a \330\267\234L4\335Z\2241\034\374\035\227z\250\fg\346\25117\235\026\212\331\222&]\265UEtHheQ\364\227\266d\333\321\302\201\216\371\374\313\252\327\242Y\223\241\360\017\215 ]\260\001\364zRYE^\311\261\204\332\327\232+\017\244r\326{d\b%J\372\314\203\252\244\353@7\"3+x\264X\272\016 O\200\004#8o\357U\355\023-%\371F\347t\221\253:\332\3575+\336r\305&\362\243\322\207YG5\203\207\003\275P\v\231\374\r\315#\027\317\vGH\331,\207\036\265-L\220;\321\312\347\207^\254\350\236\271\332\227\204\314uq\250\234\215\304\002\367\222Y\376f\254\270!\231\255h\232\000\366YH\212\365l\277\231z\037\207U\226n\342\324\022\t>o\v\332v\336\373\237f\026@\336U=\351\344v\346\217~ u\262T\340L\367\255\315n\322\221J\264d\320$\375\023\034(\302\036R2q\"\356d\374G2]\023zP\002\254\316\342\320\235\227\3770\270CZ\352\001\357\037 \3246\243y\323\316\212\333\222\271\036\235\000&\336o\260\337k*L\004^b\233\301^\031R\350J<C\b0H\215Z\323\245\"T5\023>O\276\372\230\263\214\276\230\034VI\005\360w\255\005\312\236\216m\361\t\254\242\275M\001i\347^\220\261\233\005sJW\203H\352M,f)\226\3058\0000\311\243a\b7\306\353\360\fr\207+\244A\337VSw\006\324\236\350=n\207Q$\256\a\2304(\363\"\367F\354pN\003b7\272\005\263[/:\223A%\352\350d\316\353Jg;\f\by\323\031o\303\254\216\0311\231x+\031\327\233.)\250\302$\353\356\265\033q\246e\253\227T\177,\3113\277V\217\265V\324e\205\361\222K E6\3551U\277e\302>0!\261\264\024,\361"
