  view_file {
    absolute_path_uri: "file:///src/features/calendar/ContentCalendar.tsx"
    start_line: 139
    end_line: 214
    content: "                    </span>\n                    {hasCollision && (\n                      <span className=\"text-[10px] text-[#F79009] flex items-center gap-0.5\" title=\"Multiple posts scheduled close together\">\n                        <AlertTriangle className=\"w-3 h-3\" />\n                      </span>\n                    )}\n                  </div>\n\n                  <div className=\"space-y-1 overflow-y-auto max-h-[85px]\">\n                    {dayPosts.map(p => (\n                      <button\n                        key={p.id}\n                        onClick={() => onSelectPost(p)}\n                        className={`w-full text-left p-1.5 rounded-lg border text-[10px] font-semibold truncate transition-all block ${\n                          p.publishingStatus === \'published\'\n                            ? \'bg-[#ECFDF3] border-[#A6F4C5] text-[#027A48]\'\n                            : p.approvalStatus === \'approved\'\n                            ? \'bg-[#EFF8FF] border-[#B2DDFF] text-[#1336E8]\'\n                            : \'bg-[#F2F4F7] border-[#EAECF0] text-[#475467]\'\n                        }`}\n                      >\n                        <span className=\"font-bold mr-1\">\n                          {p.platforms.map(plat => plat.platform[0].toUpperCase()).join(\'/\')}\n                        </span>\n                        <span>{p.title}</span>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* AGENDA VIEW */}\n      {viewMode === \'agenda\' && (\n        <div className=\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm divide-y divide-[#EAECF0]\">\n          {posts.map(post => (\n            <div key={post.id} className=\"p-4 flex items-center justify-between gap-4 hover:bg-[#F9FAFB] transition-colors\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-12 h-12 rounded-xl bg-[#F2F4F7] border border-[#EAECF0] flex flex-col items-center justify-center font-mono\">\n                  <span className=\"text-[10px] text-[#667085] uppercase\">\n                    {post.scheduledAt ? new Date(post.scheduledAt).toLocaleDateString([], { month: \'short\' }) : \'OCT\'}\n                  </span>\n                  <span className=\"text-sm font-bold text-[#101828]\">\n                    {post.scheduledAt ? new Date(post.scheduledAt).getDate() : \'25\'}\n                  </span>\n                </div>\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded bg-[#EFF8FF] text-[#1336E8] text-[10px] font-bold\">\n                      {post.brandName}\n                    </span>\n                    <span className=\"text-xs font-mono text-[#667085]\">\n                      {post.scheduledAt ? new Date(post.scheduledAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }) : \'14:00 EST\'}\n                    </span>\n                  </div>\n                  <h4 className=\"text-xs font-bold text-[#101828] mt-1\">{post.title}</h4>\n                </div>\n              </div>\n\n              <button\n                onClick={() => onSelectPost(post)}\n                className=\"px-3 py-1.5 bg-white border border-[#D0D5DD] hover:bg-[#F2F4F7] text-xs font-semibold text-[#344054] rounded-xl\"\n              >\n                Inspect\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    num_lines: 215
    num_bytes: 8711
