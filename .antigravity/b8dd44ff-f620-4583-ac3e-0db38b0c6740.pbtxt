      thinking_signature: "\022\244\v\n\241\v\001i\024}\023\304\257j\022v\2137\002\215.6L\324\302;(0\036\277\244\233t\357\273\255\373\250%h\224\335\025\253\301\276S:0\004\242\231\312~\222\327%\203vV\251g\0255\214\237\320\340\345\314\360\327n\372\236|B\351E\177\021\261A\001\327\370\207\252a\236\274\315\037\217\200\002\217@\366\251\323W&\223\005\n\324E\037:e\377V9\335&\232\250\332\343T \211\226\023\307\021\231bqG\313:+\037=\265\001v[F\374\354C\347sJ(\302\216\217\302%\221\306\266x\025u\240\223u+\343\253\322\277\356\246\301\020X\316\"\314\000\311\237~1\3147U}\\\241\026x\243oJ\253g@\232\251\034\366K\263.\255r\020\214\037a\222~\224\253B\265`J-\200\337K\241X\344\324\251(\323\t\232\360\364\346\266\314\331\2623=\226\311\237\000\210\246Q\'\020\372R\214\250\325\316\225\002zc>\267\307\223\245\272\004]]2\332\353\216\204V$u\002\266\345j\'Av\370\317\322\240\003\020Pr\027h\343\204\351\252-\226E:b\226\207\376\245,f\321kQ\241\005\235\025\347\240NW\204\3265L\212)\342\030\346\361\\\253\324Z2\345~\273OVcg\254\217\247wm-\027\370\305$\274\267hd\240\260\231S\036)\265E\346\251\"\363\370\311x\376\231\331\201\\\254y\361\t[\026\301\032r\020\340\204\017>^\243H\335\372\374\320vYf\347\002\376\017\256c\004\244\351\266\f\350\217\341\271F?\237F\333f@\374\027\213\344\210\2674\323\033/\334\207+B\336.Yq\346\350\242\351\231\021\275\335\255\363\316\n/9W\365~\207\205\375\\ej\350\t\303\311\r\243\0277\327D\324\263M\323V\221\214\022Q\221\020\001\020\267\213\334\365e$\324R\314\301\221\341Z\034\373\250\303\326\343\341\222\242\314A\371\006FW5\\z\200V\323r\213Y\277P\020&\236\271Y\233n\205Q\301\224\241\v\353n$\277.\222\342\005\336\034\3653S\234\\\264\311\260Oj\023\361i:\024`\273\2533\303\000\026hR\302xZ\366z\224\316W\a\222\035+#\272k\030vB\317\375\214\'D\017\253v\370\251jiWM4h\3425\264\267z\\C\2305\344;\2560\321\204\"\022\306\246\234OAF\024\373\334\225\004\261b\351 \0262\376\3652\231H:\232\215\243\2135_\031\2161\367\'.^\360\001#`4C5\270\234/\037v\243\3453\314\262\312\256i\245\245k\202\255\3472\262\200\300\344|r\002bsD\277\202\263=\222\334(H1\370\301\355\320\253\211\036\377\277\277\366\224\033L\240\025\370\250\240\262\252Y\346\006\250\024+\002Y\223\263W\334V\355\221\343\370eG\032\340\241q\271)\031A\337\016\205\274s\213\207\337\224\224k\210`$\000m+4\177?\252e\315HG\231\025\336\221\347H\302\325\202Gm.5\035\245\324\312*\312!S.&\367\r\216|\030\216\253*\024\367\367\361\227\374\235\033\263\362\361\024:\325!Ow\303^\250\257\377\254\327\306\254BA\tyb4\027\223\275\353\2107i{\337\b)L`\2337\266\303R\307_\363\323\277M\316\245\356o\362\227\2336\313\346\320c\310\025\372\177\022{\365\267\256\t\b\331\302\3662\360\022K\360\326N\316<\235\037>\264>\002\230fD\201\274\206#\263\367\037\211V\006!\345\201Z6\376\331\177\272\343\331\025\302{\342r]\315\336\233\225\354:\261\326\220\372\342{\341T\365\017\033\300\2465i1\232\225\306\250\223\225\335\374_o<\r\024h\307\271\301\345\244\3424\235\326z \251x\027\225S\177\006K~\264\355M\377\274\353E\022\3778\022\251\277\301~\215\341z\002\376\357\026\333OZ\036Z\a\004\2543LL0\244RGU\203\305\304:\337\n\261\r%\251/\033\351\301\204 #\325\263\261Ez{S\006\033\300\305\201\314\261\025\341%/2]\252\213\377\3419\\=\274\355\365\203\304Z\260\310\256W\240\233\0255>q\347&\341\3149\017\3771\344\235\335\312\304\347\034\375\2078/\246\"\367A\212\226\aT\233Gi!\'q\356!\357q@\377\020\227\a\206k\371\350&\234\344_\363=\241%\032w<\242\303`\364P\021!\311\261M;%\016%\254\f\354\377\030\273\214KG\200\361`+\353\300\231b\b\aD\022\345\375\251\310\255\250k\204\241\\\250u\336P\313\310\306\246\"MA\246g\020,\317\363\234\320\330\"L\030^\256\361(\361\372t\036\301\2739\036\350\200\330\200\245L\021\217\375\346\177\\\002\303\352\254\320%\324T[2\234\\\3606Z\205\375r\221\2633\244\271\243YU\322\025\031\255\262R\373\376j_\263%\370\375\264\312\bQ\260\251\264c\236\205\224\"\237h\262q\3452\231\232Kw\033\211U\352%q\3275\267\004\254\271\343\333H\322\313\177\332n\264!\371\307\302\216\2459\326\253v\360\"\215\244\322\364Gg\235\221\215\357/\315\356onA\207\264\261h\255Y\276F\253\000\270a\aq{R\017)#hn\203\343\n\276\337\003\bR\265\030\236Fs%\314\360S[\bm.\026\326h*\353\000{\310\211\025\037@\324r\"\350\310 \324\213\202M\3569$QgT39\254\370\n\b\330VQM\220\f,\337E\tw@$\313z\247\024\035/\351v\006\216\206("
