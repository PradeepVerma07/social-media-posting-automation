    start_line: 29
    end_line: 139
    content: "import { GoogleSheetsSyncPage } from \'./features/sheets/GoogleSheetsSyncPage\';\nimport { BrandsPage } from \'./features/brands/BrandsPage\';\nimport { SocialAccountsPage } from \'./features/accounts/SocialAccountsPage\';\nimport { AuditLogsPage } from \'./features/audit/AuditLogsPage\';\nimport { SettingsPage } from \'./features/settings/SettingsPage\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<NavigationTab>(\'overview\');\n  const [isSidebarCollapsed, setIsSidebarCollapsed] = useState(false);\n  const [currentRole, setCurrentRole] = useState<RoleName>(\'Super Admin\');\n  const [selectedBrandId, setSelectedBrandId] = useState<number | null>(null);\n\n  // App Data State\n  const [posts, setPosts] = useState<Post[]>([]);\n  const [brands, setBrands] = useState<Brand[]>([]);\n  const [socialAccounts, setSocialAccounts] = useState<SocialAccount[]>([]);\n  const [workflows, setWorkflows] = useState<WorkflowMapping[]>([]);\n  const [executions, setExecutions] = useState<WorkflowExecution[]>([]);\n  const [notifications, setNotifications] = useState<InAppNotification[]>([]);\n  const [auditLogs, setAuditLogs] = useState<AuditLogEntry[]>([]);\n  const [commentsMap, setCommentsMap] = useState<Record<number, PostComment[]>>({});\n  const [analytics, setAnalytics] = useState<AnalyticsOverview>({\n    totalScheduledPosts: 2,\n    totalPublishedPosts: 1,\n    pendingApprovals: 1,\n    rejectedPosts: 0,\n    failedAutomations: 0,\n    activeWorkflows: 4,\n    connectedPlatforms: 4,\n    totalEngagement: 48920,\n    totalImpressions: 482100,\n    totalReach: 324000,\n    engagementRate: 4.8,\n    publishedByPlatform: {\n      linkedin: 24,\n      facebook: 18,\n      instagram: 15,\n      x: 32,\n      youtube: 4,\n    },\n    approvalBreakdown: {\n      draft: 0,\n      in_review: 1,\n      revision_requested: 1,\n      approved: 2,\n      rejected: 0,\n      overdue: 0,\n    },\n  });\n\n  // Load initial data from Express backend\n  const loadInitialData = async () => {\n    try {\n      const [\n        fetchedPosts,\n        fetchedBrands,\n        fetchedAccounts,\n        fetchedWorkflows,\n        fetchedExecutions,\n        fetchedAnalytics,\n        fetchedNotifs,\n        fetchedLogs,\n      ] = await Promise.all([\n        api.getPosts(),\n        api.getBrands(),\n        api.getSocialAccounts(),\n        api.getWorkflows(),\n        api.getExecutions(),\n        api.getAnalyticsOverview(),\n        api.getNotifications(),\n        api.getAuditLogs(),\n      ]);\n\n      setPosts(fetchedPosts);\n      setBrands(fetchedBrands);\n      setSocialAccounts(fetchedAccounts);\n      setWorkflows(fetchedWorkflows);\n      setExecutions(fetchedExecutions);\n      setAnalytics(fetchedAnalytics);\n      setNotifications(fetchedNotifs);\n      setAuditLogs(fetchedLogs);\n\n      // Load comments for the top posts\n      if (fetchedPosts.length > 0) {\n        const topComments = await api.getPostComments(fetchedPosts[0].id);\n        setCommentsMap(prev => ({ ...prev, [fetchedPosts[0].id]: topComments }));\n      }\n    } catch (err) {\n      console.warn(\'Initial backend fetch warning (running with active client cache):\', err);\n    }\n  };\n\n  useEffect(() => {\n    loadInitialData();\n  }, []);\n\n  // Handlers for Post Operations\n  const handleCreatePost = async (postData: any) => {\n    try {\n      const newPost = await api.createPost(postData);\n      setPosts(prev => [newPost, ...prev]);\n      setActiveTab(\'content\');\n    } catch (err) {\n      console.error(\'Failed to create post:\', err);\n    }\n  };\n\n  const handleApprovePost = async (postId: number) => {\n    try {\n      const updated = await api.approvePost(postId);\n      setPosts(prev => prev.map(p => (p.id === postId ? updated : p)));"
    num_lines: 423
