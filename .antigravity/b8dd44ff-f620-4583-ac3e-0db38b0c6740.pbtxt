  view_file {
    absolute_path_uri: "file:///src/features/workflows/AutomationsPage.tsx"
    end_line: 49
    content: "import React, { useState } from \'react\';\nimport {\n  Cpu,\n  Play,\n  Activity,\n  CheckCircle2,\n  AlertCircle,\n  ExternalLink,\n  ShieldCheck,\n  RefreshCw,\n  Clock,\n  Layers,\n  Terminal,\n  LogIn\n} from \'lucide-react\';\nimport { WorkflowMapping } from \'../../../server/src/types\';\n\ninterface AutomationsPageProps {\n  workflows: WorkflowMapping[];\n  onExecuteWorkflow: (workflowId: number) => void;\n  onTestConnection: () => Promise<{ reachable: boolean; latencyMs: number; version?: string }>;\n  onViewExecutions: () => void;\n  onGoToLogin?: () => void;\n}\n\nexport const AutomationsPage: React.FC<AutomationsPageProps> = ({\n  workflows,\n  onExecuteWorkflow,\n  onTestConnection,\n  onViewExecutions,\n  onGoToLogin,\n}) => {\n  const [testingConnection, setTestingConnection] = useState(false);\n  const [connectionResult, setConnectionResult] = useState<{\n    reachable: boolean;\n    latencyMs: number;\n    version?: string;\n  } | null>(null);\n  const [executingId, setExecutingId] = useState<number | null>(null);\n\n  const handleTest = async () => {\n    setTestingConnection(true);\n    try {\n      const res = await onTestConnection();\n      setConnectionResult(res);\n    } finally {\n      setTestingConnection(false);\n    }\n  };\n"
    num_lines: 189
