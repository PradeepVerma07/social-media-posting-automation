      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Building2, Plus, Globe, CheckCircle2, Share2 } from \'lucide-react\';\\nimport { Brand } from \'../../../server/src/types\';\\n\\ninterface BrandsPageProps {\\n  brands: Brand[];\\n  onCreateBrand: (brandData: any) => void;\\n}\\n\\nexport const BrandsPage: React.FC<BrandsPageProps> = ({ brands, onCreateBrand }) => {\\n  const [modalOpen, setModalOpen] = useState(false);\\n  const [name, setName] = useState(\'\');\\n  const [slug, setSlug] = useState(\'\');\\n  const [primaryColor, setPrimaryColor] = useState(\'#1336E8\');\\n  const [timezone, setTimezone] = useState(\'America/New_York\');\\n\\n  const handleCreate = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!name || !slug) return;\\n    onCreateBrand({ name, slug, primaryColor, timezone, country: \'US\' });\\n    setModalOpen(false);\\n    setName(\'\');\\n    setSlug(\'\');\\n  };\\n\\n  return (\\n    <div className=\\\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto\\\">\\n      <div className=\\\"flex items-center justify-between\\\">\\n        <div>\\n          <h2 className=\\\"text-2xl font-bold tracking-tight text-[#101828]\\\">Brands Management</h2>\\n          <p className=\\\"text-xs text-[#667085] mt-1\\\">\\n            Manage brand profiles, visual guidelines, default hashtags, and connected social channels.\\n          </p>\\n        </div>\\n        <button\\n          onClick={() => setModalOpen(true)}\\n          className=\\\"px-4 py-2 bg-[#1336E8] hover:bg-[#0E27B3] text-white text-xs font-semibold rounded-xl flex items-center gap-1.5 shadow-sm\\\"\\n        >\\n          <Plus className=\\\"w-4 h-4\\\" />\\n          <span>Add Brand</span>\\n        </button>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-6\\\">\\n        {brands.map(brand => (\\n          <div\\n            key={brand.id}\\n            className=\\\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm p-6 space-y-4 hover:shadow-md transition-shadow\\\"\\n          >\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div className=\\\"flex items-center gap-3\\\">\\n                <div\\n                  className=\\\"w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-sm\\\"\\n                  style={{ backgroundColor: brand.primaryColor }}\\n                >\\n                  {brand.name.substring(0, 2).toUpperCase()}\\n                </div>\\n                <div>\\n                  <h3 className=\\\"text-sm font-bold text-[#101828]\\\">{brand.name}</h3>\\n                  <span className=\\\"text-[11px] font-mono text-[#667085]\\\">/{brand.slug}</span>\\n                </div>\\n              </div>\\n              <span className=\\\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#ECFDF3] text-[#12B76A]\\\">\\n                ACTIVE\\n              </span>\\n            </div>\\n\\n            <div className=\\\"space-y-1.5 text-xs text-[#475467] pt-2 border-t border-[#EAECF0]\\\">\\n              <div className=\\\"flex justify-between\\\">\\n                <span className=\\\"text-[#667085]\\\">Timezone:</span>\\n                <span className=\\\"font-mono text-[#101828]\\\">{brand.timezone}</span>\\n              </div>\\n              <div className=\\\"flex justify-between\\\">\\n                <span className=\\\"text-[#667085]\\\">Connected Accounts:</span>\\n                <span className=\\\"font-semibold text-[#1336E8]\\\">{brand.connectedAccountsCount || 4} channels</span>\\n              </div>\\n            </div>\\n\\n            {brand.defaultHashtags && (\\n              <div className=\\\"p-2.5 rounded-xl bg-[#F6F8FC] border border-[#EAECF0] text-[11px] text-[#1336E8] font-medium truncate\\\">\\n                {brand.defaultHashtags}\\n              </div>\\n            )}\\n          </div>\\n        ))}\\n      </div>\\n\\n      {modalOpen && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\\\">\\n          <form onSubmit={handleCreate} className=\\\"bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4\\\">\\n            <h3 className=\\\"text-base font-bold text-[#101828]\\\">Create New Brand Profile</h3>\\n            <div className=\\\"space-y-3 text-xs\\\">\\n              <div>\\n                <label className=\\\"font-semibold text-[#344054] block mb-1\\\">Brand Name</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={name}\\n                  onChange={e => setName(e.target.value)}\\n                  placeholder=\\\"e.g. Apex AI Labs\\\"\\n                  className=\\\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs\\\"\\n                  required\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"font-semibold text-[#344054] block mb-1\\\">Slug</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={slug}\\n                  onChange={e => setSlug(e.target.value)}\\n                  placeholder=\\\"e.g. apex-ai\\\"\\n                  className=\\\"w-full h-10 px-3 bg-[#F6F8FC] border border-[#D0D5DD] rounded-xl text-xs\\\"\\n                  required\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"font-semibold text-[#344054] block mb-1\\\">Primary Color</label>\\n                <input\\n                  type=\\\"color\\\"\\n                  value={primaryColor}\\n                  onChange={e => setPrimaryColor(e.target.value)}\\n                  className=\\\"w-full h-10 rounded-xl cursor-pointer\\\"\\n                />\\n              </div>\\n            </div>\\n            <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setModalOpen(false)}\\n                className=\\\"px-4 py-2 border rounded-xl text-xs font-semibold\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                type=\\\"submit\\\"\\n                className=\\\"px-4 py-2 bg-[#1336E8] text-white rounded-xl text-xs font-semibold\\\"\\n              >\\n                Create Brand\\n              </button>\\n            </div>\\n          </form>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create BrandsPage component for managing multi-brand tenant profiles\", \"Overwrite\":true, \"TargetFile\":\"/src/features/brands/BrandsPage.tsx\", \"toolAction\":\"Creating BrandsPage component\", \"toolSummary\":\"Create src/features/brands/BrandsPage.tsx\"}"
