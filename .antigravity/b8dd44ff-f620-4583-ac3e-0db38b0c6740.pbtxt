      thinking_signature: "\022\326\t\n\323\t\001i\024}\023\177\300\031\331\351@\336X\364\350\017]\360\324\212\206~\036@\255z\323T\303\336\2437\300\347\314\236DM\200\346J\260h\341y\030@\230\364\022\203\022\031\004\304\316\277\'\330\244\270\265n/|\370\031\342+\367@>\375\256m\325su\027j\370b_P3\361\366\nU\026\220\2545m\321@#)i\335\375\034iW\361\227\205\351\321\026m\202\257\362\005\367\030p\036\305Ss\352\206\304b\317\325\325\212G\0206\272\217L\272\327u\230\032\266zjM\177\317X$\330BF\366Y6\227\bAQv\333\\\323K\255@P~$\244e\343\034\031-o$\006\3268B\221\370F\252y\035\267:+\322\311\020{\271o\337\032\202\224%r\374\344\270t\206\322\325X\351\220\314\204&uN\275\025\371I|2\021\314\366;\344,\276\243\223X\243\212\032\233\307\320&\233\227\b\224\256\202\030\231\232 nq\004\266n\346\316Ng\370\031@\331\371\261\223\201\261-\316\351\277\001\361\361\300:o\371VT\303\037\026^\254\345?pnw\022\317]\005\262\033\343l\"\016\023\327v\373Q\213\202\345D\245|\3651$\314\305\344\254]b\265(\205\004\214\006\177I\024@t\f\no\255\364\r\336\277\000G\037\267\231\276\350\232\325\r\0378I#drp\177\227\200\317\326\322\021\264\367\202\252\324P\361R\301bYH\357\317\332?\335\301VJ\343\204\224\221\r\314f2\202)\316\247\276*F,\250\324ID\277\362\205[\025L\264B\006\374K-\f\a\200\267\3473\263Y|\265\266\005\2048\345\303\352\267\032\330\t\365Q\377b\340\fV\273\270[\303\351OG\324z4\264:\265\254~\np#\262\254)qc\305K\\\334Gr\331\024\225\306\237]z\3124\2774\f>\270&v\322<\356^\367<#\372e\267\363[\203\336\037\303\313Q\031\226\250\265o\206\342!\325\243d\204\200\351+\351\343\250\306\330\312\301\001\201\271\317|\'T\336\315\335$\021\374|M)l\227\266HA\301!\341\250\316\2002\220?\277U4\b\"\372\326\245\307\333\275\3551H{\206\337.\375\030\264\257\201\f\232\2429>\340\372\2677-&\331\376\315\a2\335\225R&\343}\273+\240\r\376\245\346\243\t5\b\006\307K\305\334\362\3158\374\202\201g\264\320\231\035\256\354v\314e\201\315)\rrFMl\326I\321\346Y\f\247\025\240\024\026\340&J\367\341\221A\232\273\bf\262\330\203P\261V_\233\261\n\324\316tg\270|T\201Y\210\02