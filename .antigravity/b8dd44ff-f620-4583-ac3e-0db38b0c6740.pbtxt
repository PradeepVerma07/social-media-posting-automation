  view_file {
    absolute_path_uri: "file:///src/features/n8n/N8nDirectLoginPage.tsx"
    end_line: 139
    content: "import React, { useState, useEffect } from \'react\';\nimport {\n  LogIn,\n  Server,\n  Key,\n  Shield,\n  ExternalLink,\n  CheckCircle2,\n  AlertCircle,\n  Copy,\n  Check,\n  RefreshCw,\n  Eye,\n  EyeOff,\n  Zap,\n  Terminal,\n  Layers,\n  Globe,\n  Lock,\n  ArrowRight,\n  Database,\n  Cpu,\n  Power,\n  Sparkles,\n  Radio\n} from \'lucide-react\';\nimport { api } from \'../../api/client\';\n\ninterface N8nDirectLoginPageProps {\n  onGoToWorkflows?: () => void;\n  onGoToExecutions?: () => void;\n}\n\ninterface N8nSessionState {\n  connected: boolean;\n  instanceUrl: string;\n  email?: string;\n  version?: string;\n  latencyMs?: number;\n  authType?: string;\n  token?: string;\n  environment?: string;\n  lastConnected?: string;\n}\n\nconst PRESET_INSTANCES = [\n  {\n    id: \'production\',\n    name: \'Production Agency Cluster\',\n    url: \'https://n8n.internal.agency\',\n    desc: \'Self-hosted n8n with Redis queue & high concurrency.\',\n    type: \'self_hosted\',\n    badge: \'Connected / Recommended\',\n    badgeClass: \'bg-[#ECFDF3] text-[#027A48] border-[#A6F4C5]\',\n  },\n  {\n    id: \'cloud\',\n    name: \'n8n Cloud Workspace\',\n    url: \'https://app.n8n.cloud\',\n    desc: \'Official managed cloud instance with zero maintenance.\',\n    type: \'n8n_cloud\',\n    badge: \'Cloud Hosted\',\n    badgeClass: \'bg-[#EFF8FF] text-[#1336E8] border-[#B2DDFF]\',\n  },\n  {\n    id: \'docker\',\n    name: \'Local Docker (:5678)\',\n    url: \'http://localhost:5678\',\n    desc: \'Local container development server for workflow testing.\',\n    type: \'local_docker\',\n    badge: \'Local Port 5678\',\n    badgeClass: \'bg-[#FEF0C7] text-[#B54708] border-[#FEDF89]\',\n  },\n];\n\nexport const N8nDirectLoginPage: React.FC<N8nDirectLoginPageProps> = ({\n  onGoToWorkflows,\n  onGoToExecutions,\n}) => {\n  const [session, setSession] = useState<N8nSessionState>({\n    connected: true,\n    instanceUrl: \'https://n8n.internal.agency\',\n    email: \'admin@ci360.internal\',\n    version: \'1.75.2\',\n    latencyMs: 34,\n    authType: \'credentials\',\n    token: \'ci360_n8n_session_demo_2026\',\n    environment: \'production\',\n    lastConnected: new Date().toISOString(),\n  });\n\n  const [authMethod, setAuthMethod] = useState<\'credentials\' | \'apikey\' | \'sso\'>(\'credentials\');\n  const [instanceUrl, setInstanceUrl] = useState(\'https://n8n.internal.agency\');\n  const [email, setEmail] = useState(\'admin@ci360.internal\');\n  const [password, setPassword] = useState(\'\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\');\n  const [apiKey, setApiKey] = useState(\'n8n_api_key_ci360_live_sec772983\');\n  const [webhookSecret, setWebhookSecret] = useState(\'ci360_webhook_hmac_secret_key_2026\');\n  const [showPassword, setShowPassword] = useState(false);\n  const [rememberMe, setRememberMe] = useState(true);\n\n  const [isLoading, setIsLoading] = useState(false);\n  const [isPinging, setIsPinging] = useState(false);\n  const [feedback, setFeedback] = useState<{ type: \'success\' | \'error\'; message: string } | null>(null);\n  const [copiedKey, setCopiedKey] = useState<string | null>(null);\n\n  // Fetch current session on mount\n  useEffect(() => {\n    api.getN8nSession()\n      .then(data => {\n        setSession(data);\n        if (data.instanceUrl) setInstanceUrl(data.instanceUrl);\n        if (data.email) setEmail(data.email);\n      })\n      .catch(() => {});\n  }, []);\n\n  const copyToClipboard = (text: string, key: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedKey(key);\n    setTimeout(() => setCopiedKey(null), 2000);\n  };\n\n  const handleTestPing = async () => {\n    setIsPinging(true);\n    setFeedback(null);\n    try {\n      const res = await api.testN8nConnection();\n      setSession(prev => ({\n        ...prev,\n        connected: res.reachable,\n        latencyMs: res.latencyMs,\n        version: res.version || prev.version,\n      }));\n      setFeedback({\n        type: \'success\',\n        message: `n8n instance is responsive (${res.latencyMs}ms roundtrip latency). Version: ${res.version || \'1.75.2\'}`,\n      });\n    } catch (err: any) {\n      setFeedback({\n        type: \'error\',"
