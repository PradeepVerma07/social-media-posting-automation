ngCanvasWorkflow ? \'animate-spin\' : \'\'}`} />\n                <span>{isRunningCanvasWorkflow ? \'Executing...\' : \'Run Workflow\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Workflow Execution Success Alert */}\n          {workflowSuccessBanner && (\n            <div className=\"p-3.5 bg-emerald-950/80 border border-emerald-700/80 rounded-xl text-xs text-emerald-200 flex items-center justify-between shadow-lg animate-in fade-in duration-150\">\n              <div className=\"flex items-center gap-2 font-medium\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                <span>{workflowSuccessBanner}</span>\n              </div>\n              <button\n                onClick={() => setWorkflowSuccessBanner(null)}\n                className=\"text-emerald-400 hover:text-white text-xs font-bold\"\n              >\n                Dismiss\n              </button>\n            </div>\n          )}\n\n          {/* Main Visual Canvas Box */}\n          <div className=\"relative rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950 min-h-[580px] lg:min-h-[640px]\">\n            <WorkflowCanvas\n              nodes={currentWorkflow.nodes}\n              connections={currentWorkflow.connections}\n              selectedNodeId={selectedNodeId}\n              onSelectNode={setSelectedNodeId}\n              onUpdateNodePosition={handleUpdateNodePosition}\n              onAddConnection={handleAddConnection}\n              onDeleteConnection={handleDeleteConnection}\n              onDeleteNode={handleDeleteNode}\n              onOpenLibrary={() => setIsLibraryOpen(true)}\n              isRunning={isRunningCanvasWorkflow}\n            />\n\n            {/* Side Node Inspector Panel */}\n            <NodeInspector\n              node={selectedNode}\n              onClose={() => setSelectedNodeId(null)}\n              onUpdateParameters={handleUpdateParameters}\n              onRunSingleNode={handleRunSingleNode}\n              isRunning={isRunningCanvasWorkflow}\n            />\n          </div>"
          replacement_content: "            {/* Action Buttons */}\n            <div className=\"flex flex-wrap items-center gap-2 w-full md:w-auto\">\n              <button\n                onClick={() => {\n                  const xNode = currentWorkflow.nodes.find(n => n.type === \'xNode\');\n                  setSelectedNodeId(xNode ? xNode.id : (currentWorkflow.nodes[0]?.id || null));\n                }}\n                className=\"px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-white rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm cursor-pointer\"\n                title=\"Configure Node X parameters & test step\"\n              >\n                <XIcon className=\"w-3.5 h-3.5\" />\n                <span>Configure Node X</span>\n              </button>\n\n              <button\n                onClick={handleQuickAddXNode}\n                className=\"px-3 py-1.5 bg-black hover:bg-zinc-800 border border-zinc-700 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm cursor-pointer\"\n                title=\"Add official Twitter/X Node to Canvas\"\n              >\n                <XIcon className=\"w-3.5 h-3.5\" />\n                <span>+ Node X</span>\n              </button>\n\n              <button\n                onClick={() => setIsLibraryOpen(true)}\n                className=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-medium transition-colors flex items-center gap-1.5 cursor-pointer\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Add Node</span>\n              </button>\n\n              <button\n                onClick={() => {\n                  setJsonModalMode(\'export\');\n                  setIsJsonModalOpen(true);\n                }}\n                className=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-medium transition-colors flex items-center gap-1.5 cursor-pointer\"\n                title=\"Export or Import official n8n workflow JSON\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span>n8n JSON</span>\n              </button>\n\n              <button\n                onClick={handleRunEntireWorkflow}\n                disabled={isRunningCanvasWorkflow}\n                className=\"px-4 py-1.5 bg-[#ff6d5a] hover:bg-[#ea503c] disabled:opacity-50 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 shadow-md cursor-pointer ml-auto md:ml-0\"\n              >\n                <Play className={`w-3.5 h-3.5 fill-current ${isRunningCanvasWorkflow ? \'animate-spin\' : \'\'}`} />\n                <span>{isRunningCanvasWorkflow ? \'Executing...\' : \'Run Workflow\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Workflow Execution Success Alert */}\n          {workflowSuccessBanner && (\n            <div className=\"p-3.5 bg-emerald-950/80 border border-emerald-700/80 rounded-xl text-xs text-emerald-200 flex items-center justify-between shadow-lg animate-in fade-in duration-150\">\n              <div className=\"flex items-center gap-2 font-medium\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                <span>{workflowSuccessBanner}</span>\n              </div>\n              <button\n                onClick={() => setWorkflowSuccessBanner(null)}\n                className=\"text-emerald-400 hover:text-white text-xs font-bold\"\n              >\n                Dismiss\n              </button>\n            </div>\n          )}\n\n          {/* Main Visual Canvas Box */}\n          <div className=\"relative rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950 h-[640px] w-full\">\n            <WorkflowCanvas\n              nodes={currentWorkflow.nodes}\n              connections={currentWorkflow.connections}\n              selectedNodeId={selectedNodeId}\n              onSelectNode={setSelectedNodeId}\n              onUpdateNodePosition={handleUpdateNodePosition}\n              onAddConnection={handleAddConnection}\n              onDeleteConnection={handleDeleteConnection}\n              onDeleteNode={handleDeleteNode}\n              onOpenLibrary={() => setIsLibraryOpen(true)}\n              isRunning={isRunningCanvasWorkflow}\n            />\n\n            {/* Hint overlay when no node is selected */}\n            {!selectedNode && (\n              <div className=\"absolute top-5 right-5 z-20 hidden md:flex items-center gap-2 px-3 py-1.5 bg-slate-900/90 border border-slate-800 text-slate-300 rounded-lg text-xs backdrop-blur-sm pointer-events-none shadow-lg\">\n                <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>Click any node to inspect &amp; run test step</span>\n              </div>\n            )}\n\n            {/* Side Node Inspector Panel */}\n            <NodeInspector\n              node={selectedNode}\n              onClose={() => setSelectedNodeId(null)}\n              onUpdateParameters={handleUpdateParameters}\n              onRunSingleNode={handleRunSingleNode}\n              isRunning={isRunningCanvasWorkflow}\n            />\n          </div>"
