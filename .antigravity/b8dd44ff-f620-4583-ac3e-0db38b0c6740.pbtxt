      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Share2, CheckCircle2, RotateCw, ExternalLink, ShieldCheck } from \'lucide-react\';\\nimport { SocialAccount } from \'../../../server/src/types\';\\n\\ninterface SocialAccountsPageProps {\\n  accounts: SocialAccount[];\\n}\\n\\nexport const SocialAccountsPage: React.FC<SocialAccountsPageProps> = ({ accounts }) => {\\n  return (\\n    <div className=\\\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto\\\">\\n      <div className=\\\"flex items-center justify-between\\\">\\n        <div>\\n          <h2 className=\\\"text-2xl font-bold tracking-tight text-[#101828]\\\">Connected Social Accounts</h2>\\n          <p className=\\\"text-xs text-[#667085] mt-1\\\">\\n            OAuth channel authentications managed securely via backend credentials and n8n credentials vault.\\n          </p>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n        {accounts.map(acc => (\\n          <div\\n            key={acc.id}\\n            className=\\\"bg-white rounded-2xl border border-[#EAECF0] shadow-sm p-6 space-y-4\\\"\\n          >\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div className=\\\"flex items-center gap-3\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-[#EFF8FF] border border-[#B2DDFF] flex items-center justify-center font-bold text-xs uppercase text-[#1336E8]\\\">\\n                  {acc.platform.substring(0, 2)}\\n                </div>\\n                <div>\\n                  <h3 className=\\\"text-sm font-bold text-[#101828]\\\">{acc.accountName}</h3>\\n                  <span className=\\\"text-[11px] font-mono text-[#667085]\\\">\\n                    {acc.accountHandle || `@${acc.platform}`}\\n                  </span>\\n                </div>\\n              </div>\\n              <span className=\\\"px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-[#ECFDF3] text-[#12B76A]\\\">\\n                {acc.connectionStatus}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"space-y-1.5 text-xs text-[#475467] pt-2 border-t border-[#EAECF0]\\\">\\n              <div className=\\\"flex justify-between\\\">\\n                <span className=\\\"text-[#667085]\\\">OAuth Expiry:</span>\\n                <span className=\\\"font-mono text-[#101828]\\\">\\n                  {acc.tokenExpiresAt ? new Date(acc.tokenExpiresAt).toLocaleDateString() : \'Active\'}\\n                </span>\\n              </div>\\n              <div className=\\\"flex justify-between\\\">\\n                <span className=\\\"text-[#667085]\\\">Last Successful Publication:</span>\\n                <span className=\\\"font-mono text-[#101828]\\\">\\n                  {acc.lastSuccessfulPublishAt ? new Date(acc.lastSuccessfulPublishAt).toLocaleTimeString() : \'Recent\'}\\n                </span>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-between pt-2\\\">\\n              <span className=\\\"text-[11px] text-[#12B76A] flex items-center gap-1 font-medium\\\">\\n                <ShieldCheck className=\\\"w-3.5 h-3.5\\\" /> Token encrypted at rest\\n              </span>\\n              <button className=\\\"px-3 py-1.5 bg-[#F6F8FC] hover:bg-[#F2F4F7] border border-[#D0D5DD] text-xs font-semibold rounded-xl text-[#344054]\\\">\\n                Reconnect Channel\\n              </button>\\n            </div>\\n          </div>\\n        ))}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create SocialAccountsPage component displaying connected platforms with token expiry tracking\", \"Overwrite\":true, \"TargetFile\":\"/src/features/accounts/SocialAccountsPage.tsx\", \"toolAction\":\"Creating SocialAccountsPage component\", \"toolSummary\":\"Create src/features/accounts/SocialAccountsPage.tsx\"}"
