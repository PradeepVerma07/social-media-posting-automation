{
  "name": "Webtrionix \u2014 claim and publish approved deliveries",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "claim-due-deliveries",
      "name": "Claim due deliveries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-APPLICATION-HOST/internal/jobs/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ execution_id: $execution.id, limit: 10 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Webtrionix internal API"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "split",
      "name": "Delivery items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "return ($input.first().json.jobs || []).map(job => ({ json: job }));"
      }
    },
    {
      "id": "publish-claimed-delivery",
      "name": "Publish claimed delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://YOUR-APPLICATION-HOST/internal/jobs/{{ $json.target_id }}/publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ execution_id: $json.execution_id }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Webtrionix internal API"
        }
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Claim due deliveries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim due deliveries": {
      "main": [
        [
          {
            "node": "Delivery items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivery items": {
      "main": [
        [
          {
            "node": "Publish claimed delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {}
}
