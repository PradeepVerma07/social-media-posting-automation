{
  "name": "Webtrionix \u2014 record automation failures",
  "active": false,
  "nodes": [
    {
      "id": "errors",
      "name": "Automatic execution failed",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "record-safe-error-metadata",
      "name": "Record safe error metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-APPLICATION-HOST/internal/automation/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ execution_id: $json.execution.id, workflow_id: $json.workflow.id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Webtrionix internal API"
        }
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Automatic execution failed": {
      "main": [
        [
          {
            "node": "Record safe error metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {}
}
