{
  "name": "WF-01 Scheduler (1-Minute Cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "node-trigger-schedule",
      "name": "Schedule Trigger (Every 1m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.API_URL || 'http://api:4000' }}/api/v1/brands/active-with-sheets",
        "method": "GET",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.POSTPILOT_API_KEY || 'pp_live_secret_n8n_scheduler_api_key_123456' }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true
      },
      "id": "node-fetch-active-brands",
      "name": "Fetch Active Brands & Sheets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-batch-brands",
      "name": "Iterate Brands",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.sheetConfig.scheduleSpreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.sheetConfig.scheduleSheetName || 'Schedule' }}",
          "mode": "name"
        },
        "range": "A2:S",
        "options": {
          "dataMode": "autoMap"
        }
      },
      "id": "node-read-sheet",
      "name": "Read Schedule Sheet (A2:S)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        860,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "postpilot-google-service-account",
          "name": "PostPilot Google Service Account"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Timezone & Due Filter Code Node (Matches @postpilot/shared timezone.js)\nconst { DateTime } = require('luxon');\n\nconst brand = $('Iterate Brands').item.json;\nconst lookbackMinutes = brand.lookbackMinutes || 10;\nconst autoPublishMissed = brand.autoPublishMissed || false;\nconst brandTimezone = brand.defaultTimezone || 'Asia/Kolkata';\n\nconst nowUtc = DateTime.utc();\nconst lookbackBoundary = nowUtc.minus({ minutes: lookbackMinutes });\n\nconst dueRows = [];\n\nfor (let i = 0; i < $input.all().length; i++) {\n  const row = $input.all()[i].json;\n  const rowIndex = i + 2; // Row number in sheet (A2 = row 2)\n\n  // Check status\n  const status = (row.status || '').trim().toLowerCase();\n  if (status !== 'scheduled') {\n    continue;\n  }\n\n  // Date and Time parsing\n  const dateStr = (row.scheduled_date || '').trim();\n  const timeStr = (row.scheduled_time || '').trim();\n  const rowZone = (row.timezone || '').trim() || brandTimezone;\n\n  if (!dateStr || !timeStr) continue;\n\n  try {\n    const isoLocal = `${dateStr}T${timeStr.length === 5 ? timeStr + ':00' : timeStr}`;\n    const dtLocal = DateTime.fromISO(isoLocal, { zone: rowZone });\n    if (!dtLocal.isValid) continue;\n\n    const dtUtc = dtLocal.toUTC();\n\n    // Due check: scheduled_utc <= now_utc AND scheduled_utc >= now_utc - lookback\n    let isDue = dtUtc <= nowUtc && dtUtc >= lookbackBoundary;\n\n    if (!isDue && dtUtc < lookbackBoundary && autoPublishMissed) {\n      isDue = true;\n    }\n\n    if (isDue) {\n      dueRows.push({\n        json: {\n          ...row,\n          brand_id: brand.id,\n          brand_name: brand.name,\n          rowIndex,\n          calculated_scheduled_utc: dtUtc.toISO(),\n          spreadsheetId: brand.sheetConfig.scheduleSpreadsheetId,\n          sheetName: brand.sheetConfig.scheduleSheetName || 'Schedule'\n        }\n      });\n    }\n  } catch (err) {\n    // Skip malformed rows; error handler will flag them\n  }\n}\n\nreturn dueRows;"
      },
      "id": "node-filter-due-posts",
      "name": "Filter Due Posts (Luxon)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-due-count",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      },
      "id": "node-if-due-exists",
      "name": "Has Due Posts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.API_URL || 'http://api:4000' }}/api/v1/publish/enqueue",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"brandId\": \"{{ $json.brand_id }}\",\n  \"rows\": {{ JSON.stringify($input.all().map(i => i.json)) }}\n}",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.POSTPILOT_API_KEY || 'pp_live_secret_n8n_scheduler_api_key_123456' }}"
            }
          ]
        },
        "sendHeaders": true
      },
      "id": "node-enqueue-publish",
      "name": "POST /api/v1/publish/enqueue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        220
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.sheetName }}",
          "mode": "name"
        },
        "range": "=M{{ $json.rowIndex }}",
        "options": {
          "valueInputMode": "RAW"
        },
        "values": [
          [
            "Queued"
          ]
        ]
      },
      "id": "node-update-queued-status",
      "name": "Update Sheet: Status 'Queued'",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1740,
        220
      ],
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "postpilot-google-service-account",
          "name": "PostPilot Google Service Account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (Every 1m)": {
      "main": [
        [
          {
            "node": "Fetch Active Brands & Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Active Brands & Sheets": {
      "main": [
        [
          {
            "node": "Iterate Brands",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iterate Brands": {
      "main": [
        [
          {
            "node": "Read Schedule Sheet (A2:S)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Schedule Sheet (A2:S)": {
      "main": [
        [
          {
            "node": "Filter Due Posts (Luxon)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Due Posts (Luxon)": {
      "main": [
        [
          {
            "node": "Has Due Posts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Due Posts?": {
      "main": [
        [
          {
            "node": "POST /api/v1/publish/enqueue",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "POST /api/v1/publish/enqueue": {
      "main": [
        [
          {
            "node": "Update Sheet: Status 'Queued'",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}